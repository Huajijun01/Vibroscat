#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/volume/epipolar_core.glsl"

layout(local_size_x = 128) in;
// Iris scans these consts after option defines and full preprocessing, so
// the group count follows EPIPOLAR_SLICES branch-wise; the in-shader slice
// guard stays as the edge safety net.
#if EPIPOLAR_SLICES == 256
const ivec3 workGroups = ivec3(2, 1, 1);
#elif EPIPOLAR_SLICES == 512
const ivec3 workGroups = ivec3(4, 1, 1);
#elif EPIPOLAR_SLICES == 1024
const ivec3 workGroups = ivec3(8, 1, 1);
#else
const ivec3 workGroups = ivec3(16, 1, 1);
#endif

#if defined(EPIPOLAR_ACTIVE)
// Full uniform set (compiled even when unused here).
layout(rgba16f) uniform writeonly image2D uimg_epipolar_endpoints;

void main() {
    uint slice = gl_GlobalInvocationID.x;
    if (slice >= uint(SliceCount())) return;
    bool pole_in_screen;
    vec2 pole = LightNDC(pole_in_screen);
    int sector = int(slice) / (SliceCount() / 4);
    // A boundary sector is a valid EXIT edge only when it faces away from
    // the pole (else it is the entry crossing, never addressed by the
    // unwarp).
    bool sector_valid = (sector == 0 && pole.x > -1.0)
                    || (sector == 1 && pole.y > -1.0)
                    || (sector == 2 && pole.x <  1.0)
                    || (sector == 3 && pole.y <  1.0);
    vec4 line = vec4(0.0);
    if (sector_valid) {
        vec2 exit = SliceExit(int(slice));
        vec2 pole_delta = pole - exit;
        float pole_delta_len2 = dot(pole_delta, pole_delta);
        if (pole_in_screen) {
            line = vec4(pole, exit);
        } else if (pole_delta_len2 > 1e-12) {
            vec2 entry = BoundaryHit(exit, pole_delta * inversesqrt(pole_delta_len2));
            line = vec4(entry, exit);
        }
    }
    imageStore(uimg_epipolar_endpoints, ivec2(int(slice), 0), line);
}
#else
void main() {}
#endif
