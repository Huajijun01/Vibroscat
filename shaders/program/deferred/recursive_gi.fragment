/* RENDERTARGETS: 9 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/noise.glsl"
#include "/lib/core/packing.glsl"
#include "/lib/lighting/ambient_light.glsl"

// Clean adaptation of the supplied CC0/MIT ReferenceGI and Sundial-Lite
// visibility-bitmask method. colortex5 is read-only scene radiance from the
// existing pipeline; this pass owns only the current colortex9 output.
const int GI_TRACE_COUNT = 1;
const int GI_STEPS = 16;
const float GI_LENGTH = 514.0;
const float GI_RADIANCE_LIMIT = 64.0;

layout(location = 0) out vec4 out_gi;

float GiArcTan11(vec2 direction) {
    float x = abs(direction.x);
    float u = 2.0 + x * (1.27324 + x * (-0.189431 + (0.08204 - 0.0242564 * x) * x));
    float value = direction.y / u;
    if (direction.x < 0.0) value = (direction.y < 0.0 ? -1.0 : 1.0) - value;
    return value;
}

float GiACosPoly(float x) {
    return 1.5707963267948966 + (-0.20491203466059038 + 0.04832927023878897 * x) * x;
}

float GiACos(float x) {
    x = clamp(x, -1.0, 1.0);
    float u = GiACosPoly(abs(x)) * sqrt(1.0 - abs(x));
    return x < 0.0 ? PI - u : u;
}

vec2 GiComplexMul(vec2 a, vec2 b) {
    return vec2(a.x * b.x - a.y * b.y, a.y * b.x + a.x * b.y);
}

float GiPartialSlice(float x, float sin_view_normal) {
    if (abs(x) >= 1.0 || x == 0.0) return x;
    bool negative = x < 0.0;
    x = abs(x);
    float s = sin_view_normal;
    float o = s - s * s;
    float slope0 = 1.0 / (1.0 + (PI - 1.0) * (s - o * 0.30546));
    float slope1 = 1.0 / (1.0 - (1.0 - exp2(-20.0)) * (s + o * mix(0.5, 0.785, s)));
    float k = mix(0.1, 0.25, s);
    float a = 1.0 - (PI - 2.0) / (PI - 1.0);
    float b = 1.0 / (PI - 1.0);
    float d0 = a - slope0 * b;
    float d1 = 1.0 - slope1;
    float f0 = d0 * (PI * x - (0.5 * PI - GiACos(x)));
    float f1 = d1 * (x - 1.0);
    float kk = k * k;
    float h0 = sqrt(f0 * f0 + kk) - k;
    float h1 = sqrt(f1 * f1 + kk) - k;
    float hh = (h0 * h1) / max(h0 + h1, 1.0e-6);
    float y = x - sqrt(max(hh * (hh + 2.0 * k), 0.0));
    return negative ? -y : y;
}

vec2 GiSampleSliceDirection(vec3 view_space_normal, float random_value) {
    float angle = random_value * TAU;
    vec2 direction = vec2(cos(angle), sin(angle));
    float normal_xy_length = length(view_space_normal.xy);
    if (normal_xy_length > 1.0e-5) {
        vec2 n = view_space_normal.xy / normal_xy_length;
        direction = GiComplexMul(direction, n * vec2(1.0, -1.0));
        float slice_angle = GiPartialSlice(GiArcTan11(direction), normal_xy_length) * PI;
        direction = GiComplexMul(vec2(cos(slice_angle), sin(slice_angle)), n);
    }
    return direction;
}

vec2 GiSliceRelCDF(vec2 x, float angle_normal, float sin_normal) {
    vec2 phi = x * TAU - PI;
    return -cos(angle_normal - phi) - phi * sin_normal;
}

vec4 GiQuaternionToView(vec3 to) {
    vec3 xyz = vec3(to.y, -to.x, 0.0);
    float s = -to.z;
    float inv = inversesqrt(max(s * 0.5 + 0.5, 0.0));
    return vec4(xyz * inv * 0.5, 1.0 / inv);
}

vec3 GiRotateZ0(vec3 value, vec4 q) {
    float k = value.y * q.x - value.x * q.y;
    float g = 2.0 * (value.z * q.w + k);
    vec3 result;
    result.xy = value.xy + q.yx * vec2(g, -g);
    result.z = value.z + 2.0 * (q.w * k - value.z * dot(q.xy, q.xy));
    return result;
}

vec3 GiRotateXY0(vec2 value, vec4 q) {
    float o = q.x * value.y;
    float c = q.y * value.x;
    vec3 basis = vec3(o - c, -o + c, o - c);
    return vec3(value, 0.0) + 2.0 * (basis * q.yxw);
}

uint GiMaskRange(float a, float b) {
    uvec2 horizontal_int = (uvec2(floatBitsToUint(a), floatBitsToUint(b)) >> 17u) & 0x3Fu;
    uint ia = horizontal_int.x;
    uint ib = horizontal_int.y;
    uint left = ia < 32u ? 0xFFFFFFFFu << ia : 0u;
    uint right = ib != 0u ? 0xFFFFFFFFu >> (32u - ib) : 0u;
    return left & right;
}

float GiScreenEdge(vec4 origin, vec4 direction) {
    vec2 t1 = (vec2(1.0) * origin.w - origin.xy) / (direction.xy - vec2(1.0) * direction.w);
    vec2 t2 = (vec2(-1.0) * origin.w - origin.xy) / (direction.xy - vec2(-1.0) * direction.w);
    float edge = far + 32.0;
    if (t1.x > 0.0) edge = min(edge, t1.x);
    if (t1.y > 0.0) edge = min(edge, t1.y);
    if (t2.x > 0.0) edge = min(edge, t2.x);
    if (t2.y > 0.0) edge = min(edge, t2.y);
    return edge;
}

vec3 GiTrace(vec2 uv, vec3 origin_view_position, vec3 origin_normal_view, out float coverage) {
    vec3 view_direction = -normalize(origin_view_position);
    vec4 q_to_view = GiQuaternionToView(view_direction);
    vec4 q_from_view = q_to_view * vec4(vec3(-1.0), 1.0);
    vec3 normal_vvs = GiRotateZ0(origin_normal_view, q_from_view);
    vec2 noise = vec2(
        SampleSTBN(ivec2(gl_FragCoord.xy), frameCounter),
        SampleSTBN(ivec2(gl_FragCoord.xy), frameCounter + 32));
    noise = fract(noise + vec2(0.7548776662, 0.7548776662 * 0.7548776662)
        * float(frameCounter & 63));
    vec2 slice_direction = GiSampleSliceDirection(normal_vvs, noise.x);
    vec3 ray_direction = GiRotateXY0(slice_direction, q_to_view);

    vec3 projection_diag = vec3(gbufferProjection[0].x, gbufferProjection[1].y, gbufferProjection[2].z);
    vec4 origin_proj = vec4(projection_diag * origin_view_position + gbufferProjection[3].xyz, -origin_view_position.z);
#ifdef TAA
    origin_proj.xy += u_taa_offset * origin_proj.w;
#endif
    vec4 projected_direction = vec4(projection_diag * ray_direction, -ray_direction.z);
    projected_direction.xy += gbufferProjection[2].xy * ray_direction.z;
    float trace_length = GiScreenEdge(origin_proj, projected_direction);
    vec2 origin_coord = origin_proj.xy * (0.5 / origin_proj.w) + 0.5;
    vec4 target_proj = origin_proj + projected_direction * trace_length;
    vec2 target_coord = target_proj.xy / target_proj.w * 0.5 + 0.5;
    vec2 sample_range = (target_coord - origin_coord) * u_screen_res;
    float inv_range = inversesqrt(dot(sample_range, sample_range));
    vec2 step_dir = sample_range * inv_range * u_view_pixel_size;
    float step_scale_log = log2(max(1.0 / GI_LENGTH, clamp(inv_range, 0.0, 1.0))) / -float(GI_STEPS);
    float step_scale = exp2(step_scale_log);
    float step_size = exp2(step_scale_log * noise.y);

    vec3 slice_normal = cross(view_direction, ray_direction);
    vec3 projected_normal = origin_normal_view - slice_normal * dot(origin_normal_view, slice_normal);
    float projected_normal_len = length(projected_normal);
    if (projected_normal_len < 1.0e-5) { coverage = 0.0; return vec3(0.0); }
    projected_normal *= inversesqrt(dot(projected_normal, projected_normal));
    vec3 tangent = cross(slice_normal, projected_normal);
    float cos_normal = dot(projected_normal, view_direction);
    float angle_normal = (dot(view_direction, tangent) < 0.0 ? -1.0 : 1.0) * GiACos(cos_normal);
    float sin_normal = sin(angle_normal);
    float denom = cos_normal + angle_normal * sin_normal;
    float w0 = clamp((sin_normal / denom) * (PI * 0.25) + 0.5, 0.0, 1.0);
    float t1 = 0.25 / denom;
    float t01 = (3.0 * cos_normal + (4.0 * angle_normal + PI) * sin_normal) * t1;
    float remap_mul = 32.0 / (1.0 - w0);
    float remap_add = -w0 * remap_mul + 64.0;
    remap_add += remap_mul * t01;
    remap_mul *= t1;

    uint occupied = 0u;
    vec3 gi = vec3(0.0);
    float hit_coverage = 0.0;
    int hit_count = 0;
    for (int i = 0; i < GI_STEPS; ++i) {
        vec2 sample_uv = origin_coord + step_dir * step_size;
        step_size *= step_scale;
        if (any(lessThan(sample_uv, vec2(0.0))) || any(greaterThanEqual(sample_uv, vec2(1.0)))) break;
        ivec2 sample_tx = ivec2(sample_uv * u_screen_res);
        float sample_depth = texelFetch(depthtex0, sample_tx, 0).r;
        if (sample_depth >= 1.0) continue;
        vec3 sample_view = vec3(sample_uv * 2.0 - 1.0, 1.0);
#ifdef TAA
        sample_view.xy -= u_taa_offset;
#endif
        sample_view.xy = vec2(gbufferProjectionInverse[0].x, gbufferProjectionInverse[1].y)
            * sample_view.xy + gbufferProjectionInverse[3].xy;
        sample_view.z = gbufferProjectionInverse[3].z;
        sample_view /= gbufferProjectionInverse[2].w * (sample_depth * 2.0 - 1.0)
            + gbufferProjectionInverse[3].w;
        vec4 sample_geometry = texelFetch(colortex4, sample_tx, 0);
        vec3 sample_normal_view = DecodeOctahedralNormal(sample_geometry.xy);
        vec3 delta_front = sample_view - origin_view_position;
        // Sundial's non-hand geometry thickness term: clamp the projected
        // footprint before taking the reciprocal square root so distant
        // surfaces retain the intended 0.1 m angular interval.
        vec3 delta_back = delta_front + sample_view
            * inversesqrt(clamp(dot(sample_view, sample_view) * 0.25, 0.0, 1.0))
            * 0.1;
        float front_cos = dot(delta_front, view_direction) * inversesqrt(max(dot(delta_front, delta_front), 1.0e-6));
        float back_cos = dot(delta_back, view_direction) * inversesqrt(max(dot(delta_back, delta_back), 1.0e-6));
        vec2 horizontal = vec2(GiACos(front_cos), GiACos(back_cos));
        vec2 horizontal01 = clamp((horizontal + angle_normal) / PI + 0.5, 0.0, 1.0);
        horizontal01 = GiSliceRelCDF(horizontal01, angle_normal, sin_normal);
        horizontal01 = horizontal01 * remap_mul + remap_add;
        uint sample_mask = GiMaskRange(horizontal01.x, horizontal01.y);
        uint visible = sample_mask & (~occupied);
        if (visible != 0u) {
            float visible_weight = float(bitCount(visible)) * (1.0 / 32.0);
            // The visibility mask estimates a normalized cosine-weighted
            // hemisphere average (E / PI). Store irradiance so deferred4
            // consumes it with the same unit as AmbientLight().
            gi += texelFetch(colortex5, sample_tx, 0).rgb * visible_weight * PI;
            hit_coverage += visible_weight;
            hit_count++;
        }
        occupied |= sample_mask;
        if (occupied == 0xFFFFFFFFu) break;
    }
    coverage = clamp(hit_coverage / float(GI_TRACE_COUNT), 0.0, 1.0);
    return gi / float(GI_TRACE_COUNT);
}

void main() {
    ivec2 tx = ivec2(gl_FragCoord.xy);
    vec2 uv = (vec2(tx) + 0.5) * u_view_pixel_size;
    float depth = texelFetch(depthtex0, tx, 0).r;
    if (depth >= 1.0) { out_gi = vec4(0.0); return; }
    vec4 geometry_data = texelFetch(colortex4, tx, 0);
    vec3 normal_view = DecodeOctahedralNormal(geometry_data.xy);
    vec3 view_position = SceneToViewSpace(DepthToWorldPos(uv, depth));
    vec3 gi;
    float coverage;
    gi = GiTrace(uv, view_position + normal_view * 0.003, normal_view, coverage);
    vec3 fallback_normal = normalize(mat3(gbufferModelViewInverse) * normal_view);
    vec3 fallback = AmbientLight(fallback_normal, vec3(1.0), geometry_data.w);
    float miss_fraction = 1.0 - coverage;
    gi += fallback * miss_fraction;
    gi = clamp(gi, vec3(0.0), vec3(GI_RADIANCE_LIMIT));
    out_gi = vec4(gi, coverage);
}
