#include "/lib/contract/settings.glsl"
#include "/lib/color/spaces.glsl"
#include "/lib/post/bloom.glsl"

// Match taa's output routing: colortex0 holds the blur/velocity result only
// with motion blur or a debug view; otherwise the color is only in colortex5.
#if defined(MOTION_BLUR) || TAA_DEBUG > 0
layout(r11f_g11f_b10f) uniform restrict readonly image2D colorimg0;
#define SCENE_HDR_IMAGE colorimg0
#else
layout(r11f_g11f_b10f) uniform restrict readonly image2D colorimg5;
#define SCENE_HDR_IMAGE colorimg5
#endif

// 8x8 workgroups: the 17x17 vec4 tile (4.6 KB) lets more blocks fit per SM
// than a 33x33 tile would, and the full-resolution source reads stay
// cache-coherent; 16x16 workgroups measured ~6-8 us slower per dispatch.
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f) uniform restrict writeonly image2D colorimg12;

shared vec4 tile[17][17];

void main() {
#ifndef BLOOM
    // The pass runs whenever AE or BLOOM needs it; the letter entries share
    // one enable condition, so this kernel must not touch colortex12 when
    // only AE is on. The body is compiled out, not skipped after a return,
    // because barrier() may not follow a return statement.
    return;
#else
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 full_size = imageSize(SCENE_HDR_IMAGE);
    ivec2 dst_size = GetBloomMipSize(full_size, 1);
    bool valid = all(lessThan(gid, dst_size));

    ivec2 group_base = ivec2(gl_WorkGroupID.xy) * ivec2(8, 8);
    ivec2 input_base = group_base * 2 - 1;

    for (uint i = gl_LocalInvocationIndex; i < 289u; i += 64u) {
        uint ty = i / 17u;
        uint tx = i % 17u;
        ivec2 coord = clamp(input_base + ivec2(tx, ty), ivec2(0), full_size - 1);
        tile[ty][tx] = imageLoad(SCENE_HDR_IMAGE, coord);
    }

    barrier();

    ivec2 tile_center = ivec2(gl_LocalInvocationID.xy) * 2 + 1;

    // Separable 3x3 tent (1/4, 1/2, 1/4) on the 2x2 block centre.
    vec4 s_center = tile[tile_center.y + 0][tile_center.x + 0];
    vec4 s_left   = tile[tile_center.y + 0][tile_center.x - 1];
    vec4 s_right  = tile[tile_center.y + 0][tile_center.x + 1];
    vec4 s_up     = tile[tile_center.y - 1][tile_center.x + 0];
    vec4 s_down   = tile[tile_center.y + 1][tile_center.x + 0];
    vec4 s_tl     = tile[tile_center.y - 1][tile_center.x - 1];
    vec4 s_tr     = tile[tile_center.y - 1][tile_center.x + 1];
    vec4 s_bl     = tile[tile_center.y + 1][tile_center.x - 1];
    vec4 s_br     = tile[tile_center.y + 1][tile_center.x + 1];

    vec4 result = vec4(0.0);
    float total_weight = 0.0;
    float tap_weight;

    // The tap weight folds into the luminance weight so each tap costs one
    // scalar divide and one vector multiply.
    tap_weight = 0.25 / (1.0 + Luminance(s_center.rgb));
    result += s_center * tap_weight;
    total_weight += tap_weight;

    tap_weight = 0.125 / (1.0 + Luminance(s_left.rgb));
    result += s_left * tap_weight;
    total_weight += tap_weight;

    tap_weight = 0.125 / (1.0 + Luminance(s_right.rgb));
    result += s_right * tap_weight;
    total_weight += tap_weight;

    tap_weight = 0.125 / (1.0 + Luminance(s_up.rgb));
    result += s_up * tap_weight;
    total_weight += tap_weight;

    tap_weight = 0.125 / (1.0 + Luminance(s_down.rgb));
    result += s_down * tap_weight;
    total_weight += tap_weight;

    tap_weight = 0.0625 / (1.0 + Luminance(s_tl.rgb));
    result += s_tl * tap_weight;
    total_weight += tap_weight;

    tap_weight = 0.0625 / (1.0 + Luminance(s_tr.rgb));
    result += s_tr * tap_weight;
    total_weight += tap_weight;

    tap_weight = 0.0625 / (1.0 + Luminance(s_bl.rgb));
    result += s_bl * tap_weight;
    total_weight += tap_weight;

    tap_weight = 0.0625 / (1.0 + Luminance(s_br.rgb));
    result += s_br * tap_weight;
    total_weight += tap_weight;

    result /= max(total_weight, 1e-6);

    if (valid) imageStore(colorimg12, gid, result);
#endif
}
