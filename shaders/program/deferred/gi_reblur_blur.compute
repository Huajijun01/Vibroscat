#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/lighting/gi_reblur_spatial.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
#ifdef GI_REBLUR_ACTIVE
const vec2 workGroupsRender = vec2(1.0, 1.0);
layout(rgba16f) uniform writeonly image2D uimg_gi_reblur_b;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, imageSize(uimg_gi_reblur_b)))) return;
    imageStore(uimg_gi_reblur_b, texel, FilterGIReblur(texel, usam_gi_reblur_a, false));
}
#else
const ivec3 workGroups = ivec3(1, 1, 1);
void main() {}
#endif
