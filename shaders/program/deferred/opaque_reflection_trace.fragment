/* RENDERTARGETS: 3,11 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/packing.glsl"
#include "/lib/raytrace/opaque_reflection.glsl"

layout(location = 0) out vec3 out_reflection_radiance;
layout(location = 1) out vec2 out_reflection_metadata;

void main() {
    out_reflection_radiance = vec3(0.0);
    out_reflection_metadata = vec2(0.0);

    ivec2 tx = ivec2(gl_FragCoord.xy);
    float depth = texelFetch(depthtex0, tx, 0).r;
    if (depth >= 1.0) return;

    vec4 packed_surface = texelFetch(colortex2, tx, 0);
    vec2 nx_ao = Unpack2x8(packed_surface.r);
    vec2 ny_nz = Unpack2x8(packed_surface.g);
    vec2 rough_selector = Unpack2x8(packed_surface.b);
    vec3 normal = normalize(vec3(
        nx_ao.x * 2.0 - 1.0,
        ny_nz.x * 2.0 - 1.0,
        ny_nz.y * 2.0 - 1.0));

    vec2 uv = (vec2(tx) + 0.5) * u_view_pixel_size;
#ifdef TAA
    vec3 world_pos = DepthToWorldPos(uv - u_taa_offset * 0.5, depth);
#else
    vec3 world_pos = DepthToWorldPos(uv, depth);
#endif
    vec3 V = normalize(EyePositionSceneSpace() - world_pos);
    if (dot(normal, V) <= 1e-5) return;

    vec3 H;
    vec3 reflection_direction = OpaqueReflectionDirection(
        normal, V, rough_selector.x, tx, H);

    vec3 view_pos = SceneToViewSpace(world_pos);
    vec3 view_direction = normalize(
        mat3(gbufferModelView) * reflection_direction);
    vec3 trace_origin = view_pos + view_direction * 0.05;
    float trace_jitter = OpaqueSSRRandom2(tx).y;
    SSRHit shared_hit = TraceScreenSpaceReflection(
        trace_origin, view_direction, trace_jitter,
        OPAQUE_SSR_MAX_DISTANCE, OPAQUE_SSR_STEPS, false);
    if (!shared_hit.valid || shared_hit.sky) return;

    float confidence;
    float selected_mip;
    vec3 history = SampleOpaqueHistory(
        shared_hit, rough_selector.x,
        -view_pos.z, confidence, selected_mip);
#if OPAQUE_SSR_DEBUG == 4
    float max_mip = float(max(textureQueryLevels(colortex5) - 1, 1));
    out_reflection_radiance = vec3(selected_mip / max_mip) * confidence;
#else
    out_reflection_radiance = history;
#endif
    out_reflection_metadata = vec2(shared_hit.path_length, confidence);
}
