#ifndef BLOOM_SRC_MIP
#define BLOOM_SRC_MIP 2
#endif
#ifndef BLOOM_DST_MIP
#define BLOOM_DST_MIP 1
#endif

#include "/lib/contract/uniforms.glsl"
#include "/lib/post/bloom.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f) uniform image2D colorimg12;

void main() {
    ivec2 full_size = imageSize(colorimg12);
    ivec2 dst_origin = GetBloomMipOrigin(full_size, BLOOM_DST_MIP);
    ivec2 dst_size = GetBloomMipSize(full_size, BLOOM_DST_MIP);
    ivec2 dst_coord = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(dst_coord, dst_size))) return;
    vec3 result = SampleBloomTent(colortex12, GetBloomMipOrigin(full_size, BLOOM_SRC_MIP),
                                 GetBloomMipSize(full_size, BLOOM_SRC_MIP), dst_coord, 1.0 / vec2(full_size));
    ivec2 destination = dst_origin + dst_coord;
    imageStore(colorimg12, destination, vec4(imageLoad(colorimg12, destination).rgb + result, 0.0));
}
