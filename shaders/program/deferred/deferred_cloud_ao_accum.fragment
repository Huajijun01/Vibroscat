// Writes one merged colortex8 history frame.
// Sky: RG scattering weights, B transmittance, A distance (km). Geometry:
// R EncodeAOHistory(AO), G age, B EncodeSquaredDepth, A NaN = "not cloud".

/* RENDERTARGETS: 8 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/render_scale.glsl"
#include "/lib/atmosphere/atmosphere_geometry.glsl"
#include "/lib/cloud/checkerboard.glsl"
#include "/lib/cloud/geometry.glsl"
#include "/lib/cloud/signal.glsl"
#include "/lib/cloud/temporal.glsl"
#include "/lib/lighting/ao_history.glsl"
#include "/lib/lighting/ao_reconstruction.glsl"
#include "/lib/raytrace/ssr_depth.glsl"

layout(location = 0) out vec4 out_history;

#ifdef VOLUMETRIC_CLOUDS
layout(r8) uniform image2D uimg_clouds_age;
#endif

void main() {
#if defined(TAAU_ACTIVE)
    if (OutsideSceneRender(gl_FragCoord.xy)) discard;
#endif
    ivec2 tx = ivec2(gl_FragCoord.xy);
    vec2 uv = (vec2(tx) + 0.5) * u_render_pixel_size;
    float scene_depth = texelFetch(depthtex0, tx, 0).r;

    if (scene_depth >= 1.0) {
#ifdef VOLUMETRIC_CLOUDS
        vec3 view_dir = normalize(mat3(gbufferModelViewInverse)
            * NDCToView(vec3(uv * 2.0 - 1.0, 1.0)));
        vec3 camera_atmosphere_pos = AtmosphereCameraPosition();
        float cloud_entry;
        float cloud_exit;
        bool cloud_visible = CloudShellInterval(camera_atmosphere_pos, view_dir, cloud_entry, cloud_exit);
        if (cloud_visible
                && length(camera_atmosphere_pos) < ATM_PLANET_R + CLOUD_BASE_ALTITUDE) {
            // entry > 0: the ray rises into the layer rather than skimming beneath it.
            cloud_visible = cloud_entry > 0.0;
        }
        if (cloud_visible) {
            int pixel_age = int(imageLoad(uimg_clouds_age, tx).r * 255.0 + 0.5);
            int new_age = 1;
#if CLOUD_RECONSTRUCTION_MODE == 1 && CLOUD_TEMPORAL_UPSCALING > 1
            float shell_distance = (view_dir.y < 0.0 && cloud_entry > 0.0) ? cloud_entry : cloud_exit;
            ivec2 phase_offset = CloudCheckerboardOffset();
            ivec2 cell = tx / CLOUD_TEMPORAL_UPSCALING;
            bool has_fresh = all(equal(tx - cell * CLOUD_TEMPORAL_UPSCALING, phase_offset));
            vec4 raw_sample = texelFetch(colortex12, cell, 0);
            has_fresh = has_fresh && raw_sample.a > 0.0;
            CloudFrame current_frame = DecodeCloudFrame(raw_sample);
            bool current_ready = has_fresh;
            CloudFrame accumulated = current_frame;
            bool history_accepted = false;
            if (frameCounter > 0) {
                vec4 held_value = texelFetch(colortex8, tx, 0);
                CloudFrame held = DecodeCloudFrame(held_value);
                float anchor_distance;
                if (!has_fresh && !CloudHistoryInvalid(held)) {
                    anchor_distance = held.distance_km;
                } else {
                    if (!current_ready) {
                        current_frame = CloudCheckerboardCurrent(tx, phase_offset, shell_distance);
                        current_ready = true;
                    }
                    anchor_distance = current_frame.distance_km;
                }
                vec2 previous_uv;
                if (CloudProjectToPrevious(view_dir, anchor_distance, previous_uv)) {
                    CloudFrame history = CloudCheckerboardHistory(previous_uv);
                    if (!CloudHistoryInvalid(history)) {
                        // History age keeps counting across camera motion; reprojection handles rotation.
                        if (has_fresh) {
                            accumulated = CloudCheckerboardAccumulate(current_frame, history, pixel_age);
                        } else {
                            // Non-fresh texels keep history: sparse checkerboard neighbors lose retained detail.
                            accumulated = history;
                        }
                        history_accepted = true;
                        new_age = min(pixel_age + 1, max(CLOUD_HISTORY_FRAMES, CLOUD_CHECKERBOARD_AREA + 1));
                    }
                }
            }
            if (!history_accepted) {
                if (!current_ready) {
                    current_frame = CloudCheckerboardCurrent(tx, phase_offset, shell_distance);
                }
                accumulated = current_frame;
            }
#else
            CloudFrame current_frame = CloudSampleCurrentBilinear(tx);
            CloudFrame accumulated = current_frame;
            if (!CloudHistoryInvalid(current_frame) && frameCounter > 0) {
                vec2 previous_uv;
                if (!CloudProjectToPrevious(view_dir, current_frame.distance_km, previous_uv
                )) {
                    accumulated = current_frame;
                } else {
                    CloudFrame reprojected_history = CloudHistorySample(previous_uv);
                    if (CloudHistoryInvalid(reprojected_history)) {
                        accumulated = current_frame;
                    } else {
                        accumulated = CloudAccumulate(current_frame, reprojected_history, pixel_age);
                        new_age = min(pixel_age + 1, CLOUD_HISTORY_FRAMES);
                    }
                }
            }
#endif
            imageStore(uimg_clouds_age, tx, vec4(float(new_age) * (1.0 / 255.0), 0.0, 0.0, 0.0));
            out_history = EncodeCloudFrame(accumulated);
        } else {
            // Miss: invalid marker + age reset, so entering rays reseed immediately.
            imageStore(uimg_clouds_age, tx, vec4(0.0, 0.0, 0.0, 0.0));
            out_history = vec4(0.0, 0.0, 1.0, HISTORY_NO_CLOUD_DATA);
        }
#else
        out_history = vec4(0.0, 0.0, 1.0, HISTORY_NO_CLOUD_DATA);
#endif
        return;
    }

#if defined(GTAO)
    vec2 geo_normal_oct = texelFetch(colortex4, tx, 0).xy;
    // Half-res AO input was accumulated by the preceding compute; this is the full-res upfilter.
    vec2 resolved_ao = ReconstructAO(tx, scene_depth, geo_normal_oct);
    out_history = vec4(EncodeAOHistory(resolved_ao.x), resolved_ao.y,
        EncodeSquaredDepth(scene_depth), HISTORY_NO_CLOUD_DATA);
#if defined(VOLUMETRIC_CLOUDS) && CLOUD_RECONSTRUCTION_MODE == 1 && CLOUD_TEMPORAL_UPSCALING > 1
    imageStore(uimg_clouds_age, tx, vec4(0.0));
#endif
#else
#ifdef VOLUMETRIC_CLOUDS
    out_history = vec4(0.0, 0.0, 1.0, HISTORY_NO_CLOUD_DATA);
    imageStore(uimg_clouds_age, tx, vec4(0.0, 0.0, 0.0, 0.0));
#endif
#endif
}
