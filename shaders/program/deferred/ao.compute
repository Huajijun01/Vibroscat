// ════════════════════════════════════════════════════════════════════════════
// AO generation (half resolution, full evaluation) — writes the uimg_ao
// custom image (R8).
// ════════════════════════════════════════════════════════════════════════════
// Dispatch: half-res via workGroupsRender 0.5 (groups = ceil(view·0.5/8),
// local 8x8). Each invocation covers one 2x2 full-res block, evaluates the
// kernel (ComputeGTAO / ComputeSSAO) at the block origin; the deferred1
// fragment upsamples bilinearly, one sample/pixel/frame. Every texel is
// evaluated EVERY frame (no checkerboard phase — full convergence speed).
// Runs after the cloud compute in deferred1 (suffixless first, _a second).
//
// Storage: single-copy custom image (no flip), compute-written,
// fragment-sampled. Raw AO (no multibounce/strength): the nonlinear
// transforms are applied in deferred2 after the temporal blend (the
// accumulated field stays linear).

#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/packing.glsl"
#include "/lib/lighting/gtao.glsl"
#include "/lib/lighting/ssao.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
const vec2 workGroupsRender = vec2(0.5, 0.5);

layout(r8) uniform restrict writeonly image2D uimg_ao;  // AO (half-res)

void main() {
    ivec2 half_texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 half_size = imageSize(uimg_ao);
    if (any(greaterThanEqual(half_texel, half_size))) {
        return;
    }
    // Full-res block origin: depth and normals are sampled at full
    // resolution, the evaluation point is the block center.
    ivec2 block_origin = half_texel * 2;
    vec2 uv = (vec2(block_origin) + vec2(1.0)) * u_view_pixel_size;
#ifdef GTAO
    float ao = ComputeGTAO(uv, vec2(block_origin), frameCounter);
#elif defined(SSAO)
    float ao = ComputeSSAO(uv, vec2(block_origin), frameCounter);
#endif
    imageStore(uimg_ao, half_texel, vec4(ao, 0.0, 0.0, 1.0));
}
