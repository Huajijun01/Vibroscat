// Phase 2: robust log-domain metering, DRT-aware highlight protection and
// temporal adaptation. All added statistics run once per frame in this
// existing reduction; the pixel sweep and SSBO layout stay independent of
// the selected display transform.

#include "/lib/contract/exposure_data.glsl"
#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/color/tonemap_calibration.glsl"

layout(local_size_x = 64) in;
const ivec3 workGroups = ivec3(1, 1, 1);

const float AE_REFERENCE_LUMINANCE = 0.18;
const float AE_MIN_EXPOSURE = 1.0 / 32.0;
const float AE_MAX_EXPOSURE = 32.0;
const float AE_HISTOGRAM_BIN_EV = 20.0 / 64.0;

shared vec2 cache[64];
shared uint histogram_cache[64];

float MeteredKeyEV(float log_average_ev, float total_weight, out float highlight_ev) {
    float cumulative = 0.0;
    float full_sum = 0.0;
    float trimmed_sum = 0.0;
    highlight_ev = 0.0;
    // Trim only the extreme tails: small emissives and deep black corners
    // should not steer the whole image. Partial bins avoid threshold steps.
    float lower = total_weight * 0.05;
    float upper = total_weight * 0.95;
    float highlight_rank = total_weight * 0.98;
    for (uint i = 0u; i < 64u; ++i) {
        float count = float(histogram_cache[i]);
        float next_count = cumulative + count;
        float left_ev = -12.0 + float(i) * AE_HISTOGRAM_BIN_EV;
        float center_ev = left_ev + 0.5 * AE_HISTOGRAM_BIN_EV;
        full_sum += count * center_ev;
        float trimmed_count = max(min(next_count, upper) - max(cumulative, lower), 0.0);
        trimmed_sum += trimmed_count * center_ev;
        if (count > 0.0) {
            if (cumulative <= highlight_rank && highlight_rank < next_count) {
                highlight_ev = left_ev + (highlight_rank - cumulative) / count * AE_HISTOGRAM_BIN_EV;
            }
        }
        cumulative = next_count;
    }
    // Recover sub-bin precision from the exact log sum. A uniform image
    // meters exactly even between histogram centers; clamping prevents
    // clipped out-of-range tails from re-entering the robust estimate.
    float residual_ev = clamp(log_average_ev - full_sum / total_weight,
        -0.5 * AE_HISTOGRAM_BIN_EV, 0.5 * AE_HISTOGRAM_BIN_EV);
    float trimmed_ev = trimmed_sum / max(upper - lower, 1.0) + residual_ev;
    highlight_ev += residual_ev;
    // A median can jump across an empty histogram gap when two populations
    // each cover half the screen. The trimmed mean has no such discontinuity.
    return trimmed_ev;
}

void main() {
#ifndef AE
    // The pass runs whenever AE or BLOOM needs it; the letter entries share
    // one enable condition, so the reduction must not read or write
    // ExposureData when only BLOOM is on. The body is compiled out, not
    // skipped after a return, because barrier() may not follow a return.
    return;
#else
    uint tid = gl_LocalInvocationIndex;

    cache[tid] = vec2(log_lum_sums[tid], weight_sums[tid]);
    uint histogram_sum = 0u;
    for (uint group = 0u; group < 64u; ++group) {
        histogram_sum += luminance_histogram[group * 64u + tid];
    }
    histogram_cache[tid] = histogram_sum;
    barrier();

    for (uint s = 32u; s > 0u; s >>= 1u) {
        if (tid < s) cache[tid] += cache[tid + s];
        barrier();
    }

    if (tid == 0u) {
        float total_weight = max(cache[0].y, 1.0);
        float log_average_ev = cache[0].x / total_weight - log2(AE_REFERENCE_LUMINANCE);
        uint histogram_weight = 0u;
        for (uint i = 0u; i < 64u; ++i) histogram_weight += histogram_cache[i];
        histogram_weight = max(histogram_weight, 1u);

        float highlight_ev;
        float key_ev = MeteredKeyEV(log_average_ev, float(histogram_weight), highlight_ev);
        float scene_ev = max(key_ev, log2(1.0e-4 / AE_REFERENCE_LUMINANCE));
        float target_exposure_ev = log2(AE_TARGET_LUMINANCE / AE_REFERENCE_LUMINANCE)
            - AE_ADAPTATION_STRENGTH * scene_ev;
        // P98 protects broad highlights, not isolated sun/specular pixels.
        // Each default DRT's calibrated input reaches 95% display white at
        // this point. The 0.5-EV knee is C1 and strength=0 is truly fixed.
        float highlight_limit_ev = log2(TONEMAP_HIGHLIGHT_INPUT / AE_REFERENCE_LUMINANCE) - highlight_ev;
        float pressure = target_exposure_ev - highlight_limit_ev;
        float protection = pressure > 0.5 ? pressure
            : pow(max(pressure + 0.5, 0.0), 2.0) * 0.5;
        target_exposure_ev -= AE_ADAPTATION_STRENGTH * protection;
        target_exposure_ev = clamp(target_exposure_ev, log2(AE_MIN_EXPOSURE), log2(AE_MAX_EXPOSURE));

        // Bright adaptation is quick; dark adaptation is deliberately slower,
        // matching the asymmetric cone/rod response of the human eye.
        if (frameCounter < 2 || isnan(adapted_exposure_ev) || isinf(adapted_exposure_ev)) {
            adapted_exposure_ev = target_exposure_ev;
        } else {
            float rate_per_sec = target_exposure_ev < adapted_exposure_ev ? 4.0 : 0.8;
            // A paused or stalled frame reports a large frameTime; capping it
            // keeps one hitch from snapping the exposure in a single step.
            float step_seconds = clamp(frameTime, 0.0, 0.1);
            float w = 1.0 - exp(-step_seconds * rate_per_sec);
            // Ignore sub-0.01-EV meter noise without quantizing exposure or
            // pausing a larger lighting transition.
            if (abs(target_exposure_ev - adapted_exposure_ev) > 0.01) {
                adapted_exposure_ev = mix(adapted_exposure_ev, target_exposure_ev, clamp(w, 0.0, 1.0));
            }
        }
        exposure = exp2(adapted_exposure_ev);
    }
#endif
}
