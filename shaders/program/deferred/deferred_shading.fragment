// ============================================================================
// Deferred shading - reads GBuffer, computes diffuse + environment light
// ============================================================================
//
// Lighting model:
//   1. Sky pixels (depth >= 1.0): sample Sky View LUT directly
//   2. Surface pixels: decode GBuffer -> directional + ambient + torch
//
// Direct: Burley diffuse + Cook-Torrance GGX specular
// Ambient: SH irradiance from the cloud skybox (sky_light.glsl, L0-2,
//          projected by prepare2), x skyLight x AO, Lambertian
// Torch: blockLight masked by (1-skyLight), warm tint, Lambertian
// Ramamoorthi l convolution (A0=pi, A1=2pi/3): radiance -> irradiance.

/* RENDERTARGETS: 0,2,5 */

#include "/lib/contract/exposure_data.glsl"
#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/filters.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/packing.glsl"
#include "/lib/atmosphere/atmosphere_geometry.glsl"
#include "/lib/atmosphere/celestial.glsl"
#include "/lib/atmosphere/core.glsl"
#include "/lib/atmosphere/sky_light.glsl"
#include "/lib/atmosphere/sky_lut.glsl"
#include "/lib/cloud/render.glsl"
#include "/lib/cloud/volumetric.glsl"
#include "/lib/color/color.glsl"
#include "/lib/color/dither.glsl"
#include "/lib/lighting/ambient_light.glsl"
#include "/lib/lighting/ambient_occlusion.glsl"
#include "/lib/lighting/brdf.glsl"
#if GI_MODE != 0
#include "/lib/lighting/gi_history.glsl"
#endif
#include "/lib/material/core.glsl"
#include "/lib/raytrace/opaque_reflection.glsl"
#include "/lib/shadow/pcss.glsl"

const float COLOR_JITTER_SEED = 11.0;

layout(location = 0) out vec3 out_color;
layout(location = 1) out vec4 out_gbuf_clear;
layout(location = 2) out vec3 out_direct_brdf; // direct-light BRDF * NoL * shadow for underwater caustics (colortex5)

vec3 SampleOpaqueEnvironment(vec3 direction, float sky_light) {
    if (dot(direction, direction) < 1e-8) return vec3(0.0);
    return SkyLightFromLm(sky_light)
        * texture(usam_skylut_cloud, CloudSkyboxUV(direction)).rgb;
}

void main() {
    out_direct_brdf = vec3(0.0);
    ivec2 tx = ivec2(gl_FragCoord.xy);
    float depth = texelFetch(depthtex0, tx, 0).r;
    // Last opaque-gbuffer consumer: colortex2 freed for translucent water data.
    out_gbuf_clear = vec4(0.0);

    // -- Sky (far plane) --
    // Depth 1.0 = far plane -> Sky View LUT (baked by sky.compute; elevation/sun-angle/altitude).
    if (depth >= 1.0) {
#if OPAQUE_SSR_DEBUG > 0 || (GI_MODE == 2 && RSM_DEBUG > 0)
        out_color = vec3(0.0);
        return;
#else
        vec2 uv = (vec2(tx) + 0.5) * u_view_pixel_size;
        vec3 ndc = vec3(uv * 2.0 - 1.0, 1.0);
        vec4 view_h = gbufferProjectionInverse * vec4(ndc, 1.0);
        vec3 view_dir = normalize(mat3(gbufferModelViewInverse) * (view_h.xyz / view_h.w));
        vec3 sun_dir = normalize(u_world_sun_dir);
        vec2 sky_uv = SkyLUTUV(view_dir, sun_dir, ATM_PLANET_R, u_cam_altitude);
        vec3 sky_color = texture(usam_skylut, sky_uv).rgb;
        // Discs stay out of the LUT so clouds attenuate them by real transmittance.
        vec3 camera_pos = vec3(0.0, ATM_PLANET_R + u_cam_altitude, 0.0);
        float camera_r = length(camera_pos);
        vec4 view_transmittance = SampleTransmittance(
            TRANSMITTANCE_LUT, camera_r, camera_r * camera_r,
            dot(camera_pos, view_dir) / camera_r);
        vec3 celestial = RenderStarMap(view_dir, view_transmittance);
        celestial += RenderCelestialDiscs(view_dir, vec3(0.0), view_transmittance);
#ifdef VOLUMETRIC_CLOUDS
        vec3 camera_atm_pos = AtmosphereCameraPosition();
        float cloud_entry;
        float cloud_exit;
        bool cloud_visible = CloudShellInterval(camera_atm_pos, view_dir, cloud_entry, cloud_exit);
        if (cloud_visible
                && length(camera_atm_pos) < ATM_PLANET_R + CLOUD_BASE_ALTITUDE) {
            // Only render when the ray rises into the layer (not skimming beneath).
            cloud_visible = cloud_entry > 0.0;
        }
        if (cloud_visible) {
            // Cloud history (radiance.rgb + distance.a) via the deferred1 colortex8 flip.
            vec4 accumulated = texture(colortex8, uv);
            // Distance is never EMA-mixed; feeds relight + the distance fade.
            vec3 surface_position = camera_atm_pos + view_dir * accumulated.a;
            accumulated.z = smoothstep(0.001, 0.999, accumulated.z);
            vec3 cloud_transmittance;
            sky_color = RenderCloudLayers(view_dir, sky_color, accumulated.rgb, surface_position, cloud_entry,
                cloud_transmittance);
            // Sun/moon occluded by real cloud transmittance.
            sky_color += celestial * cloud_transmittance;
        } else {
            sky_color += celestial;
        }
#else
        sky_color += celestial;
#endif
        out_color = JitterR11G11B10F(sky_color, gl_FragCoord.xy, COLOR_JITTER_SEED);
        return;
#endif
    }

    // -- GBuffer decode --
    vec4 g1 = texelFetch(colortex1, tx, 0);
    vec4 g2 = texelFetch(colortex2, tx, 0);
    int material_id = int(g1.a * 255.0 + 0.5);
    bool is_opaque_hand = material_id == 64;
    vec2 nx_ao = Unpack2x8(g2.r);
    vec2 ny_nz = Unpack2x8(g2.g);
    vec2 rough_selector = Unpack2x8(g2.b);
    vec2 emission_aux = Unpack2x8(g2.a);
    vec4 geometry_data = texelFetch(colortex4, tx, 0);

    vec3 albedo   = ToLinear(g1.rgb);    // sRGB -> linear
    PBRMaterial material = ResolveOpaquePBR(
        albedo, rough_selector.x, rough_selector.y,
        emission_aux.x, emission_aux.y);

#if OPAQUE_SSR_DEBUG == 1
    out_color = texelFetch(colortex3, tx, 0).rgb;
    return;
#elif OPAQUE_SSR_DEBUG == 2
    out_color = texelFetch(colortex3, tx, 0).rgb;
    return;
#elif OPAQUE_SSR_DEBUG == 3
    out_color = texelFetch(colortex3, tx, 0).rgb;
    return;
#elif OPAQUE_SSR_DEBUG == 4
    out_color = texelFetch(colortex3, tx, 0).rgb;
    return;
#elif OPAQUE_SSR_DEBUG == 5
    out_color = texelFetch(colortex3, tx, 0).rgb;
    return;
#elif OPAQUE_SSR_DEBUG == 6
    out_color = material.f0;
    return;
#elif OPAQUE_SSR_DEBUG == 7
    out_color = vec3(material.perceptual_roughness);
    return;
#endif
    vec3 normal   = normalize(vec3(nx_ao.x * 2.0 - 1.0, ny_nz.x * 2.0 - 1.0, ny_nz.y * 2.0 - 1.0));
    float ao      = nx_ao.y;                            // vanilla ambient occlusion (GTAO-off fallback only)
    float gtao_ao;
    vec3 ao_effective = ResolveSurfaceAO(tx, albedo, ao, is_opaque_hand, gtao_ao);
    // decode geometric view normal from colortex4 (octahedral) -> world-space
    vec3 geo_view_n = DecodeOctahedralNormal(geometry_data.xy);
    vec3 geo_normal = normalize(mat3(gbufferModelViewInverse) * geo_view_n);
    vec2 lm       = geometry_data.zw;      // (blockLight, skyLight)
    // Plant translucency from the materialID stored in colortex1.a.
    float sss_amount = SSSAmountForId(material_id);

    // -- World position (for shadow) --
    vec2 uv = (vec2(tx) + 0.5) * u_view_pixel_size;
#ifdef TAA
    vec3 world_pos = DepthToWorldPos(uv - u_taa_offset * 0.5, depth);
#else
    vec3 world_pos = DepthToWorldPos(uv, depth);
#endif
    // Eye-space receiver position: distance responses and the view vector
    // use the eye, not the feet-space origin.
    vec3 view_pos = SceneToViewSpace(world_pos);
    vec3 view_to_eye = normalize(EyePositionSceneSpace() - world_pos);

    // -- Lightmap remapping (shared curves, see lib/lighting/ambient_light.glsl) --
    float block_light = BlockLightFromLm(lm.r);

    // -- Directional light (sun or moon) --
    vec3 light_direction = (u_world_light_dir);
    vec3 half_vector = view_to_eye + light_direction;
    vec3 half_direction = half_vector * inversesqrt(max(dot(half_vector, half_vector), 1e-8));
    float ndotl = Max0(dot(normal, light_direction));
    float ndotv = Max0(dot(normal, view_to_eye));
    float ndoth = Max0(dot(normal, half_direction));
    float vdoth = Max0(dot(view_to_eye, half_direction));
    float ldoth = Max0(dot(light_direction, half_direction));
    float geo_ndotl = dot(geo_normal, light_direction);
    vec3 direct_brdf = EvaluateDirectBRDF(
        albedo, material.f0, material.diffuse_weight,
        material.perceptual_roughness,
        ndotv, ndotl, ndoth, vdoth, ldoth);
    vec3 direct_lighting = direct_brdf * ndotl;

    // -- Shadow --
    float shadow_occlusion = 1.0;
    float sss_thickness_world = 0.0;
    vec3 shadow_proj = ProjectToShadowWithBias(world_pos, geo_ndotl);
    bool shadow_needed = ndotl > 1.0e-3 || sss_amount > 0.01;
    if (shadow_needed && all(greaterThanEqual(shadow_proj, vec3(0.0)))
            && all(lessThanEqual(shadow_proj, vec3(1.0)))) {
#ifdef SHADOW_PCSS
        vec3 shadow_clip = ProjectToShadowClip(world_pos);
        shadow_occlusion = ShadowFilterPCSS(shadow_proj, shadow_clip, gl_FragCoord.xy, view_pos, sss_amount, ndotl,
            sss_thickness_world);
#else
        // LOW tier: hardware-bilinear PCF; the blocker search stays on so
        // the plant-SSS thickness estimate keeps working (see
        // ShadowFilterHardwarePCF).
        vec3 shadow_clip = ProjectToShadowClip(world_pos);
        shadow_occlusion = ShadowFilterHardwarePCF(shadow_proj, shadow_clip, gl_FragCoord.xy, sss_amount,
            sss_thickness_world);
#endif
    }
    out_direct_brdf = direct_lighting * shadow_occlusion;

    // -- Light color sources (same colors as the gbuffer translucent passes) --
    vec3 sun_color   = ground_light.rgb;  // direct sun/moon irradiance at ground (SSBO)
    // Sky ambient: remapped sky light x AO-aware blend + AMBIENT_BASE floor (AmbientLight).
    vec3 sky_ambient = AmbientLight(normal, ao_effective, lm.g);

    // -- Composite --
    vec3 color = direct_lighting * sun_color * shadow_occlusion;

    // Plant SSS: transmission through the PCSS-measured foliage thickness,
    // after the shadow term; tinted by albedo, scalar absorption from average
    // albedo. Fades to zero at the shadow-map boundary (no AO fallback).
    if (sss_amount > 0.01) {
        float effective_shadow_distance = max(shadowDistance, 1.0);
        float shadow_ndc_edge = max(abs(shadow_proj.x * 2.0 - 1.0), abs(shadow_proj.y * 2.0 - 1.0));
        float shadow_dist_ratio = length(view_pos) / effective_shadow_distance;
        float sss_availability = smoothstep(1.0, 0.9, shadow_ndc_edge) * smoothstep(0.8, 0.7, shadow_dist_ratio);
        float ldotv = dot(light_direction, view_to_eye);
        // Normalized HG: back-lit peak stays 1 (preserves brightness scale).
        float hg_phase = PhaseMieHG(-ldotv, SHADOW_SSS_PHASE_G);
        float effective_thickness = sss_thickness_world * sss_availability;
        float average_albedo = dot(albedo, vec3(0.2126, 0.7152, 0.0722));
        float absorption = (1.0 - 0.75 * Saturate(average_albedo)) * SHADOW_SSS_DENSITY / max(sss_amount, 1.0e-3);
        vec3 transmission = sun_color * hg_phase
            * exp(-absorption * effective_thickness)
            * sss_amount * SHADOW_SSS_SCALE
            * albedo * sss_availability;
        color += transmission;
    }

    // Lambertian (no incident direction from SH/lightmap); metals have no
    // diffuse lobe. AO multiplies indirect terms only. Block light uses AO
    // cubed, blended toward 1 by falloff (occlusion visible in torchlit caves).
    vec3 lambert_brdf = EvaluateLambertBRDF(
        albedo, material.f0, material.diffuse_weight);
    vec3 diffuse_reflectance = EvaluateDiffuseReflectance(
        albedo, material.f0, material.diffuse_weight);
#if GI_MODE != 0
    vec3 gi_ambient = texelFetch(colortex9, tx, 0).rgb;
#if GI_MODE == 2 && RSM_DEBUG > 0
#if RSM_DEBUG == 4
    out_color = vec3(GIHistoryAge(texelFetch(colortex10, tx, 0).r) / float(GI_HISTORY_FRAMES));
#else
    out_color = gi_ambient;
#endif
    return;
#endif
    // Both GI estimators already include SH for uncovered directions.
#if GI_MODE == 2
    // RSM solid-angle coverage is not a receiver visibility mask. Retain
    // local AO for occluders missing from its first-surface shadow map.
    color += lambert_brdf * gi_ambient * ao_effective;
#else
    color += lambert_brdf * gi_ambient;
#endif
#else
    color += lambert_brdf * sky_ambient * ao_effective;
#endif
    color += diffuse_reflectance * TORCH_LIGHT_COLOR * block_light * gtao_ao;

    // -- Indirect specular --
    // Rough opaque surfaces use the SH environment exclusively. The transition
    // span keeps the SSR-to-SH change gradual while avoiding SSR work at the
    // high-roughness end of the range.
    float sh_weight = smoothstep(
        OPAQUE_REFLECTION_ROUGHNESS_THRESHOLD
            - OPAQUE_REFLECTION_ROUGHNESS_TRANSITION,
        OPAQUE_REFLECTION_ROUGHNESS_THRESHOLD,
        material.perceptual_roughness);
    float ssr_weight = 1.0 - sh_weight;

    float sh_reflection_ndotv = Max0(dot(normal, view_to_eye));
    float mean_ao = dot(ao_effective, vec3(1.0 / 3.0));
    vec3 sh_specular = vec3(0.0);
#ifdef OPAQUE_SSR
    vec3 history = texelFetch(colortex3, tx, 0).rgb;
    bool history_valid = dot(history, vec3(1.0)) > 1e-5;
#else
    bool history_valid = false;
#endif
    bool need_sh = true;
#ifdef OPAQUE_SSR
    need_sh = ssr_weight < 1.0;
#endif
    float specular_occlusion = SpecularOcclusion(
        sh_reflection_ndotv, mean_ao, material.perceptual_roughness);
    if (need_sh) {
        vec3 sh_reflection_direction = reflect(-view_to_eye, normal);
        float sh_reflection_ndotl = Max0(
            dot(normal, sh_reflection_direction));
        // SH-only reflections are a low-cost environment fallback. Gate them
        // by sky light visibility and AO so occluded surfaces do not retain a
        // uniform plastic specular sheen.
        vec3 sh_environment = EvalSkyRadiance(
            sh_reflection_direction, material.perceptual_roughness)
            * SkyLightFromLm(lm.g);
        // Broad SH reflections retain Fresnel lift at grazing angles. The
        // environment has already been roughness-convolved in SH space.
        vec3 sh_fresnel = FresnelSchlick(
            sh_reflection_ndotv, material.f0);
        sh_specular = sh_environment * sh_fresnel
            * VisibleGGXVisibility(
                sh_reflection_ndotv,
                sh_reflection_ndotl,
                material.alpha);
        sh_specular *= specular_occlusion;
    }

    vec3 indirect_specular = sh_specular;
#ifdef OPAQUE_SSR
    if (ssr_weight > 0.0) {
        vec3 ssr_reflection_half;
        vec3 ssr_reflection_direction = OpaqueReflectionDirection(
            normal, view_to_eye, material.perceptual_roughness, tx,
            ssr_reflection_half);
        vec3 ssr_environment = vec3(0.0);
        if (!history_valid) {
            ssr_environment = SampleOpaqueEnvironment(ssr_reflection_direction, lm.g);
        }
        float recursion_decay = min(OPAQUE_SSR_RECURSION_DECAY, 0.989);
        vec3 ssr_incident_radiance = history_valid
            ? recursion_decay * history
            : ssr_environment;
        float ssr_reflection_ndotv = sh_reflection_ndotv;
        float ssr_reflection_ndotl = Max0(
            dot(normal, ssr_reflection_direction));
        vec3 ssr_specular = ssr_incident_radiance * VisibleGGXThroughput(
            material.f0,
            Max0(dot(view_to_eye, ssr_reflection_half)),
            ssr_reflection_ndotv,
            ssr_reflection_ndotl,
            material.alpha);
        ssr_specular *= specular_occlusion;
        indirect_specular = mix(sh_specular, ssr_specular, ssr_weight);
    }
#endif
#if OPAQUE_SSR_DEBUG == 8
    color = indirect_specular;
#else
    color += indirect_specular;
#endif

    // -- Emissive --
    color += albedo * material.emission * OPAQUE_PBR_EMISSION_SCALE;

    out_color = JitterR11G11B10F(color, gl_FragCoord.xy, COLOR_JITTER_SEED);
}
