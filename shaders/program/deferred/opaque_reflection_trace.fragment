/* RENDERTARGETS: 3 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/packing.glsl"
#include "/lib/raytrace/ssr.glsl"
#include "/lib/raytrace/opaque_reflection.glsl"

layout(location = 0) out vec3 out_reflection_radiance;

void main() {
    out_reflection_radiance = vec3(0.0);

    ivec2 tx = ivec2(gl_FragCoord.xy);
    float scene_depth = texelFetch(depthtex0, tx, 0).r;
    if (scene_depth >= 1.0) return;

    vec4 packed_surface = texelFetch(colortex2, tx, 0);
    vec2 nx_ao = Unpack2x8(packed_surface.r);
    vec2 ny_nz = Unpack2x8(packed_surface.g);
    vec2 rough_selector = Unpack2x8(packed_surface.b);
    if (rough_selector.x >= OPAQUE_REFLECTION_ROUGHNESS_THRESHOLD) return;
    vec3 normal_world = normalize(vec3(
        nx_ao.x * 2.0 - 1.0,
        ny_nz.x * 2.0 - 1.0,
        ny_nz.y * 2.0 - 1.0));

    // Move the ray origin off the rasterized geometric surface before
    // marching. Reflection direction and BRDF still use the material normal;
    // this offset only prevents the first depth sample from re-hitting this
    // surface at close range.
    vec4 geometry_data = texelFetch(colortex4, tx, 0);
    vec3 geo_view_normal = DecodeOctahedralNormal(geometry_data.xy);

    vec2 uv = (vec2(tx) + 0.5) * u_view_pixel_size;
#ifdef TAA
    vec3 world_pos = DepthToWorldPos(uv - u_taa_offset * 0.5, scene_depth);
#else
    vec3 world_pos = DepthToWorldPos(uv, scene_depth);
#endif
    vec3 view_to_eye = normalize(EyePositionSceneSpace() - world_pos);
    if (dot(normal_world, view_to_eye) <= 1e-5) return;

    // One STBN pair feeds both the GGX direction sample and the trace start
    // jitter (the pair's y component), instead of two identical reads.
    vec2 stbn_random = OpaqueSSRSTBNPair(tx);
    vec3 half_vector;
    vec3 reflection_direction = OpaqueReflectionDirection(
        normal_world, view_to_eye, rough_selector.x, stbn_random, half_vector);

    vec3 view_pos = SceneToViewSpace(world_pos);
    vec3 view_direction = normalize(
        mat3(gbufferModelView) * reflection_direction);
    vec3 trace_origin = view_pos
        + geo_view_normal * 0.03
        + view_direction * 0.05;
    float trace_jitter = stbn_random.y;
    SSRHit shared_hit = TraceScreenSpaceReflection(
        trace_origin, view_direction, trace_jitter,
        OPAQUE_SSR_MAX_DISTANCE, OPAQUE_SSR_STEPS, true);
    vec3 reflection_radiance = SampleOpaqueEnvironment(
        reflection_direction, geometry_data.w);
    if (shared_hit.valid) {
        vec3 history;
        if (SampleOpaqueHistory(shared_hit, history)) {
            float recursion_decay = min(OPAQUE_SSR_RECURSION_DECAY, 0.989);
            reflection_radiance = recursion_decay * history;
        }
    }

#if OPAQUE_SSR_DEBUG == 4
    out_reflection_radiance = shared_hit.valid
        ? vec3(shared_hit.sky ? 1.0 : 0.0)
        : vec3(0.0);
#else
    out_reflection_radiance = reflection_radiance;
#endif
}
