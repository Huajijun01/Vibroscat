#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/packing.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/lighting/opaque_reflection_filter.glsl"

const vec2 workGroupsRender = vec2(1.0, 1.0);

#if OPAQUE_SPATIAL_STAGE == 0
layout(local_size_x = 8, local_size_y = 8) in;
const int SPATIAL_GROUP_SIZE = 8;
const int SPATIAL_STRIDE = 2;
#elif OPAQUE_SPATIAL_STAGE == 1
layout(local_size_x = 16, local_size_y = 16) in;
const int SPATIAL_GROUP_SIZE = 16;
const int SPATIAL_STRIDE = 1;
#else
layout(local_size_x = 16, local_size_y = 16) in;
const int SPATIAL_GROUP_SIZE = 16;
const int SPATIAL_STRIDE = 1;
#endif

const int SPATIAL_TAP_RADIUS = OPAQUE_SSR_SPATIAL_TAP_RADIUS;
const int SPATIAL_TILE_RADIUS = SPATIAL_TAP_RADIUS * SPATIAL_STRIDE;
const int SPATIAL_TILE_SIZE = SPATIAL_GROUP_SIZE
    + 2 * SPATIAL_TILE_RADIUS;

shared vec4 tile_radiance[SPATIAL_TILE_SIZE][SPATIAL_TILE_SIZE];
shared vec4 tile_metadata[SPATIAL_TILE_SIZE][SPATIAL_TILE_SIZE];
shared vec4 tile_surface[SPATIAL_TILE_SIZE][SPATIAL_TILE_SIZE];
shared vec4 tile_geometry[SPATIAL_TILE_SIZE][SPATIAL_TILE_SIZE];

#if OPAQUE_SPATIAL_STAGE == 0
layout(r11f_g11f_b10f) uniform restrict readonly image2D colorimg3;
layout(rg16f) uniform restrict readonly image2D colorimg11;
layout(r11f_g11f_b10f) uniform restrict writeonly image2D colorimg6;
layout(rg16f) uniform restrict writeonly image2D colorimg7;
#elif OPAQUE_SPATIAL_STAGE == 1
layout(r11f_g11f_b10f) uniform restrict readonly image2D colorimg6;
layout(rg16f) uniform restrict readonly image2D colorimg7;
layout(r11f_g11f_b10f) uniform restrict writeonly image2D colorimg3;
layout(rg16f) uniform restrict writeonly image2D colorimg11;
#else
layout(r11f_g11f_b10f) uniform restrict readonly image2D colorimg3;
layout(rg16f) uniform restrict readonly image2D colorimg11;
layout(r11f_g11f_b10f) uniform restrict writeonly image2D colorimg6;
layout(rg16f) uniform restrict writeonly image2D colorimg7;
#endif

#if OPAQUE_SPATIAL_STAGE == 0
#define SRC_RADIANCE colorimg3
#define SRC_METADATA colorimg11
#define DST_RADIANCE colorimg6
#define DST_METADATA colorimg7
#elif OPAQUE_SPATIAL_STAGE == 1
#define SRC_RADIANCE colorimg6
#define SRC_METADATA colorimg7
#define DST_RADIANCE colorimg3
#define DST_METADATA colorimg11
#else
#define SRC_RADIANCE colorimg3
#define SRC_METADATA colorimg11
#define DST_RADIANCE colorimg6
#define DST_METADATA colorimg7
#endif

ivec2 SpatialClamp(ivec2 coord, ivec2 size) {
    return clamp(coord, ivec2(0), size - 1);
}

void LoadSpatialTile(ivec2 group_base, ivec2 source_size) {
    uint local_index = gl_LocalInvocationIndex;
    uint tile_area = uint(SPATIAL_TILE_SIZE * SPATIAL_TILE_SIZE);
    uint lane_count = uint(SPATIAL_GROUP_SIZE * SPATIAL_GROUP_SIZE);
    for (uint index = local_index; index < tile_area; index += lane_count) {
        uint tile_y = index / uint(SPATIAL_TILE_SIZE);
        uint tile_x = index % uint(SPATIAL_TILE_SIZE);
        ivec2 coord = group_base - ivec2(SPATIAL_TILE_RADIUS)
            + ivec2(int(tile_x), int(tile_y));
        coord = SpatialClamp(coord, source_size);

        vec4 packed_surface = texelFetch(colortex2, coord, 0);
        vec2 nx_ao = Unpack2x8(packed_surface.r);
        vec2 ny_nz = Unpack2x8(packed_surface.g);
        vec2 roughness = Unpack2x8(packed_surface.b);
        vec3 shading_normal = normalize(vec3(
            nx_ao.x * 2.0 - 1.0,
            ny_nz.x * 2.0 - 1.0,
            ny_nz.y * 2.0 - 1.0));
        vec3 geometry_normal = DecodeOctahedralNormal(
            texelFetch(colortex4, coord, 0).xy);
        float depth = texelFetch(depthtex1, coord, 0).r;
        float linear_depth = depth >= 1.0
            ? far
            : LinearDepthFromScreenDepth(depth);

        ivec2 tile_coord = ivec2(int(tile_x), int(tile_y));
        tile_radiance[tile_coord.y][tile_coord.x] = imageLoad(
            SRC_RADIANCE, coord);
        vec2 metadata = imageLoad(SRC_METADATA, coord).rg;
        tile_metadata[tile_coord.y][tile_coord.x] = vec4(
            metadata, metadata.y > 1e-5 ? 1.0 : 0.0,
            metadata.x < 0.0 ? 1.0 : 0.0);
        tile_surface[tile_coord.y][tile_coord.x] = vec4(
            shading_normal, roughness.x);
        tile_geometry[tile_coord.y][tile_coord.x] = vec4(
            geometry_normal, linear_depth);
    }
}

void main() {
    ivec2 source_size = imageSize(SRC_RADIANCE);
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 group_base = ivec2(gl_WorkGroupID.xy)
        * SPATIAL_GROUP_SIZE;
    LoadSpatialTile(group_base, source_size);
    barrier();

    if (any(greaterThanEqual(gid, source_size))) return;

    ivec2 local_center = ivec2(gl_LocalInvocationID.xy)
        + ivec2(SPATIAL_TILE_RADIUS);
    vec4 center_metadata = tile_metadata[
        local_center.y][local_center.x];
    vec4 center_surface = tile_surface[
        local_center.y][local_center.x];
    vec4 center_geometry = tile_geometry[
        local_center.y][local_center.x];
    float center_distance = center_metadata.x;
    bool center_source_known = abs(center_distance) > 1e-5;
    bool center_surface_valid = center_geometry.w < far;

    vec3 radiance_sum = vec3(0.0);
    float distance_magnitude_sum = 0.0;
    float source_sign_sum = 0.0;
    float confidence_sum = 0.0;
    float radiance_weight = 0.0;
    float compatibility_weight = 0.0;

    if (center_surface_valid) {
        float center_radius = OpaqueSpatialRadius(
            center_surface.w, center_source_known
                ? abs(center_distance) : 0.0);
        int stride = OpaqueSpatialStride(center_radius,
            OPAQUE_SPATIAL_STAGE);
        bool center_only = stride == 0;
        float tap_radius = max(1.0, ceil(center_radius
            / float(SPATIAL_STRIDE)));
        tap_radius = min(tap_radius, float(SPATIAL_TAP_RADIUS));
        for (int oy = -SPATIAL_TAP_RADIUS;
                oy <= SPATIAL_TAP_RADIUS; ++oy) {
            for (int ox = -SPATIAL_TAP_RADIUS;
                    ox <= SPATIAL_TAP_RADIUS; ++ox) {
                ivec2 tap = ivec2(ox, oy);
                if (center_only && any(notEqual(tap, ivec2(0)))) continue;
                int kernel_radius = int(tap_radius);
                float kernel_weight = OpaqueSpatialKernelWeight(
                    tap, kernel_radius);
                if (kernel_weight <= 0.0) continue;

                ivec2 sample_tile = local_center
                    + tap * SPATIAL_STRIDE;
                vec4 sample_metadata = tile_metadata[
                    sample_tile.y][sample_tile.x];
                float sample_confidence = clamp(
                    sample_metadata.y, 0.0, 1.0);
                if (sample_metadata.z < 0.5 || sample_confidence <= 0.0) {
                    continue;
                }
                vec3 sample_radiance = tile_radiance[
                    sample_tile.y][sample_tile.x].rgb;
                if (any(isnan(sample_radiance))
                        || any(isinf(sample_radiance))) continue;

                vec4 sample_surface = tile_surface[
                    sample_tile.y][sample_tile.x];
                vec4 sample_geometry = tile_geometry[
                    sample_tile.y][sample_tile.x];
                bool sample_environment = sample_metadata.w > 0.5;
                float compatibility = OpaqueSpatialWeight(
                    kernel_weight, center_geometry.w, sample_geometry.w,
                    center_geometry.xyz, sample_geometry.xyz,
                    center_surface.xyz, sample_surface.xyz,
                    center_surface.w, sample_surface.w,
                    center_distance, sample_metadata.x);
                if (compatibility <= 0.0) continue;

                float sample_weight = compatibility * sample_confidence;
                radiance_sum += max(sample_radiance, vec3(0.0))
                    * sample_weight;
                distance_magnitude_sum += abs(sample_metadata.x)
                    * sample_weight;
                source_sign_sum += (sample_environment ? -1.0 : 1.0)
                    * sample_weight;
                confidence_sum += sample_confidence * compatibility;
                radiance_weight += sample_weight;
                compatibility_weight += compatibility;
            }
        }
    }

    if (radiance_weight > 1e-5 && compatibility_weight > 1e-5) {
        vec3 result = radiance_sum / radiance_weight;
        float output_sign = center_source_known ? sign(center_distance)
            : source_sign_sum < 0.0 ? -1.0 : 1.0;
        float output_distance = output_sign
            * distance_magnitude_sum / radiance_weight;
        float output_confidence = clamp(
            confidence_sum / compatibility_weight, 0.0, 1.0);
        imageStore(DST_RADIANCE, gid, vec4(result, 0.0));
        imageStore(DST_METADATA, gid, vec4(
            output_distance, output_confidence, 0.0, 0.0));
    } else {
        imageStore(DST_RADIANCE, gid, vec4(0.0));
        imageStore(DST_METADATA, gid, vec4(0.0));
    }
}
