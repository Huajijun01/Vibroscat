/* RENDERTARGETS: 11 */

in vec2 v_texcoord;
in vec4 v_color;
#include "/lib/contract/uniforms.glsl"

layout(location = 0) out vec4 out_weather;

void main() {
    vec4 tex = texture(gtexture, v_texcoord);
    float alpha = tex.a * v_color.a;
    if (alpha < 0.0001) discard;
    out_weather = vec4(tex.rgb * v_color.rgb, alpha);
}
