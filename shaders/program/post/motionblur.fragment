/* RENDERTARGETS: 0 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/noise.glsl"
#include "/lib/color/dither.glsl"

const float COLOR_JITTER_SEED = 71.0;

layout(location = 0) out vec3 out_color;

bool IsOpaqueHand(ivec2 texel) {
    ivec2 sample_texel = clamp(ivec2((vec2(texel) + 0.5) * u_render_scale),
        ivec2(0), ivec2(u_render_res) - 1);
    float scene_depth = texelFetch(depthtex0, sample_texel, 0).r;
    int material_id = int(texelFetch(colortex1, sample_texel, 0).a * 255.0 + 0.5);
    return scene_depth < 1.0 && material_id == 64;
}

vec3 PassthroughColor() {
    vec3 scene = texelFetch(colortex0, ivec2(gl_FragCoord.xy), 0).xyz;
#ifdef COLOR_DITHER
    return JitterR11G11B10F(scene, gl_FragCoord.xy, COLOR_JITTER_SEED);
#else
    return scene;
#endif
}

void main() {
    // Two independent fallbacks (MOTION_BLUR off, TAA off) keep the guards separate.
#ifndef MOTION_BLUR
    out_color = PassthroughColor();
    return;
#endif
#ifndef TAA
    out_color = PassthroughColor();
    return;
#endif
    ivec2 tx = ivec2(gl_FragCoord.xy);
    vec2 texcoord = (vec2(tx) + 0.5) * u_view_pixel_size;

    vec3 encoded_motion = texelFetch(colortex0, tx, 0).rgb;
    // RG hold the motion magnitude, B two sign bits (bit 0 = X, bit 1 = Y);
    // both TAA paths share this encoding.
    int motion_sign = int(encoded_motion.b + 0.5);
    vec2 velocity = encoded_motion.rg
        * vec2((motion_sign & 1) != 0 ? -1.0 : 1.0, (motion_sign & 2) != 0 ? -1.0 : 1.0);
    vec3 scene = texelFetch(colortex5, tx, 0).rgb;

    bool is_opaque_hand = IsOpaqueHand(tx);
    if (is_opaque_hand) {
        // The view-model has no world-space motion vector; keep it sharp.
#ifdef COLOR_DITHER
        out_color = JitterR11G11B10F(scene, gl_FragCoord.xy, COLOR_JITTER_SEED);
#else
        out_color = scene;
#endif
        return;
    }

    float vel_len = length(velocity * u_screen_res);
    if (vel_len < 0.5) {
#ifdef COLOR_DITHER
        out_color = JitterR11G11B10F(scene, gl_FragCoord.xy, COLOR_JITTER_SEED);
#else
        out_color = scene;
#endif
        return;
    }

    float noise = InterleavedGradientNoise(vec2(tx));
    float sample_count = 16.0;
    vec2 step_size = velocity * MB_STRENGTH / sample_count;
    vec2 sample_coord = texcoord - velocity * 0.5 + step_size * noise;

    vec3 blurred = vec3(0.0);
    for (float i = 0.0; i < sample_count; i += 1.0) {
        blurred += textureLod(colortex5, sample_coord, 0.0).rgb;
        sample_coord += step_size;
    }
    blurred /= sample_count;

    float blend = clamp(vel_len * 0.1, 0.0, 1.0);
    vec3 motion_blurred_scene = mix(scene, blurred, blend);
#ifdef COLOR_DITHER
    out_color = JitterR11G11B10F(motion_blurred_scene, gl_FragCoord.xy, COLOR_JITTER_SEED);
#else
    out_color = motion_blurred_scene;
#endif
}
