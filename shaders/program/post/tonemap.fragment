/* RENDERTARGETS: 12 */

#include "/lib/post/tonemap_stage.glsl"

layout(location = 0) out vec4 out_color;

void main() {
    // The RGBA16F attachment performs the storage rounding for this pass; the
    // folded path in final reproduces it with QuantizeToHalf().
    out_color = vec4(TonemapStage(gl_FragCoord.xy), 1.0);
}
