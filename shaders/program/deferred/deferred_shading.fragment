// ============================================================================
// Deferred shading - reads GBuffer, computes diffuse + environment light
// ============================================================================
//
// Lighting model:
//   1. Sky pixels (depth >= 1.0): sample Sky View LUT directly
//   2. Surface pixels: decode GBuffer -> directional + ambient + torch
//
// Direct: Burley diffuse + Cook-Torrance GGX specular
// Ambient: SH irradiance from the cloud skybox (sky_light.glsl, L0-2,
//          projected by prepare2), x skyLight x AO, Lambertian
// Torch: blockLight masked by (1-skyLight), warm tint, Lambertian
// Ramamoorthi l convolution (A0=pi, A1=2pi/3): radiance -> irradiance.

/* RENDERTARGETS: 0,2,5 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/sky_light_data.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/noise.glsl"
#include "/lib/core/packing.glsl"
#include "/lib/atmosphere/atmosphere_geometry.glsl"
#include "/lib/atmosphere/celestial.glsl"
#include "/lib/atmosphere/sky_light.glsl"
#include "/lib/atmosphere/sky_lut.glsl"
#include "/lib/atmosphere/transmittance.glsl"
#include "/lib/cloud/composite.glsl"
#include "/lib/cloud/volumetric.glsl"
#include "/lib/color/spaces.glsl"
#include "/lib/color/dither.glsl"
#include "/lib/lighting/ambient_light.glsl"
#include "/lib/lighting/lightmap.glsl"
#include "/lib/lighting/ambient_occlusion.glsl"
#include "/lib/lighting/brdf.glsl"
#if GI_MODE != 0
#include "/lib/lighting/gi_denoise.glsl"
#include "/lib/lighting/gi_history.glsl"
#endif
#include "/lib/material/model.glsl"
#include "/lib/raytrace/opaque_reflection.glsl"
#include "/lib/scattering/phase.glsl"
#include "/lib/shadow/contact_shadow.glsl"
#include "/lib/shadow/pcss.glsl"

const float COLOR_JITTER_SEED = 11.0;

layout(location = 0) out vec3 out_color;
layout(location = 1) out vec4 out_gbuf_clear;
layout(location = 2) out vec3 out_direct_brdf; // direct-light BRDF * NoL * shadow for underwater caustics (colortex5)

void main() {
    out_direct_brdf = vec3(0.0);
    ivec2 tx = ivec2(gl_FragCoord.xy);
    float scene_depth = texelFetch(depthtex0, tx, 0).r;
    // Last opaque-gbuffer consumer: colortex2 freed for translucent water data.
    out_gbuf_clear = vec4(0.0);

    // -- Sky (far plane) --
    // Depth 1.0 = far plane -> Sky View LUT (baked by sky.compute; elevation/sun-angle/altitude).
    if (scene_depth >= 1.0) {
#if SHADOW_SSS_DEBUG == 1 || OPAQUE_SSR_DEBUG > 0 || (GI_MODE == 2 && RSM_DEBUG > 0)
        out_color = vec3(0.0);
        return;
#else
        vec2 uv = (vec2(tx) + 0.5) * u_view_pixel_size;
        vec3 view_dir = normalize(mat3(gbufferModelViewInverse)
            * NDCToView(vec3(uv * 2.0 - 1.0, 1.0)));
        vec3 sun_dir = normalize(u_world_sun_dir);
        vec2 sky_uv = SkyLUTUV(view_dir, sun_dir, ATM_PLANET_R, u_cam_altitude);
        vec3 sky_color = texture(usam_skylut, sky_uv).rgb;
        // Discs stay out of the LUT so clouds attenuate them by real transmittance.
        vec3 camera_pos = AtmosphereCameraPosition();
        float camera_r = length(camera_pos);
        vec4 view_transmittance = SampleTransmittance(
            utex_tslut, camera_r, camera_r * camera_r,
            dot(camera_pos, view_dir) / camera_r);
        vec3 celestial = vec3(0.0);
#if defined(VOLUMETRIC_CLOUDS) || defined(CIRRUS)
        vec3 cloud_transmittance = vec3(1.0);
        vec3 volumetric_radiance = vec3(0.0, 0.0, 1.0);
        vec3 volumetric_surface_pos = vec3(0.0);
        float volumetric_entry = 1.0e9;
#ifdef VOLUMETRIC_CLOUDS
        vec3 camera_atmosphere_pos = AtmosphereCameraPosition();
        float cloud_entry;
        float cloud_exit;
        bool cloud_visible = CloudShellInterval(camera_atmosphere_pos, view_dir, cloud_entry, cloud_exit);
        if (cloud_visible
                && length(camera_atmosphere_pos) < ATM_PLANET_R + CLOUD_BASE_ALTITUDE) {
            // Only render when the ray rises into the layer (not skimming beneath).
            cloud_visible = cloud_entry > 0.0;
        }
        if (cloud_visible) {
            // Cloud history (radiance.rgb + distance.a) via the deferred1
            // colortex8 flip. Distance is never EMA-mixed; feeds relight and
            // the distance fade.
            vec4 accumulated = texelFetch(colortex8, tx, 0);
            volumetric_surface_pos = camera_atmosphere_pos + view_dir * accumulated.a;
            accumulated.z = smoothstep(0.001, 0.999, accumulated.z);
            volumetric_radiance = accumulated.rgb;
            volumetric_entry = cloud_entry;
        }
#endif
#ifdef CIRRUS
        // Cirrus light march seeded at this pixel; the volumetric march
        // (clouds_render pass) seeds at its own R2 lattice position.
        float cirrus_light_jitter = SampleSTBN(tx, frameCounter);
#else
        float cirrus_light_jitter = 0.0;
#endif
        sky_color = RenderCloudLayers(view_dir, sky_color, volumetric_radiance,
            volumetric_surface_pos, volumetric_entry, cirrus_light_jitter,
            cloud_transmittance);
        // Sun/moon occluded by real cloud transmittance. An opaque column
        // leaves nothing of either term, so the star field and the discs are
        // skipped there rather than computed and multiplied by zero.
        if (!all(equal(cloud_transmittance, vec3(0.0)))) {
            celestial = RenderStarMap(view_dir, view_transmittance);
            celestial += RenderCelestialDiscs(view_dir, vec3(0.0), view_transmittance);
        }
        sky_color += celestial * cloud_transmittance;
#else
        celestial = RenderStarMap(view_dir, view_transmittance);
        celestial += RenderCelestialDiscs(view_dir, vec3(0.0), view_transmittance);
        sky_color += celestial;
#endif
        out_color = JitterR11G11B10F(sky_color, gl_FragCoord.xy, COLOR_JITTER_SEED);
        return;
#endif
    }

    // -- GBuffer decode --
    vec4 g1 = texelFetch(colortex1, tx, 0);
    vec4 g2 = texelFetch(colortex2, tx, 0);
    int material_id = int(g1.a * 255.0 + 0.5);
    bool is_opaque_hand = material_id == 64;
    vec2 nx_ao = Unpack2x8(g2.r);
    vec2 ny_nz = Unpack2x8(g2.g);
    vec2 rough_selector = Unpack2x8(g2.b);
    vec2 emission_aux = Unpack2x8(g2.a);
    vec4 geometry_data = texelFetch(colortex4, tx, 0);

    vec3 albedo   = ToLinear(g1.rgb);    // sRGB -> linear
    PBRMaterial material = ResolveOpaquePBR(
        albedo, rough_selector.x, rough_selector.y,
        emission_aux.x, emission_aux.y);

#if OPAQUE_SSR_DEBUG == 1
    out_color = texelFetch(colortex3, tx, 0).rgb;
    return;
#elif OPAQUE_SSR_DEBUG == 2
    out_color = texelFetch(colortex3, tx, 0).rgb;
    return;
#elif OPAQUE_SSR_DEBUG == 3
    out_color = texelFetch(colortex3, tx, 0).rgb;
    return;
#elif OPAQUE_SSR_DEBUG == 4
    out_color = texelFetch(colortex3, tx, 0).rgb;
    return;
#elif OPAQUE_SSR_DEBUG == 5
    out_color = texelFetch(colortex3, tx, 0).rgb;
    return;
#elif OPAQUE_SSR_DEBUG == 6
    out_color = material.f0;
    return;
#elif OPAQUE_SSR_DEBUG == 7
    out_color = vec3(material.perceptual_roughness);
    return;
#endif
    vec3 normal_world   = normalize(vec3(nx_ao.x * 2.0 - 1.0, ny_nz.x * 2.0 - 1.0, ny_nz.y * 2.0 - 1.0));
    float ao      = nx_ao.y;                            // vanilla ambient occlusion (GTAO-off fallback only)
    float screen_ao;
    vec3 ao_effective = ResolveSurfaceAO(tx, albedo, ao, is_opaque_hand, screen_ao);
    // colortex4 carries the world-space geometric normal (octahedral RG).
    vec3 geo_normal = DecodeOctahedralNormal(geometry_data.xy);
#if (CONTACT_SHADOW == 1 && (defined(WORLD_OVERWORLD) || defined(WORLD_END))) || defined(GI_DENOISE)
    // Contact shadows and the GI disocclusion repair work in view space. Both
    // are compile-time gated, so the transform is paid only for them.
    vec3 geo_view_normal = normalize(mat3(gbufferModelView) * geo_normal);
#endif
    vec2 lm       = geometry_data.zw;      // (blockLight, skyLight)
    // Plant translucency from the materialID stored in colortex1.a.
#ifdef SHADOW_SSS
    float sss_amount = SSSAmountForId(material_id);
#else
    // Compile-time off: the literal zero folds every SSS branch below out.
    float sss_amount = 0.0;
#endif

    // -- World position (for shadow) --
    vec2 uv = (vec2(tx) + 0.5) * u_view_pixel_size;
#ifdef TAA
    vec3 world_pos = DepthToWorldPos(uv - u_taa_offset * 0.5, scene_depth);
#else
    vec3 world_pos = DepthToWorldPos(uv, scene_depth);
#endif
    // Eye-space receiver position: distance responses and the view vector
    // use the eye, not the feet-space origin.
    vec3 view_pos = SceneToViewSpace(world_pos);
    vec3 view_to_eye = normalize(EyePositionSceneSpace() - world_pos);

    // -- Lightmap remapping (shared curves, see lib/lighting/lightmap.glsl) --
    float block_light = BlockLightFromLm(lm.r);

    // -- Directional light (sun or moon) --
    vec3 light_direction = (u_world_light_dir);
    vec3 half_vector = view_to_eye + light_direction;
    vec3 half_direction = half_vector * inversesqrt(max(dot(half_vector, half_vector), 1e-8));
    float ndotl = Max0(dot(normal_world, light_direction));
    float ndotv = Max0(dot(normal_world, view_to_eye));
    float ndoth = Max0(dot(normal_world, half_direction));
    float vdoth = Max0(dot(view_to_eye, half_direction));
    float ldoth = Max0(dot(light_direction, half_direction));
    float geo_ndotl = dot(geo_normal, light_direction);
    vec3 direct_brdf = EvaluateDirectBRDF(
        albedo, material.f0, material.diffuse_weight,
        material.perceptual_roughness,
        ndotv, ndotl, ndoth, vdoth, ldoth);
    vec3 direct_lighting = direct_brdf * ndotl;

    // -- Shadow --
    float shadow_occlusion = 1.0;
    float sss_thickness_world = 0.0;
    vec3 shadow_proj = ProjectToShadowWithBias(world_pos, geo_ndotl);
    bool shadow_needed = ndotl > 1.0e-3 || sss_amount > 0.01;
    // One STBN read feeds both the shadow filter and the contact shadow:
    // same texel and time slice, so both consumers share the dither.
    float stbn_dither = SampleSTBN(ivec2(gl_FragCoord.xy), STBNFrame());
    // Shadow-map coverage confidence, shared by the direct-shadow fade-out
    // and the plant-SSS transmission handoff. Evaluated in raw undistorted
    // shadow clip space, where the extent maps linearly to world distance:
    // the fade starts at SHADOW_SSS_FADE_START of the XY/depth extent and
    // reaches zero exactly at the coverage border, so the direct shadow and
    // the SSS thickness hand off on one curve instead of staggered ones.
    float shadow_coverage = 1.0;
    if (shadow_needed) {
        vec3 shadow_clip = ProjectToShadowClip(world_pos);
        float clip_edge = max(abs(shadow_clip.x), abs(shadow_clip.y));
        float xy_coverage = 1.0 - smoothstep(SHADOW_SSS_FADE_START, 1.0, clip_edge);
        float z_coverage = 1.0 - smoothstep(SHADOW_SSS_FADE_START, 1.0, abs(shadow_clip.z));
        shadow_coverage = xy_coverage * z_coverage;
        float shadow_filtered = 1.0;
        if (shadow_coverage > 1.0e-3) {
#ifdef SHADOW_PCSS
            shadow_filtered = ShadowFilterPCSS(shadow_proj, shadow_clip, stbn_dither, view_pos,
                sss_amount, ndotl, sss_thickness_world);
#else
            // LOW tier: hardware-bilinear PCF; the blocker search stays on
            // so the plant-SSS thickness estimate keeps working (see
            // ShadowFilterHardwarePCF).
            shadow_filtered = ShadowFilterHardwarePCF(shadow_proj, shadow_clip, stbn_dither,
                sss_amount, sss_thickness_world);
#endif
        }
        // Ease the shadow-map result into the unshadowed out-of-coverage
        // response on the same curve; no hard switch at the map border.
        shadow_occlusion = mix(1.0, shadow_filtered, shadow_coverage);
    }
#if CONTACT_SHADOW == 1 && (defined(WORLD_OVERWORLD) || defined(WORLD_END))
    if (shadow_needed) {
        // Screen-space contact shadows, evaluated inline on the receiver: an
        // upper bound on the shadow-map result. The march fills PCF seam
        // leaks along contact lines and keeps directional occlusion past the
        // shadow-map boundary.
        float contact_shadow = ContactShadowOcclusion(view_pos, geo_view_normal, geo_ndotl,
            stbn_dither);
        shadow_occlusion = min(shadow_occlusion, contact_shadow);
#if CONTACT_SHADOW_DEBUG > 0
        // Debug view: raw visibility factor or boosted darkness. Pixels that
        // skip the march (back faces, weak direct light) keep scene color.
        out_color = vec3(CONTACT_SHADOW_DEBUG == 1
            ? contact_shadow
            : min((1.0 - contact_shadow) * 4.0, 1.0));
        return;
#endif
    }
#endif
    // -- Composite --
    // All terms below are BRDF * incident visibility until the final light
    // color multiplication. SSS redistributes only the diffuse light budget.
    vec3 direct_visibility = direct_lighting * shadow_occlusion;
    out_direct_brdf = direct_visibility;
    // -- Light color sources (same colors as the gbuffer translucent passes) --
    vec3 sun_color   = ground_light.rgb;  // direct sun/moon irradiance at ground (SSBO)
    // Sky ambient: remapped sky light x AO-aware blend + AMBIENT_FLOOR floor (AmbientLight).
    vec3 sky_ambient = AmbientLight(normal_world, ao_effective, lm.g);
    vec3 sss_lighting = vec3(0.0);
    // Same-argument reflectance as the torch term below; evaluated once.
    vec3 diffuse_reflectance = EvaluateDiffuseReflectance(
        albedo, material.f0, material.diffuse_weight);

    if (sss_amount > 0.01) {
        // shadow_coverage (see the shadow section) fades the map-measured
        // transmission into lightmap sky access, preserving the material
        // response outside shadow coverage.
        float ldotv = dot(light_direction, view_to_eye);
        float sss_phase = PhaseHenyeyGreensteinSurfaceNormalized(-ldotv, SHADOW_SSS_PHASE_G);
        float average_albedo = Luminance(albedo);
        float absorption = (1.0 - 0.75 * Saturate(average_albedo))
            * SHADOW_SSS_DENSITY / sss_amount;
        float map_transmission = exp(-absorption * sss_thickness_world);
        // Blend the evaluated transmission, not thickness: fading optical
        // depth first would brighten the transition before removing it.
        float transmission = mix(SkyLightFromLm(lm.g), map_transmission,
            shadow_coverage);
        // Clamp the material budget first so ENERGY remains proportional
        // throughout 0..1, including when the legacy SCALE exceeds one.
        // Energy carries no coverage factor: the transmission blend already
        // trades the map estimate for the lightmap response, so a second
        // fade here would zero the handoff and stage a second transition.
        float material_share = Saturate(sss_amount * SHADOW_SSS_SCALE);
        float sss_energy = material_share * Saturate(SHADOW_SSS_ENERGY);
        vec3 direct_diffuse = albedo * (vec3(1.0) - FresnelSchlick(vdoth, material.f0))
            * material.diffuse_weight
            * DiffuseBurley(ndotv, ndotl, ldoth, material.perceptual_roughness)
            * ndotl * shadow_occlusion;
        // Thickness already attenuates incoming light. A second (1-shadow)
        // gate would remove transmission from unobstructed thin foliage.
        sss_lighting = diffuse_reflectance * sss_phase * transmission * sss_energy;
        // Hand the diffuse budget over only where the transmission lobe can
        // return it: phase * PI matches the (1/PI) diffuse response, so
        // weak-phase directions keep plain diffuse shading and back-lit
        // directions pay the full ENERGY share.
        float removal_share = sss_energy * Saturate(sss_phase * PI);
        direct_visibility = max(direct_visibility - direct_diffuse * removal_share,
            vec3(0.0));
    }
    vec3 color = (direct_visibility + sss_lighting) * sun_color;
#if SHADOW_SSS_DEBUG == 1
    // Isolate the actual term; fog and post-processing still follow this pass.
    out_color = sss_lighting * sun_color;
    return;
#endif

    // Lambertian (no incident direction from SH/lightmap); metals have no
    // diffuse lobe. AO multiplies indirect terms only. Block light uses AO
    // cubed, blended toward 1 by falloff (occlusion visible in torchlit caves).
    vec3 lambert_brdf = EvaluateLambertBRDF(
        albedo, material.f0, material.diffuse_weight);
#if GI_MODE != 0
    vec3 gi_ambient = texelFetch(colortex9, tx, 0).rgb;
    // The neighbourhood repair runs before the debug early-out so the
    // "filtered" debug view can show it; the lighting path below uses the
    // same repaired value it always did.
    vec3 gi_filtered = gi_ambient;
#ifdef GI_DENOISE
    // Rejected history (metadata age 1) leaves the raw 1-spp estimate in
    // colortex9; borrow the temporally filtered neighborhood before lighting.
    if (GIHistoryAge(texelFetch(colortex10, tx, 0).r) == 1.0) {
        vec3 repaired_irradiance;
        if (RepairGIDisocclusion(tx, view_pos, geo_view_normal, normal_world,
                repaired_irradiance)) {
            gi_filtered = repaired_irradiance;
        }
    }
#endif
#if GI_MODE == 2 && RSM_DEBUG > 0
#if RSM_DEBUG == 4
    out_color = vec3(GIHistoryAge(texelFetch(colortex10, tx, 0).r) / float(GI_HISTORY_FRAMES));
#elif RSM_DEBUG == 3
    out_color = gi_filtered;
#else
    out_color = gi_ambient;
#endif
    return;
#endif
    // Both GI estimators already include SH for uncovered directions.
#if GI_MODE == 2
    // Retain local AO for occluders missing from RSM's first-surface
    // shadow map.
    color += lambert_brdf * gi_filtered * ao_effective;
#else
    color += lambert_brdf * gi_filtered;
#endif
#else
    color += lambert_brdf * sky_ambient * ao_effective;
#endif
    color += diffuse_reflectance * TORCH_LIGHT_COLOR * block_light * screen_ao;

    // -- Indirect specular --
    // Rough opaque surfaces use the SH environment exclusively. The transition
    // span keeps the SSR-to-SH change gradual while avoiding SSR work at the
    // high-roughness end of the range.
    float sh_weight = smoothstep(
        OPAQUE_REFLECTION_ROUGHNESS_THRESHOLD
            - OPAQUE_REFLECTION_ROUGHNESS_TRANSITION,
        OPAQUE_REFLECTION_ROUGHNESS_THRESHOLD,
        material.perceptual_roughness);
    float ssr_weight = 1.0 - sh_weight;

    // Same geometric term as ndotv above; nothing rewrites `normal` between.
    float sh_reflection_ndotv = ndotv;
    float mean_ao = dot(ao_effective, vec3(1.0 / 3.0));
    vec3 sh_specular = vec3(0.0);
    bool need_sh = true;
#ifdef OPAQUE_SSR
    need_sh = ssr_weight < 1.0;
#endif
    float specular_occlusion = SpecularOcclusion(
        sh_reflection_ndotv, mean_ao, material.perceptual_roughness);
    if (need_sh) {
        vec3 sh_reflection_direction = reflect(-view_to_eye, normal_world);
        float sh_reflection_ndotl = Max0(
            dot(normal_world, sh_reflection_direction));
        // SH-only reflections are a low-cost environment fallback. Gate them
        // by sky light visibility and AO so occluded surfaces do not retain a
        // uniform plastic specular sheen.
        vec3 sh_environment = EvalSkyRadiance(
            sh_reflection_direction, material.perceptual_roughness)
            * SkyLightFromLm(lm.g);
        // Broad SH reflections retain Fresnel lift at grazing angles. The
        // environment has already been roughness-convolved in SH space.
        vec3 sh_fresnel = FresnelSchlick(
            sh_reflection_ndotv, material.f0);
        sh_specular = sh_environment * sh_fresnel
            * VisibleGGXVisibility(
                sh_reflection_ndotv,
                sh_reflection_ndotl,
                material.alpha);
        sh_specular *= specular_occlusion;
    }

    vec3 indirect_specular = sh_specular;
#ifdef OPAQUE_SSR
    if (ssr_weight > 0.0) {
        vec3 ssr_reflection_half;
        vec3 ssr_reflection_direction = OpaqueReflectionDirection(
            normal_world, view_to_eye, material.perceptual_roughness,
            OpaqueSSRSTBNPair(tx), ssr_reflection_half);
        vec3 ssr_incident_radiance = texelFetch(colortex3, tx, 0).rgb;
        float ssr_reflection_ndotv = sh_reflection_ndotv;
        float ssr_reflection_ndotl = Max0(
            dot(normal_world, ssr_reflection_direction));
        vec3 ssr_specular = ssr_incident_radiance * VisibleGGXThroughput(
            material.f0,
            Max0(dot(view_to_eye, ssr_reflection_half)),
            ssr_reflection_ndotv,
            ssr_reflection_ndotl,
            material.alpha);
        ssr_specular *= specular_occlusion;
        indirect_specular = mix(sh_specular, ssr_specular, ssr_weight);
    }
#endif
    // Sundial-style rough-material gate: dielectric reflection reaches zero
    // at the configured roughness cutoff, while metalness moves that cutoff
    // toward rougher materials. The same weight applies to SH and SSR.
    float reflection_roughness = material.perceptual_roughness;
    float reflection_smoothness = 1.0 - reflection_roughness;
    float reflection_threshold = clamp(
        OPAQUE_REFLECTION_ROUGHNESS_THRESHOLD, 1e-3, 1.0);
    float threshold_ratio = (1.0 - reflection_threshold)
        / reflection_threshold;
    float reflection_metalness = 1.0 - clamp(
        material.diffuse_weight, 0.0, 1.0);
    float reflection_gate = reflection_smoothness
        - reflection_roughness * threshold_ratio
            * (1.0 - 0.6666 * reflection_metalness);
    float reflection_strength = (1.0 - Pow5(reflection_roughness))
        * sqrt(clamp(reflection_gate, 0.0, 1.0));
    indirect_specular *= reflection_strength;
#if OPAQUE_SSR_DEBUG == 8
    color = indirect_specular;
#else
    color += indirect_specular;
#endif

    // -- Emissive --
    color += albedo * material.emission * OPAQUE_PBR_EMISSION_SCALE;

    out_color = JitterR11G11B10F(color, gl_FragCoord.xy, COLOR_JITTER_SEED);
}
