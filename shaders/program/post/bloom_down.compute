#ifndef BLOOM_SRC_MIP
#define BLOOM_SRC_MIP 1
#endif
#ifndef BLOOM_DST_MIP
#define BLOOM_DST_MIP 2
#endif

#include "/lib/post/bloom.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f) uniform restrict image2D colorimg12;

shared vec4 tile[35][35];

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 full_size = imageSize(colorimg12);
    ivec2 src_origin = GetBloomMipOrigin(full_size, BLOOM_SRC_MIP);
    ivec2 src_size   = GetBloomMipSize(full_size, BLOOM_SRC_MIP);
    ivec2 dst_origin = GetBloomMipOrigin(full_size, BLOOM_DST_MIP);
    ivec2 dst_size   = GetBloomMipSize(full_size, BLOOM_DST_MIP);
    bool valid = all(lessThan(gid, dst_size));

    ivec2 group_base = ivec2(gl_WorkGroupID.xy) * 16;
    ivec2 input_base = src_origin + group_base * 2 - 2;
    ivec2 src_limit  = src_origin + src_size - 1;

    uint idx = gl_LocalInvocationIndex;
    for (uint i = idx; i < 1225u; i += 256u) {
        uint ty = i / 35u;
        uint tx = i % 35u;
        ivec2 coord = clamp(input_base + ivec2(tx, ty), src_origin, src_limit);
        tile[ty][tx] = imageLoad(colorimg12, coord);
    }

    barrier();

    ivec2 tile_center = ivec2(gl_LocalInvocationID.xy) * 2 + 2;

    // Separable 3x3 tent (1/4, 1/2, 1/4) on the 2x2 block centre (see
    // bloom_extract.compute for the low-pass rationale).
    vec4 s_center = tile[tile_center.y + 0][tile_center.x + 0];
    vec4 s_left   = tile[tile_center.y + 0][tile_center.x - 1];
    vec4 s_right  = tile[tile_center.y + 0][tile_center.x + 1];
    vec4 s_up     = tile[tile_center.y - 1][tile_center.x + 0];
    vec4 s_down   = tile[tile_center.y + 1][tile_center.x + 0];
    vec4 s_tl     = tile[tile_center.y - 1][tile_center.x - 1];
    vec4 s_tr     = tile[tile_center.y - 1][tile_center.x + 1];
    vec4 s_bl     = tile[tile_center.y + 1][tile_center.x - 1];
    vec4 s_br     = tile[tile_center.y + 1][tile_center.x + 1];

    vec4 result = vec4(0.0);
    result += s_center * 0.25;
    result += s_left * 0.125;
    result += s_right * 0.125;
    result += s_up * 0.125;
    result += s_down * 0.125;
    result += s_tl * 0.0625;
    result += s_tr * 0.0625;
    result += s_bl * 0.0625;
    result += s_br * 0.0625;

    if (valid) imageStore(colorimg12, dst_origin + gid, result);
}
