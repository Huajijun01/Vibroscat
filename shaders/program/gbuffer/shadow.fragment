// Explicit out variables get no Iris-injected alpha test: USE_DISCARD casters
// apply alphaTestRef here. shadowcolor0 carries the RSM payload; Iris writes
// depth to shadowtex0.

/* RENDERTARGETS: 0 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/material/alpha_test.glsl"
#include "/lib/color/spaces.glsl"
#include "/lib/lighting/brdf.glsl"
#include "/lib/shadow/rsm_data.glsl"
#include "/lib/material/model.glsl"

#if defined(SHADOW_TEXCOORD_ACTIVE)
in vec2 v_texcoord;
#endif
#if defined(SHADOW_RSM_PAYLOAD_ACTIVE)
in vec3 v_color;
in vec3 v_normal_shadow;
#endif

layout(location = 0) out vec4 out_color;

#if defined(PROGRAM_SHADOW_SOLID) || defined(PROGRAM_SHADOW_WATER)
layout(early_fragment_tests) in;
#endif

void main() {
    // shadowcolor0 carries the RSM payload, and its only reader
    // (lib/shadow/reflective_shadow_map.glsl) compiles in only when
    // GI_MODE == 2. Every other configuration needs the atlas fetch for the
    // cutout alpha test alone, so solid and water casters skip both the fetch
    // and the RGBA8 write; shadow.vertex still owns the depth that
    // shadowtex0/shadowtex1 store, and no consumer input changes.
#if defined(SHADOW_TEXCOORD_ACTIVE)
    vec4 albedo = texture(gtexture, v_texcoord);
#endif

#ifdef USE_DISCARD
    DiscardBelowAlphaTest(albedo.a, 0.01);
#endif

#if defined(SHADOW_RSM_PAYLOAD_ACTIVE)
    // Translucent depth in shadowtex0 must never pick up an opaque VPL's payload.
    vec3 tinted_albedo = albedo.rgb * v_color;
#ifdef PROGRAM_SHADOW_ENTITIES
    tinted_albedo = mix(tinted_albedo, entityColor.rgb, entityColor.a);
#endif
    vec3 linear_albedo = ToLinear(tinted_albedo);
    OpaqueMaterial encoded_material = DecodeOpaqueMaterial(texture(specular, v_texcoord));
    PBRMaterial material = ResolveOpaquePBR(linear_albedo, encoded_material.perceptual_roughness,
        encoded_material.specular_selector, encoded_material.emission, encoded_material.auxiliary);
    vec3 normal_shadow = normalize(v_normal_shadow);
    vec3 reflectance = EvaluateDiffuseReflectance(linear_albedo, material.f0, material.diffuse_weight);
    // Back-facing surfaces do not reflect the directional source toward a VPL.
    reflectance *= float(dot(normal_shadow, u_shadow_light_dir) > 0.0);
    out_color = EncodeRSMSource(reflectance, normal_shadow);
#elif defined(PROGRAM_SHADOW_WATER) && GI_MODE == 2
    // GI_MODE == 2 water: the payload stays a constant zero; no material
    // texture is fetched and no user varying crosses the stage.
    out_color = vec4(0.0);
#else
    // No RSM payload consumer: shadowcolor0 stays unwritten.
#endif

    // Depth protection lives in shadow.vertex (clip-z scale); no fragment
    // depth write here (early-Z).
}
