#include "/lib/contract/uniforms.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/noise.glsl"
#include "/lib/atmosphere/atmosphere_geometry.glsl"
#include "/lib/atmosphere/media.glsl"
#include "/lib/atmosphere/sky_lut.glsl"
#include "/lib/atmosphere/sky_radiance.glsl"
#include "/lib/atmosphere/spectral.glsl"

// 8x4 workgroups spread the 128x128 bake over 512 blocks instead of 64, so
// every SM receives work on this small dispatch; 16x16 (64 blocks) measured
// 2-3 us slower.
layout(local_size_x = 8, local_size_y = 4) in;
const ivec3 workGroups = ivec3(16, 32, 1);

layout(rgba16f) uniform writeonly image2D uimg_skylut;

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);


    float phi = (float(id.x) / float(SKY_LUT_W - 1) - 0.5) * PI;
    float y   = float(id.y) + 0.5;
    float theta;

    if (y >= float(SKY_LUT_GND)) {
        float t = (y - float(SKY_LUT_GND)) / float(SKY_LUT_SKY - 1);
        t = t * t;
        t = t * 0.99999 + 0.00001;
        theta = u_sky_lut_horizon_theta + t * (PI * 0.5 - u_sky_lut_horizon_theta);
    } else {
        float t = saturate(1.0 - y / float(SKY_LUT_GND - 1));
        t = t * t;
        t = t * t;
        t = t * 0.99999 + 0.00001;
        theta = u_sky_lut_horizon_theta - t * (PI * 0.5 + u_sky_lut_horizon_theta);
    }

    vec3 view_dir = vec3(cos(theta) * cos(phi), sin(theta), cos(theta) * sin(phi));
    vec4 spectral_radiance = ComputeSkyRadiance(AtmosphereCameraPosition(), view_dir, u_sky_lut_sun_dir);
    vec3 rgb = SpectralToLinearSRGBWhiteBalanced(spectral_radiance) * ATM_EXPOSURE;

    // Static interleaved gradient noise dither - no temporal component to avoid flicker
    float d_noise = InterleavedGradientNoise(vec2(id));
    rgb += (d_noise - 0.5) * max(rgb, 1e-4) / 1024.0;

    imageStore(uimg_skylut, id, vec4(rgb, 1.0));
}
