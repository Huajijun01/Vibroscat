/* RENDERTARGETS: 12,2 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/sky_light_data.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/render_scale.glsl"
#include "/lib/geometry/fragment_position.glsl"
#include "/lib/cloud/shadow.glsl"
#include "/lib/color/spaces.glsl"
#include "/lib/lighting/lightmap.glsl"
#include "/lib/lighting/brdf.glsl"
#include "/lib/material/alpha_test.glsl"
#include "/lib/material/legacy.glsl"

in vec3 v_ambient_col;
in vec3 v_shadow_proj_pos;
in vec4 v_color;
in vec3 v_texcoord;

layout(location = 0) out vec4 out_layer_color;
layout(location = 1) out vec4 out_surface_data;

void main() {
#if defined(TAAU_ACTIVE)
    if (OutsideSceneRender(gl_FragCoord.xy)) discard;
#endif
    vec4 albedo = texture(gtexture, v_texcoord.xy);
    DiscardBelowAlphaTest(albedo.a, 0.001);
    albedo *= v_color;

    vec3 base_color = ToLinear(albedo.rgb);
    // World up expressed in view space: a literal (0,1,0) here would be
    // screen up and flip particle lighting with camera pitch. mat3(M) times
    // the y axis is exactly the second matrix column.
    vec3 surface_normal_view = normalize(gbufferModelView[1].xyz);
    vec3 view_pos = ReconstructGbufferViewPosition(gl_FragCoord);
    vec3 view_to_eye = -normalize(view_pos);
    // Particles carry no PBR data: fixed dielectric defaults, never the
    // specular atlas.
    Material mat = MaterialDefaults(vec4(0.0));
    vec3 direct_lighting;
    vec3 lambert_brdf;
    vec3 diffuse_reflectance;
    // The light direction is the host-built view-space uniform, identical
    // for every primitive in the draw.
    EvaluateBRDF(base_color, mat, surface_normal_view, view_to_eye, u_view_light_dir, direct_lighting, lambert_brdf, diffuse_reflectance);

    float shadow = texture(shadowtex1, v_shadow_proj_pos);
    shadow *= CloudShadowTransmittance(ViewToWorldSpace(view_pos));
    float torch_light = BlockLightFromLm(v_texcoord.z);
    vec3 lit = direct_lighting * ground_light.rgb * shadow + lambert_brdf * v_ambient_col
             + diffuse_reflectance * TORCH_LIGHT_COLOR * torch_light;
    out_layer_color = vec4(lit * albedo.a, albedo.a);
    // Non-water normal/flag: dummy (0,0,1) view normal, water flag 0; the
    // world-up lighting normal is not a gbuffer surface normal.
    out_surface_data = vec4(0.5, 0.5, 1.0, 0.0);
}
