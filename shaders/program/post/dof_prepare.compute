#include "/lib/contract/dof_data.glsl"
#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/post/dof.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
#if defined(TAAU_ACTIVE)
const vec2 workGroupsRender = vec2(TAAU_RENDER_SCALE, TAAU_RENDER_SCALE);
#else
const vec2 workGroupsRender = vec2(1.0, 1.0);
#endif
layout(rgba16f) writeonly uniform image2D colorimg12;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, ivec2(u_render_res)))) return;

    // Previous/current slots stay disjoint in this dispatch; every invocation derives the same focus, only (0,0) publishes.
    int focus_slot = frameCounter & 1;
    float target_inverse_m = DofInverseDepth(texelFetch(depthtex2, ivec2(u_render_res * 0.5), 0).r);
    float previous_inverse_m = dof_focus_inverse_m[focus_slot ^ 1];
    if (frameCounter <= 1) previous_inverse_m = target_inverse_m;
    float focus_inverse_m = mix(target_inverse_m, previous_inverse_m,
        exp2(-frameTime / DOF_FOCUS_HALFLIFE_SECONDS));
    float lens_scale = DOF_LENS_SCALE * DOF_STRENGTH * viewHeight / 1080.0;
    if (all(equal(texel, ivec2(0)))) {
        dof_focus_inverse_m[focus_slot] = focus_inverse_m;
        dof_focus_change_px = abs(focus_inverse_m - previous_inverse_m) * lens_scale;
        dof_focus_frame = uint(frameCounter);
    }
    float inverse_m = DofSceneInverseDepth(texel);
    // Converted once before FP16 storage; leaving the coordinate uncapped preserves source ordering when both disks reach the cap.
    float coc_px = inverse_m < 0.0 ? DOF_HAND_COC : (focus_inverse_m - inverse_m) * lens_scale;
    imageStore(colorimg12, texel, vec4(texelFetch(colortex0, texel, 0).rgb, coc_px));
}
