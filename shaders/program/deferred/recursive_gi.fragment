/* RENDERTARGETS: 9,10 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/noise.glsl"
#include "/lib/core/packing.glsl"
#include "/lib/lighting/ambient_light.glsl"

// Clean adaptation of the supplied CC0/MIT ReferenceGI and Sundial-Lite
// visibility-bitmask method. colortex5 is read-only scene radiance from the
// existing pipeline; this pass owns the colortex9/10 GI temporal history pair.
const int GI_STEPS = 16;
const float GI_LENGTH = 514.0;
const float GI_RADIANCE_LIMIT = 64.0;
const float GI_HISTORY_MAX_FRAMES = 20.0;

layout(location = 0) out vec3 out_gi;
layout(location = 1) out uint out_gi_metadata;


float GIPartialSlice(float x, float sin_view_normal) {
    if (abs(x) >= 1.0 || x == 0.0) return x;
    bool negative = x < 0.0;
    x = abs(x);
    float s = sin_view_normal;
    float o = s - s * s;
    float slope0 = 1.0 / (1.0 + (PI - 1.0) * (s - o * 0.30546));
    float slope1 = 1.0 / (1.0 - (1.0 - exp2(-20.0)) * (s + o * mix(0.5, 0.785, s)));
    float k = mix(0.1, 0.25, s);
    float a = 1.0 - (PI - 2.0) / (PI - 1.0);
    float b = 1.0 / (PI - 1.0);
    float d0 = a - slope0 * b;
    float d1 = 1.0 - slope1;
    float f0 = d0 * (PI * x - (0.5 * PI - FastAcos(x)));
    float f1 = d1 * (x - 1.0);
    float kk = k * k;
    float h0 = sqrt(f0 * f0 + kk) - k;
    float h1 = sqrt(f1 * f1 + kk) - k;
    float hh = (h0 * h1) / max(h0 + h1, 1.0e-6);
    float y = x - sqrt(max(hh * (hh + 2.0 * k), 0.0));
    return negative ? -y : y;
}

vec2 GISampleSliceDirection(vec3 view_space_normal, float random_value) {
    float angle = random_value * TAU;
    vec2 direction = vec2(cos(angle), sin(angle));
    float normal_xy_length = length(view_space_normal.xy);
    if (normal_xy_length > 1.0e-5) {
        vec2 normal_direction = view_space_normal.xy / normal_xy_length;
        direction = Rotate2D(direction, normal_direction * vec2(1.0, -1.0));
        float slice_angle = GIPartialSlice(FastAtan2(direction), normal_xy_length) * PI;
        direction = Rotate2D(vec2(cos(slice_angle), sin(slice_angle)), normal_direction);
    }
    return direction;
}

vec4 GIQuaternionFromViewDirection(vec3 view_direction) {
    vec3 xyz = vec3(view_direction.y, -view_direction.x, 0.0);
    float scalar = -view_direction.z;
    float inverse_scale = inversesqrt(max(scalar * 0.5 + 0.5, 0.0));
    return vec4(xyz * inverse_scale * 0.5, 1.0 / inverse_scale);
}

vec3 GIRotateVectorByQuaternion(vec3 value, vec4 quaternion) {
    float cross_term = value.y * quaternion.x - value.x * quaternion.y;
    float scale = 2.0 * (value.z * quaternion.w + cross_term);
    vec3 result;
    result.xy = value.xy + quaternion.yx * vec2(scale, -scale);
    result.z = value.z + 2.0 * (quaternion.w * cross_term
        - value.z * dot(quaternion.xy, quaternion.xy));
    return result;
}

vec3 GIRotateSliceDirectionByQuaternion(vec2 slice_direction, vec4 quaternion) {
    float offset = quaternion.x * slice_direction.y;
    float cross_term = quaternion.y * slice_direction.x;
    vec3 basis = vec3(offset - cross_term, -offset + cross_term, offset - cross_term);
    return vec3(slice_direction, 0.0) + 2.0 * (basis * quaternion.yxw);
}

uint GIVisibilityMaskFromRange(float range_start, float range_end) {
    uvec2 horizontal_int = (uvec2(floatBitsToUint(range_start), floatBitsToUint(range_end))
        >> 17u) & 0x3Fu;
    uint start_bit = horizontal_int.x;
    uint end_bit = horizontal_int.y;
    uint left = start_bit < 32u ? 0xFFFFFFFFu << start_bit : 0u;
    uint right = end_bit != 0u ? 0xFFFFFFFFu >> (32u - end_bit) : 0u;
    return left & right;
}

float GITraceScreenEdge(vec4 origin_projection, vec4 projected_direction, float far_plane) {
    vec2 t1 = (vec2(1.0) * origin_projection.w - origin_projection.xy)
        / (projected_direction.xy - vec2(1.0) * projected_direction.w);
    vec2 t2 = (vec2(-1.0) * origin_projection.w - origin_projection.xy)
        / (projected_direction.xy - vec2(-1.0) * projected_direction.w);
    float edge = far_plane + 32.0;
    if (t1.x > 0.0) edge = min(edge, t1.x);
    if (t1.y > 0.0) edge = min(edge, t1.y);
    if (t2.x > 0.0) edge = min(edge, t2.x);
    if (t2.y > 0.0) edge = min(edge, t2.y);
    return edge;
}


vec3 GITrace(vec3 origin_view_position, vec3 origin_normal_view, out float coverage) {
    vec3 view_direction = -normalize(origin_view_position);
    vec4 q_to_view = GIQuaternionFromViewDirection(view_direction);
    vec4 q_from_view = q_to_view * vec4(vec3(-1.0), 1.0);
    vec3 normal_vvs = GIRotateVectorByQuaternion(origin_normal_view, q_from_view);
    vec2 noise = vec2(
        SampleSTBN(ivec2(gl_FragCoord.xy), frameCounter),
        SampleSTBN(ivec2(gl_FragCoord.xy), frameCounter + 32));
    noise = fract(noise + vec2(0.7548776662, 0.7548776662 * 0.7548776662)
        * float(frameCounter & 63));
    vec2 slice_direction = GISampleSliceDirection(normal_vvs, noise.x);
    vec3 ray_direction = GIRotateSliceDirectionByQuaternion(slice_direction, q_to_view);

    vec3 projection_diag = vec3(gbufferProjection[0].x, gbufferProjection[1].y, gbufferProjection[2].z);
    vec4 origin_proj = vec4(projection_diag * origin_view_position + gbufferProjection[3].xyz, -origin_view_position.z);
#ifdef TAA
    origin_proj.xy += u_taa_offset * origin_proj.w;
#endif
    vec4 projected_direction = vec4(projection_diag * ray_direction, -ray_direction.z);
    projected_direction.xy += gbufferProjection[2].xy * ray_direction.z;
    float trace_length = GITraceScreenEdge(origin_proj, projected_direction, far);
    vec2 origin_coord = origin_proj.xy * (0.5 / origin_proj.w) + 0.5;
    vec4 target_proj = origin_proj + projected_direction * trace_length;
    vec2 target_coord = target_proj.xy / target_proj.w * 0.5 + 0.5;
    vec2 sample_range = (target_coord - origin_coord) * u_screen_res;
    float inv_range = inversesqrt(dot(sample_range, sample_range));
    vec2 step_dir = sample_range * inv_range * u_view_pixel_size;
    float step_scale_log = log2(max(1.0 / GI_LENGTH, clamp(inv_range, 0.0, 1.0))) / -float(GI_STEPS);
    float step_scale = exp2(step_scale_log);
    float step_size = exp2(step_scale_log * noise.y);

    vec3 slice_normal = cross(view_direction, ray_direction);
    vec3 projected_normal = origin_normal_view - slice_normal * dot(origin_normal_view, slice_normal);
    float projected_normal_len = length(projected_normal);
    if (projected_normal_len < 1.0e-5) { coverage = 0.0; return vec3(0.0); }
    projected_normal *= inversesqrt(dot(projected_normal, projected_normal));
    vec3 tangent = cross(slice_normal, projected_normal);
    float cos_normal = dot(projected_normal, view_direction);
    float angle_normal = (dot(view_direction, tangent) < 0.0 ? -1.0 : 1.0) * FastAcos(cos_normal);
    float sin_normal = sin(angle_normal);
    float denom = cos_normal + angle_normal * sin_normal;
    float w0 = clamp((sin_normal / denom) * (PI * 0.25) + 0.5, 0.0, 1.0);
    float t1 = 0.25 / denom;
    float t01 = (3.0 * cos_normal + (4.0 * angle_normal + PI) * sin_normal) * t1;
    float remap_mul = 32.0 / (1.0 - w0);
    float remap_add = -w0 * remap_mul + 64.0;
    remap_add += remap_mul * t01;
    remap_mul *= t1;

    uint occupied = 0u;
    vec3 gi = vec3(0.0);
    float hit_coverage = 0.0;
    for (int i = 0; i < GI_STEPS; ++i) {
        vec2 sample_uv = origin_coord + step_dir * step_size;
        step_size *= step_scale;
        if (any(lessThan(sample_uv, vec2(0.0))) || any(greaterThanEqual(sample_uv, vec2(1.0)))) break;
        float sample_depth = texture(depthtex0, sample_uv).r;
        if (sample_depth >= 1.0) continue;
        vec3 sample_view = vec3(sample_uv * 2.0 - 1.0, 1.0);
#ifdef TAA
        sample_view.xy -= u_taa_offset;
#endif
        sample_view.xy = vec2(gbufferProjectionInverse[0].x, gbufferProjectionInverse[1].y)
            * sample_view.xy + gbufferProjectionInverse[3].xy;
        sample_view.z = gbufferProjectionInverse[3].z;
        sample_view /= gbufferProjectionInverse[2].w * (sample_depth * 2.0 - 1.0)
            + gbufferProjectionInverse[3].w;
        vec3 delta_front = sample_view - origin_view_position;
        // Sundial's non-hand geometry thickness term: clamp the projected
        // footprint before taking the reciprocal square root so distant
        // surfaces retain the intended 0.1 m angular interval.
        vec3 delta_back = delta_front + sample_view
            * inversesqrt(clamp(dot(sample_view, sample_view) * 0.25, 0.0, 1.0))
            * 0.1;
        float front_cos = dot(delta_front, view_direction) * inversesqrt(max(dot(delta_front, delta_front), 1.0e-6));
        float back_cos = dot(delta_back, view_direction) * inversesqrt(max(dot(delta_back, delta_back), 1.0e-6));
        vec2 horizontal = vec2(FastAcos(front_cos), FastAcos(back_cos));
        vec2 horizontal01 = clamp((horizontal + angle_normal) / PI + 0.5, 0.0, 1.0);
        vec2 phi = horizontal01 * TAU - PI;
        horizontal01 = -cos(angle_normal - phi) - phi * sin_normal;
        horizontal01 = horizontal01 * remap_mul + remap_add;
        uint sample_mask = GIVisibilityMaskFromRange(horizontal01.x, horizontal01.y);
        uint visible = sample_mask & (~occupied);
        if (visible != 0u) {
            vec2 previous_uv = ToPrevious(vec3(sample_uv, sample_depth)).xy;
            if (all(greaterThanEqual(previous_uv, vec2(0.0)))
                    && all(lessThan(previous_uv, vec2(1.0)))) {
                float visible_weight = float(bitCount(visible)) * (1.0 / 32.0);
                // The visibility mask estimates a normalized cosine-weighted
                // hemisphere average (E / PI). Store irradiance so deferred4
                // consumes it with the same unit as AmbientLight().
                gi += texture(colortex5, previous_uv).rgb
                    * visible_weight * PI;
                hit_coverage += visible_weight;
            }
        }
        occupied |= sample_mask;
        if (occupied == 0xFFFFFFFFu) break;
    }
    coverage = clamp(hit_coverage, 0.0, 1.0);
    return gi;
}

#ifdef GI_TEMPORAL_DENOISE
vec3 GITemporalFilter(
    vec2 uv,
    float depth,
    vec3 normal_view,
    vec3 raw_gi,
    out float new_history_age
) {
    vec3 previous_screen = ToPrevious(vec3(uv, depth));

    bool reprojection_valid = frameCounter > 0
        && all(greaterThanEqual(previous_screen.xy, vec2(0.0)))
        && all(lessThan(previous_screen.xy, vec2(1.0)))
        && length(cameraPosition - previousCameraPosition) <= 8.0;
    if (!reprojection_valid) {
        new_history_age = 1.0;
        return raw_gi;
    }

    vec3 previous_view_position = PreviousScreenToView(previous_screen);
    vec3 world_normal = normalize(mat3(gbufferModelViewInverse) * normal_view);
    vec3 previous_normal_view = normalize(mat3(gbufferPreviousModelView) * world_normal);
    vec2 history_texel = previous_screen.xy * u_screen_res - 0.5;
    ivec2 history_base = ivec2(floor(history_texel));
    vec2 history_fraction = fract(history_texel);
    ivec2 history_size = ivec2(u_screen_res);
    vec3 history_gi_sum = vec3(0.0);
    float history_gi_weight_sum = 0.0;
    float history_age_sum = 0.0;
    float history_sample_weight_sum = 0.0;

    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            ivec2 history_tx = history_base + ivec2(x, y);
            if (any(lessThan(history_tx, ivec2(0)))
                    || any(greaterThanEqual(history_tx, history_size))) continue;

            vec2 axis_weight = mix(vec2(1.0) - history_fraction, history_fraction,
                vec2(float(x), float(y)));
            float sample_weight = axis_weight.x * axis_weight.y;
            vec3 history = texelFetch(colortex9, history_tx, 0).rgb;
            uint history_metadata = texelFetch(colortex10, history_tx, 0).r;
            float history_reverse_depth = float(history_metadata & 0xFFFFFFu)
                * (1.0 / 16777215.0);
            float history_screen_depth = 1.0 - history_reverse_depth;
            vec3 history_view_position = PreviousScreenToView(
                vec3((vec2(history_tx) + 0.5) * u_view_pixel_size, history_screen_depth));
            vec3 position_difference = history_view_position - previous_view_position;
            float position_distance = abs(dot(position_difference, previous_normal_view))
                / (dot(history_view_position, history_view_position) + 2.0) * 5000.0;
            float position_weight = clamp(1.0 - position_distance, 0.0, 1.0);
            float history_age = min(float(history_metadata >> 24u), GI_HISTORY_MAX_FRAMES);
            vec3 reprojected_normal_view = DecodeOctahedralNormal(
                texelFetch(colortex4, history_tx, 0).xy);
            bool radiance_valid = !any(isnan(history))
                && !any(isinf(history))
                && all(greaterThanEqual(history, vec3(0.0)))
                && all(lessThanEqual(history, vec3(GI_RADIANCE_LIMIT)));
            bool sample_valid = history_reverse_depth > 0.0
                && history_age >= 1.0
                && radiance_valid
                && position_weight > 0.0
                && dot(normal_view, reprojected_normal_view) >= 0.866;
            if (!sample_valid) continue;

            sample_weight *= position_weight;
            float age_weight = sample_weight * history_age;
            history_gi_sum += history * age_weight;
            history_gi_weight_sum += age_weight;
            history_age_sum += history_age * sample_weight;
            history_sample_weight_sum += sample_weight;
        }
    }

    if (history_gi_weight_sum <= 0.0 || history_sample_weight_sum <= 0.0) {
        new_history_age = 1.0;
        return raw_gi;
    }

    vec3 history_gi = history_gi_sum / history_gi_weight_sum;
    float history_age = history_age_sum / history_sample_weight_sum;
    float current_weight = 1.0 / (history_age + 1.0);
    new_history_age = min(history_age + 1.0, GI_HISTORY_MAX_FRAMES + 1.0);
    return mix(history_gi, raw_gi, current_weight);
}
#endif

void main() {
    ivec2 tx = ivec2(gl_FragCoord.xy);
    vec2 uv = (vec2(tx) + 0.5) * u_view_pixel_size;
    float depth = texelFetch(depthtex0, tx, 0).r;
    if (depth >= 1.0) {
        out_gi = vec3(0.0);
        out_gi_metadata = 0u;
        return;
    }
    vec4 geometry_data = texelFetch(colortex4, tx, 0);
    vec3 normal_view = DecodeOctahedralNormal(geometry_data.xy);
    vec3 view_position = SceneToViewSpace(DepthToWorldPos(uv, depth));
    vec3 raw_gi;
    float coverage;
    raw_gi = GITrace(view_position + normal_view * 0.003, normal_view, coverage);
    vec3 fallback_normal = normalize(mat3(gbufferModelViewInverse) * normal_view);
    vec3 fallback = AmbientLight(fallback_normal, vec3(1.0), geometry_data.w);
    float miss_fraction = 1.0 - coverage;
    raw_gi += fallback * miss_fraction;
    raw_gi = clamp(raw_gi, vec3(0.0), vec3(GI_RADIANCE_LIMIT));
#ifdef GI_TEMPORAL_DENOISE
    float history_age;
    vec3 filtered_gi = GITemporalFilter(uv, depth, normal_view, raw_gi, history_age);
    out_gi = filtered_gi;
#else
    float history_age = 1.0;
    out_gi = raw_gi;
#endif
    float reverse_depth = 1.0 - depth;
    uint depth_bits = uint(round(reverse_depth * 16777215.0));
    uint age_bits = uint(round(clamp(history_age, 0.0, 255.0)));
    out_gi_metadata = (age_bits << 24u) | depth_bits;
}
