#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/noise.glsl"
#include "/lib/atmosphere/atmosphere_geometry.glsl"
#include "/lib/atmosphere/celestial.glsl"
#include "/lib/atmosphere/sky_lut.glsl"
#include "/lib/atmosphere/skybox_uv.glsl"
#include "/lib/atmosphere/transmittance.glsl"
// The skybox feeds the L0-L2 SH probe and the reflection fallbacks (fine detail
// averaged away), so it bakes with a reduced march budget; the screen pass keeps
// the settings-level budgets.
#define CLOUD_SKYBOX_VIEW_STEPS 48
#define CLOUD_SKYBOX_MIN_STEPS 16
#define CLOUD_SKYBOX_LIGHT_STEPS 2
#undef CLOUD_VIEW_MAX_STEPS
#define CLOUD_VIEW_MAX_STEPS CLOUD_SKYBOX_VIEW_STEPS
#undef CLOUD_VIEW_MIN_STEPS
#define CLOUD_VIEW_MIN_STEPS CLOUD_SKYBOX_MIN_STEPS
#undef CLOUD_LIGHT_STEPS
#define CLOUD_LIGHT_STEPS CLOUD_SKYBOX_LIGHT_STEPS
#include "/lib/cloud/composite.glsl"
#include "/lib/cloud/volumetric.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
const ivec3 workGroups = ivec3(16, 16, 1);

layout(rgba16f) uniform image2D uimg_sky_radiance;

// Fixed-ratio EMA per texel refresh: one texel per cell per 4-frame cycle,
// so the SH probe converges smoothly without re-baking every frame.
const float CLOUD_SKYBOX_HISTORY_ALPHA = 0.25;

// 2x2 checkerboard refresh order (same coarse-to-fine order as the screen
// pass); 128x128 cells, one phase-matched texel re-marched per frame.
// The offset for phase k is ((k>>1)^(k&1), k&1) = (0,0),(1,1),(1,0),(0,1);
// it is computed instead of a const ivec2[4] table because both readers
// index at runtime and this driver lowers such tables into thread-local
// memory.
ivec2 SkyboxCheckerboardOffset(int phase) {
    return ivec2((phase >> 1) ^ (phase & 1), phase & 1);
}

void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(cell, ivec2(SKY_RADIANCE_LUT_SIZE / 2)))) return;

    uint phase_index = uint(frameCounter) % 4u;
    ivec2 phase_offset = SkyboxCheckerboardOffset(int(phase_index));
    bool full_init = (frameCounter == 0);
    // The skybox clock advances one STBN slice per 4-frame checkerboard cycle.
#ifdef VOLUMETRIC_CLOUDS
    int cloud_frame = frameCounter / 4;
#endif
#ifdef VOLUMETRIC_CLOUDS
    vec3 camera_atmosphere_pos = AtmosphereCameraPosition();
#endif

    for (int i = 0; i < 4; ++i) {
        ivec2 offset = SkyboxCheckerboardOffset(i);
        if (!full_init && any(notEqual(offset, phase_offset))) continue;

        // Equal-area cylindrical mapping at the texel center: u = azimuth,
        // v = sin(elevation) (constant solid angle 4pi/N2, no per-pixel
        // Jacobian for SH). World-aligned: +X at u = 0.5, zenith at v = 1.
        ivec2 texel = cell * 2 + offset;
        // Hoisted before the march: this history read's address is known
        // here, and loading it after the cloud march left the fetch exposed
        // in the epilogue (backend placement cliff; same rule as gtao.glsl's
        // sky_l2_blocked).
        vec4 previous = imageLoad(uimg_sky_radiance, texel);
        float mu = 2.0 * (float(texel.y) + 0.5) / float(SKY_RADIANCE_LUT_SIZE) - 1.0;
        float cos_theta = sqrt(saturate(1.0 - mu * mu));
        float phi = (float(texel.x) + 0.5) / float(SKY_RADIANCE_LUT_SIZE) * TAU - PI;
        vec3 view_dir = vec3(cos_theta * cos(phi), mu, cos_theta * sin(phi));

        vec3 sky_color = texture(usam_skylut, SkyLUTUV(
            view_dir,
            u_world_sun_dir,
            ATM_PLANET_R,
            u_cam_altitude
        )).rgb;

        vec4 cloud_view_transmittance = vec4(1.0);
        bool cloud_view_transmittance_cached = false;

        vec3 cloud_data = vec3(0.0, 0.0, 1.0);
        vec3 surface_position = vec3(0.0);
        float cloud_entry = 1.0e9;
        vec3 cloud_transmittance = vec3(1.0);
#ifdef VOLUMETRIC_CLOUDS
        float cloud_exit = 0.0;
        bool cloud_visible = CloudShellInterval(
            camera_atmosphere_pos,
            view_dir,
            cloud_entry,
            cloud_exit
        );
        if (cloud_visible) {
            int step_count = clamp(int(ceil((cloud_exit - cloud_entry) / CLOUD_VIEW_TARGET_STEP_KM)),
                min(CLOUD_VIEW_MIN_STEPS, CLOUD_VIEW_MAX_STEPS),
                max(CLOUD_VIEW_MIN_STEPS, CLOUD_VIEW_MAX_STEPS));
            bool hit;
            cloud_data = MarchVolumetricClouds(
                camera_atmosphere_pos,
                view_dir,
                vec2(SampleSTBN(texel, cloud_frame), SampleSTBN(texel, cloud_frame + STBN_STREAM_3)),
                cloud_entry,
                cloud_exit,
                step_count,
                surface_position,
                hit
            );
        } else {
            cloud_entry = 1.0e9;
        }
#endif
#if defined(VOLUMETRIC_CLOUDS) || defined(CIRRUS)
        sky_color = RenderCloudLayers(
            view_dir,
            sky_color,
            cloud_data,
            surface_position,
            cloud_entry,
            cloud_transmittance,
            cloud_view_transmittance,
            cloud_view_transmittance_cached
        );
#endif
        // Match the screen: cloud fill receives only clear sky. Add the
        // background galaxy afterwards, attenuated once by the real cloud T.
        if (u_star_night_fade > 0.0 && !all(equal(cloud_transmittance, vec3(0.0)))) {
            CelestialContext celestial_context = CelestialContextFor(view_dir);
            if (!celestial_context.horizon_occluded) {
                if (!cloud_view_transmittance_cached) {
                    cloud_view_transmittance = SampleTransmittance(utex_tslut,
                        u_camera_radius_km, u_camera_radius_sq, view_dir.y);
                }
                sky_color += RenderMilkyWayGlow(view_dir, cloud_view_transmittance,
                    celestial_context) * cloud_transmittance;
            }
        }
        // Fixed-ratio history blend; the first write (fresh start/reload)
        // replaces unconditionally. `previous` was loaded before the march.
        vec3 fresh = sky_color;
        if (texel.x == SKY_RADIANCE_LUT_SIZE - 1 && !full_init) {
            // Manual repeat for the clamped image: the rightmost column
            // copies column 0 (continuous azimuth seam). Safe here: only
            // phases writing odd x texels read it (even columns unwritten
            // this frame).
            fresh = imageLoad(
                uimg_sky_radiance,
                ivec2(0, texel.y)
            ).rgb;
        }
        float alpha = (full_init || previous.a < 0.5)
            ? 1.0
            : CLOUD_SKYBOX_HISTORY_ALPHA;
        imageStore(
            uimg_sky_radiance,
            texel,
            vec4(mix(previous.rgb, fresh, alpha), 1.0)
        );
    }
}
