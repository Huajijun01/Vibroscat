/* RENDERTARGETS: 3,11 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/packing.glsl"

const int FILTER_TAPS = 9;
const vec2 FILTER_OFFSETS[FILTER_TAPS] = vec2[](
    vec2(0.0),
    vec2(1.0, 0.0),
    vec2(-1.0, 0.0),
    vec2(0.0, 1.0),
    vec2(0.0, -1.0),
    vec2(0.7071, 0.7071),
    vec2(-0.7071, 0.7071),
    vec2(0.7071, -0.7071),
    vec2(-0.7071, -0.7071));

layout(location = 0) out vec3 out_reflection_radiance;
layout(location = 1) out vec2 out_reflection_metadata;

vec3 FilterShadingNormal(ivec2 tx) {
    vec4 packed = texelFetch(colortex2, tx, 0);
    vec2 nx_ao = Unpack2x8(packed.r);
    vec2 ny_nz = Unpack2x8(packed.g);
    return normalize(vec3(
        nx_ao.x * 2.0 - 1.0,
        ny_nz.x * 2.0 - 1.0,
        ny_nz.y * 2.0 - 1.0));
}

float FilterPerceptualRoughness(ivec2 tx) {
    return Unpack2x8(texelFetch(colortex2, tx, 0).b).x;
}

vec3 FilterGeometricNormal(ivec2 tx) {
    return DecodeOctahedralNormal(texelFetch(colortex4, tx, 0).xy);
}

void main() {
    ivec2 tx = ivec2(gl_FragCoord.xy);
    vec3 center_radiance = texelFetch(colortex3, tx, 0).rgb;
    vec2 center_metadata = texelFetch(colortex11, tx, 0).rg;
    float center_distance = max(center_metadata.x, 0.0);
    float center_confidence = clamp(center_metadata.y, 0.0, 1.0);

    float center_depth = texelFetch(depthtex1, tx, 0).r;
    if (center_depth >= 1.0 || center_confidence <= 0.0) {
        out_reflection_radiance = center_radiance;
        out_reflection_metadata = vec2(center_distance, center_confidence);
        return;
    }

    float center_roughness = FilterPerceptualRoughness(tx);
    float radius = center_roughness < 0.08
        ? 0.0
        : center_roughness * center_roughness
            * (1.0 + 0.75 * sqrt(center_distance));
    radius = min(radius, OPAQUE_SSR_FILTER_RADIUS);
    if (radius < 0.25) {
        out_reflection_radiance = center_radiance;
        out_reflection_metadata = vec2(center_distance, center_confidence);
        return;
    }

    ivec2 texture_size = textureSize(colortex3, 0);
    float center_linear_depth = LinearDepthFromScreenDepth(center_depth);
    vec3 center_geo_normal = FilterGeometricNormal(tx);
    vec3 center_shading_normal = FilterShadingNormal(tx);

    vec3 radiance_sum = vec3(0.0);
    float distance_sum = 0.0;
    float confidence_sum = 0.0;
    float radiance_weight = 0.0;
    float geometry_weight = 0.0;

    for (int i = 0; i < FILTER_TAPS; ++i) {
        ivec2 offset = ivec2(round(FILTER_OFFSETS[i] * radius));
        ivec2 sample_tx = clamp(tx + offset, ivec2(0), texture_size - 1);
        float sample_depth = texelFetch(depthtex1, sample_tx, 0).r;
        if (sample_depth >= 1.0) continue;

        vec2 sample_metadata = texelFetch(colortex11, sample_tx, 0).rg;
        float sample_distance = max(sample_metadata.x, 0.0);
        float confidence = clamp(sample_metadata.y, 0.0, 1.0);
        float sample_linear_depth = LinearDepthFromScreenDepth(sample_depth);
        float sample_roughness = FilterPerceptualRoughness(sample_tx);
        vec3 sample_geo_normal = FilterGeometricNormal(sample_tx);
        vec3 sample_shading_normal = FilterShadingNormal(sample_tx);

        float spatial_weight = exp(
            -1.25 * dot(FILTER_OFFSETS[i], FILTER_OFFSETS[i]));
        float depth_scale = max(0.05, 0.01 * center_linear_depth);
        float depth_weight = exp(
            -abs(sample_linear_depth - center_linear_depth) / depth_scale);
        float geo_similarity = max(
            dot(center_geo_normal, sample_geo_normal), 0.0);
        float shading_similarity = max(
            dot(center_shading_normal, sample_shading_normal), 0.0);
        float normal_weight = pow(geo_similarity, 48.0)
            * pow(shading_similarity, 16.0);
        float roughness_weight = exp(
            -24.0 * abs(sample_roughness - center_roughness));
        float distance_scale = max(0.5, 0.25 * center_distance);
        float distance_weight = exp(
            -abs(sample_distance - center_distance) / distance_scale);
        float compatible_weight = spatial_weight * depth_weight
            * normal_weight * roughness_weight * distance_weight;
        float source_weight = compatible_weight * confidence;
        vec3 sample_radiance = texelFetch(colortex3, sample_tx, 0).rgb;
        if (any(isnan(sample_radiance)) || any(isinf(sample_radiance))) {
            continue;
        }

        radiance_sum += max(sample_radiance, vec3(0.0)) * source_weight;
        distance_sum += sample_distance * source_weight;
        confidence_sum += confidence * compatible_weight;
        radiance_weight += source_weight;
        geometry_weight += compatible_weight;
    }

    if (radiance_weight > 1e-5) {
        out_reflection_radiance = radiance_sum / radiance_weight;
        out_reflection_metadata = vec2(
            distance_sum / radiance_weight,
            clamp(confidence_sum / max(geometry_weight, 1e-5), 0.0, 1.0));
    } else {
        out_reflection_radiance = vec3(0.0);
        out_reflection_metadata = vec2(center_distance, 0.0);
    }
}
