/* RENDERTARGETS: 12,2,1 */

// -- Water shading switches --
// Skip SSR for skyward reflections (view-space z > 0).
#define WATER_SSR_SKY_SKIP 1

#include "/lib/contract/settings.glsl"
#include "/lib/contract/sky_light_data.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/noise.glsl"
#include "/lib/core/render_scale.glsl"
#include "/lib/geometry/fragment_position.glsl"
#include "/lib/atmosphere/skybox_uv.glsl"
#include "/lib/color/spaces.glsl"
#include "/lib/lighting/lightmap.glsl"
#include "/lib/lighting/brdf.glsl"
#include "/lib/material/translucent_surface.glsl"
#include "/lib/raytrace/ssr.glsl"
#include "/lib/shadow/filter.glsl"
#include "/lib/water/fog.glsl"
#include "/lib/water/ocean.glsl"
#include "/lib/water/rain_ripples.glsl"
#include "/lib/water/river_texture.glsl"

#if defined(PROGRAM_GBUFFERS_WATER)
flat in int v_surface_flags;
#endif
flat in vec3 v_normal;
#if defined(WATER_SURFACE_TANGENT_ACTIVE)
flat in vec3 v_world_tangent;
#endif
in vec3 v_ambient_col;
in vec3 v_shadow_proj_pos;
in vec3 v_color;
in vec4 v_texcoord;

layout(location = 0) out vec4 out_layer_color;
layout(location = 1) out vec4 out_surface_data;
layout(location = 2) out vec4 out_surface_high;

#if defined(PROGRAM_GBUFFERS_WATER)
vec3 WaterFogCol(vec3 view_pos) {
    vec3 world_view_dir = normalize(mat3(gbufferModelViewInverse) * normalize(view_pos));
    return FastWaterFogRadiance(ground_light.rgb, v_ambient_col,
        dot(world_view_dir, u_world_light_dir));
}
#endif

void main() {
#if defined(TAAU_ACTIVE)
    if (OutsideSceneRender(gl_FragCoord.xy)) discard;
#endif
    // The surface position crosses the stage nowhere: every view-direction
    // consumer below uses this reconstruction from the window coordinates.
    vec3 view_pos = ReconstructGbufferViewPosition(gl_FragCoord);
    vec4 diffuse = texture(gtexture, v_texcoord.xy);

    diffuse.rgb *= v_color.rgb;
    diffuse.rgb = ToLinear(diffuse.rgb);

#if defined(PROGRAM_GBUFFERS_WATER)
    bool is_water = (v_surface_flags & 1) != 0;
    bool is_glass = (v_surface_flags & 2) != 0;
    // Non-glass/non-water translucent objects (slime, honey, ...) shade inline
    // with the full direct BRDF: no SSR/Fresnel/water data.
    if (!is_water && !is_glass) {
#endif
        if (diffuse.a < 0.01) discard;
        // Same BRDF configuration as deferred4 (shared BRDF helper).
        vec3 surface_normal_view = normalize(v_normal);
        vec3 view_to_eye = -normalize(view_pos);
        vec3 direct_lighting;
        vec3 lambert_brdf;
        vec3 diffuse_reflectance;
        EvaluateBRDF(diffuse.rgb, v_texcoord.xy, surface_normal_view, view_to_eye, u_view_light_dir, direct_lighting, lambert_brdf, diffuse_reflectance);
        float shadow = Shadow2DFastBspline(shadowtex1, v_shadow_proj_pos, real_shadow_map_resolution,
            (1.0 / real_shadow_map_resolution));
        float torch_light = BlockLightFromLm(v_texcoord.z);
        vec3 lit = direct_lighting * ground_light.rgb * shadow + lambert_brdf * v_ambient_col
                 + diffuse_reflectance * TORCH_LIGHT_COLOR * torch_light;
        out_layer_color = vec4(lit * diffuse.a, diffuse.a);
        PackTranslucentSurface(v_normal * 0.5 + 0.5, 0.0, out_surface_data, out_surface_high);
        return;
#if defined(PROGRAM_GBUFFERS_WATER)
    }

    vec3 surface_normal = vec3(0.0, 0.0, 1.0);
    vec3 current_normal = v_normal;
    // Flat geometry normal in world space: owns the vertical-face wave
    // domain below and the refraction perturbation stored for blend. Only
    // the water branch consumes it, so non-water translucent geometry never
    // pays the transform.
    vec3 geo_n_world = vec3(0.0);
    if (is_water) {
        geo_n_world = normalize(mat3(gbufferModelViewInverse) * v_normal);
#if WATER_NORMAL_ENABLED
        // Water surface field (ocean.glsl: river texture basis); normal at
        // the parallax-corrected position, shared by lighting, reflections,
        // and refraction. Horizontal faces keep the POM path over absolute
        // XZ; vertical faces re-parameterize the same wave field on the face
        // plane through the geometry TBN (no POM: its march displaces along
        // world vertical). The world position exists only while the wave
        // field consumes it; every other consumer stays in view space.
#if defined(WATER_SURFACE_POSITION_ACTIVE)
        vec3 world_pos = ViewToWorldSpace(view_pos);
#endif
        vec3 world_n;
        if (abs(geo_n_world.y) > WATER_HORIZONTAL_FACE_MIN_Y) {
#ifdef WATER_POM
            OceanSurfacePOM((world_pos + cameraPosition).xz, normalize(world_pos), frameTimeCounter, world_n);
#else
            OceanFlatNormal((world_pos + cameraPosition).xz, frameTimeCounter, world_n);
#endif
        } else {
#if defined(WATER_SURFACE_TANGENT_ACTIVE)
            // Same handed bitangent the vertex stage used to carry: the flat
            // tangent plus the flags' handedness bit reproduce it here, only
            // on the side-face path that consumes it.
            float tangent_handedness = (v_surface_flags & 4) != 0 ? -1.0 : 1.0;
            vec3 normal_world = mat3(gbufferModelViewInverse) * v_normal;
            vec3 world_bitangent = cross(v_world_tangent, normal_world) * tangent_handedness;
            vec3 face_absolute_pos = world_pos + cameraPosition;
            vec3 ts_n;
            vec2 face_wave_pos = vec2(dot(face_absolute_pos, v_world_tangent), dot(face_absolute_pos, world_bitangent));
            RiverTextureNormal(RiverTextureWarpPosition(face_wave_pos), frameTimeCounter, ts_n);
            world_n = normalize(mat3(v_world_tangent, geo_n_world, world_bitangent) * ts_n);
#else
            world_n = geo_n_world; // no tangent attribute: flat side face
#endif
        }
#if defined(WORLD_OVERWORLD) && defined(RAIN_WETNESS) && defined(RAIN_RIPPLES)
        // Add world-space slopes before the existing underwater inversion,
        // grazing clamp, SSR, glint and refraction all consume the normal.
        if (u_rain_weight > 0.001 && RAIN_RIPPLE_STRENGTH > 0.0
                && geo_n_world.y > WATER_HORIZONTAL_FACE_MIN_Y) {
            // v_texcoord.w arrives normalized from the vertex stage.
            float ripple_weight = u_rain_weight * RAIN_RIPPLE_STRENGTH
                * smoothstep(15.0 / 16.0, 1.0, v_texcoord.w);
            if (ripple_weight > 0.001) {
                vec2 slope = SampleRainRippleSlope(world_pos.xz) * ripple_weight;
                world_n = normalize(world_n + vec3(slope.x, 0.0, slope.y) * world_n.y);
            }
        }
#endif
        surface_normal = vec3(world_n.x, world_n.z, world_n.y);
        current_normal = normalize(mat3(gbufferModelView) * world_n);
#endif
        if (isEyeInWater == 1) {
            // Viewed from below the visible side has the inverted normal
            // (refraction tilt + Snell-window alpha depend on it).
            surface_normal = -surface_normal;
            current_normal = -current_normal;
        }
    }

    // Shared by the normal clamp below, the water branch, and the ray trace.
    vec3 view_dir = normalize(view_pos);
    current_normal = normalize(mix(current_normal, v_normal, (1.0 - Pow4(dot(-view_dir, v_normal))) * 0.7));

    if (is_water) {
        vec3 to_camera = -view_dir;
        current_normal = SoftClampWaterNormal(current_normal, to_camera);
        vec3 world_n_clamped = normalize(mat3(gbufferModelViewInverse) * current_normal);
        // Refraction perturbation stored for blend: the clamped normal minus
        // the flat-surface reference in the wave field's frame: world up
        // for horizontal faces (either side: the up-frame wave normal and
        // its underwater negation both referenced +up), the face normal
        // itself for vertical faces. Flat faces give no offset.
        vec3 flat_ref = abs(geo_n_world.y) > WATER_HORIZONTAL_FACE_MIN_Y
            ? vec3(0.0, sign(geo_n_world.y), 0.0)
            : geo_n_world;
        vec3 world_delta = world_n_clamped - flat_ref;
        surface_normal = vec3(world_delta.x, world_delta.z, world_delta.y);
    }

    // STBN dither for the translucent ray trace: spatial blue noise; the
    // time slice stays 0 without TAA (no temporal accumulation).
#ifdef TAA
    float dither = SampleSTBN(ivec2(gl_FragCoord.xy), STBNFrame());
#else
    float dither = SampleSTBN(ivec2(gl_FragCoord.xy), 0);
#endif

    vec2 screen_texcoord = gl_FragCoord.xy * u_render_pixel_size;

    vec2 trace_coord = screen_texcoord;
    // trace_pos is written by every traced hit below and only read behind the
    // trace_hit guard, so it needs no initialization (an untraced or missed
    // ray never reaches the read).
    vec3 trace_pos;
    bool trace_hit = false;
    bool trace_hit_sky = false;
    vec3 reflect_dir = reflect(view_dir, current_normal);

#ifdef WATER_SSR
    bool ssr_allowed = is_water || is_glass;
#if WATER_SSR_SKY_SKIP
    if (ssr_allowed && reflect_dir.z < 0.0)
#endif
    {
    SSRHit water_hit = TraceTranslucentSSR(view_pos, reflect_dir, dither);
    trace_hit = water_hit.valid;
    trace_hit_sky = water_hit.sky;
    if (water_hit.valid) trace_pos = water_hit.screen;
    }
#endif
    vec3 prev_coord = vec3(0.0);
    bool history_hit = false;
    if (frameCounter > 0 && trace_hit && ScreenUVInside(trace_pos.xy)) {
        trace_coord = trace_pos.xy;
        // Sky hits reproject at their reported far-plane depth: the current
        // frame can carry nearer translucent water over that pixel, which
        // would turn the sky reflection into a water-surface history sample.
#if defined(TAAU_ACTIVE)
        float trace_scene_depth = trace_hit_sky ? trace_pos.z
            : texture(depthtex0, SceneTextureUV(trace_coord)).x;
#else
        float trace_scene_depth = trace_hit_sky ? trace_pos.z
            : texture(depthtex0, trace_coord).x;
#endif
        prev_coord = ToPrevious(vec3(trace_coord, trace_scene_depth));
        history_hit = ScreenUVInside(prev_coord.xy);
    }

    vec3 reflect_color = vec3(0.0);
    if(history_hit) {
        reflect_color = textureLod(colortex5, prev_coord.xy, 0.0).rgb;
    } else {
        if(isEyeInWater == 1) {
            reflect_color = WaterFogCol(view_pos);
        } else {
            vec3 view_refl_dir = normalize(mat3(gbufferModelViewInverse) * reflect_dir);
            reflect_color = SkyLightFromLm(v_texcoord.w) * texture(usam_sky_radiance, SkyRadianceUV(view_refl_dir)).rgb;
        }
    }

    // Sun glint = direct solar reflection; masked off exactly when a history
    // ray hit geometry (history_hit && !trace_hit_sky) - that hit already
    // reflects the ground, with no extra depth fetch.
    float sun_spec_mask = (history_hit && !trace_hit_sky) ? 0.0 : 1.0;

    // Single hardware-PCF shadow sample (no PCSS needed on water).
    float shadow = texture(shadowtex1, v_shadow_proj_pos);

    vec3 view_to_eye = -view_dir;

    float ndotv = saturate(dot(current_normal, view_to_eye));
    float ndotl = saturate(dot(current_normal, u_view_light_dir));
    float ldotv = dot(u_view_light_dir, view_to_eye);
    // For unit V and L, H = normalize(V + L) gives ldoth == sqrt((1 + ldotv) / 2);
    // the half vector has no other consumer on this path.
    float ldoth = sqrt(max(1.0 + ldotv, 0.0) * 0.5);
    vec3 sun_light = ground_light.rgb * shadow;
    vec3 base_color = is_water ? ToLinear(0.2 * normalize(v_color)) : diffuse.rgb;

    const float f0 = 0.1;
    const float water_f0 = 0.02;
    const float sun_roughness = 0.02;

    // Sun/moon glint: Decima spherical area light GGX plus Schlick Fresnel.
    // Schlick meets the exact unpolarized dielectric solve at normal incidence
    // and at grazing, for one Pow5 instead of two sqrts and three divisions.
    // Its deviation peaks at 0.06 absolute reflectance near cos_theta 0.1 (a
    // nearly grazing reflection) and stays under 1% relative above cos_theta
    // 0.93, which covers the ordinary glint geometry; the highlight is the only
    // consumer, so the exact solve does not earn its cost here. The disc radii
    // come from contract/settings.glsl (same constants as the rendered sky
    // discs); the active light is the sun when it is above the horizon (world
    // light direction y > 0), otherwise the moon.

    float sun_f0 = is_water ? water_f0 : f0;
    vec3 sun_fresnel = FresnelSchlick(ldoth, vec3(sun_f0));

    vec3 sun_specular = vec3(0.0);
    // Fresnel reflectance is at least f0 (0.02 water, 0.1 glass) at every
    // angle in both models, so a positive N.L is the only gate the area-light
    // math needs.
    if (ndotl > 1e-4) {
        float ndoth2 = GetNdotHSquared(ndotl, ndotv, ldotv, u_light_disc_radius);
        sun_specular = DistributionGGXNdotH2(ndoth2, sun_roughness)
               * VisibilitySmithGGXCorrelated(ndotv, ndotl, sun_roughness)
               * sun_fresnel;
    }

    float out_alpha = 0.0;

    if(is_water) {
        if(isEyeInWater == 0) {
            out_alpha = Pow5(1.0 - ndotv) * 0.98 + 0.02;
        } else {
            // (1.33*s)^2 == 1.33^2 * s: fold the refracted-angle squash into
            // one scaled term and keep a single sqrt round trip.
            float refracted_sq = saturate(1.7689 * (1.0 - ndotv * ndotv));
            float new_ndotv = sqrt(1.0 - refracted_sq);
            out_alpha = Pow5(1.0 - new_ndotv);
        }
    } else {
        out_alpha = Pow5(1.0 - ndotv) * (1.0 - diffuse.a) + diffuse.a;
    }

    vec3 sun_reflect = sun_light * (sun_specular) * ndotl * sun_spec_mask;
    vec3 sky_reflect = reflect_color * out_alpha * v_texcoord.w;
    // v_ambient_col is cosine-convolved sky irradiance; this diffuse ambient
    // term needs the same Lambert E/pi conversion the plain path's
    // lambert_brdf already carries, or it reads pi times too bright.
    vec3 env_reflect = is_water ? vec3(0.0) : v_ambient_col * base_color * (1.0 / PI);

    // The sun glint stays at full strength; the sky and environment
    // reflections are weighted by out_alpha, which is also the layer alpha
    // written for the blend.
    vec3 comp_light = sun_reflect + sky_reflect + env_reflect * saturate(out_alpha);
    out_layer_color = vec4(comp_light, saturate(out_alpha));

    // Split the original UNORM16 perturbation across colortex1/2 RGB; both
    // use nearest-fragment replacement. colortex1 alpha retains the opaque ID.
    PackTranslucentSurface(surface_normal * 0.25 + 0.5, is_water ? 1.0 : 0.0,
        out_surface_data, out_surface_high);
#endif
}
