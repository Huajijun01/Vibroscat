#include "/lib/contract/uniforms.glsl"
#include "/lib/core/render_scale.glsl"

/* RENDERTARGETS: 1 */

in vec2 v_texcoord;
in vec4 v_color;

layout(location = 0) out vec4 out_color;

void main() {
    if (OutsideSceneRender(gl_FragCoord.xy)) discard;
    vec4 tex = texture(gtexture, v_texcoord) * v_color;
    if (tex.a < 0.004) discard;
    out_color = vec4(tex.rgb, 1.0);
}
