/* RENDERTARGETS: 0 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/noise.glsl"
#include "/lib/color/dither.glsl"

const float COLOR_JITTER_SEED = 71.0;

layout(location = 0) out vec3 out_color;

void main() {
#if !defined(MOTION_BLUR) || !defined(TAA)
    vec3 passthrough_color = texelFetch(colortex0, ivec2(gl_FragCoord.xy), 0).xyz;
    out_color = JitterR11G11B10F(passthrough_color, gl_FragCoord.xy, COLOR_JITTER_SEED);
    return;
#endif
    ivec2 tx = ivec2(gl_FragCoord.xy);
    vec2 texcoord = (vec2(tx) + 0.5) * u_view_pixel_size;

    vec2 velocity = texelFetch(colortex0, tx, 0).rg;
    vec3 scene = texelFetch(colortex5, tx, 0).rgb;

    float vel_len = length(velocity * u_screen_res);
    if (vel_len < 0.5) {
        out_color = JitterR11G11B10F(scene, gl_FragCoord.xy, COLOR_JITTER_SEED);
        return;
    }

    float noise = InterleavedGradientNoise(vec2(tx));
    float sample_count = 16.0;
    vec2 step_size = velocity * MB_STRENGTH / sample_count;
    vec2 sample_coord = texcoord - velocity * 0.5 + step_size * noise;

    vec3 blurred = vec3(0.0);
    for (float i = 0.0; i < sample_count; i += 1.0) {
        blurred += texture(colortex5, sample_coord).rgb;
        sample_coord += step_size;
    }
    blurred /= sample_count;

    float blend = clamp(vel_len * 0.1, 0.0, 1.0);
    vec3 motion_blurred_scene = mix(scene, blurred, blend);
    out_color = JitterR11G11B10F(motion_blurred_scene, gl_FragCoord.xy, COLOR_JITTER_SEED);
}
