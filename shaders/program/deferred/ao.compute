// ============================================================================
// AO generation and accumulation (half resolution) - borrows colortex2 alt.
// ============================================================================
// Dispatch: half-res via workGroupsRender 0.5 (groups = ceil(view*0.5/(16,32)),
// local 16x32). Each invocation covers one 2x2 full-res block, evaluates the
// kernel (ComputeGTAO / ComputeSSAO) at a fixed receiver in that block.
// Every half-res texel is evaluated every frame. deferred1 reconstructs
// the accumulated field with depth/normal guidance on this exact lattice.
// Runs with cloud compute in deferred1; the two write distinct textures.
//
// Storage: lower-left ceil-half-res rectangle of the RGBA8 workspace:
// R = accumulated raw AO, GB = exact receiver octahedral geometric normal,
// A = history age / 255. The receiver is the lower-left pixel of each block.
// deferred_pre selects alt; deferred1 samples it, then restores the opaque
// material scalars on main. Raw AO (no multibounce/strength): the nonlinear
// transforms are applied by the lighting consumer after the temporal blend (the
// accumulated field stays linear).

#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/noise.glsl"
#include "/lib/core/packing.glsl"
#include "/lib/lighting/gtao.glsl"
#include "/lib/lighting/ssao.glsl"
#include "/lib/lighting/temporal_ao.glsl"

// Keep the original pixel mapping and sample coordinates. Larger neighboring
// groups reduced the scattered-depth path's GPU time on the profiling target;
// all half-resolution texels still update every frame.
layout(local_size_x = 16, local_size_y = 32) in;
const vec2 workGroupsRender = vec2(0.5, 0.5);

layout(rgba8) uniform restrict writeonly image2D colorimg2;

void main() {
    ivec2 half_texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 half_size = ivec2(u_ao_half_res);
    if (any(greaterThanEqual(half_texel, half_size))) {
        return;
    }
    // Depth, normal and ray origin use the same actual full-res pixel. The
    // last row/column clamps to the cropped scene when its size is odd.
    ivec2 sample_pixel = min(half_texel * 2, ivec2(u_render_res) - 1);
    vec2 uv = (vec2(sample_pixel) + vec2(0.5)) * u_render_pixel_size;
    // The AO temporal accumulator runs with or without TAA, so the STBN pair
    // keeps advancing with frameCounter (no STBNFrame() pinning here). The
    // evaluation point is half-res: shift nothing spatially, offset the
    // second stream by the registry's STBN_STREAM_3.
    vec2 stbn_noise = SampleSTBNPair(
        half_texel, frameCounter, STBN_STREAM_3, ivec2(0));
#if defined(GTAO)
    float ao = ComputeGTAO(uv, vec2(sample_pixel), stbn_noise);
#elif defined(SSAO)
    float ao = ComputeSSAO(uv, vec2(sample_pixel), stbn_noise);
#else
    // Unreachable while deferred1_a is scheduled (AO_MODE != 0 with
    // GI_MODE == 0 implies GTAO or SSAO); keeps `ao` defined if that gating
    // and these macros ever drift apart.
    float ao = 1.0;
#endif
    vec2 normal_oct = texelFetch(colortex4, sample_pixel, 0).xy;
    float scene_depth = texelFetch(depthtex2, sample_pixel, 0).r;
    vec2 accumulated = ResolveTemporalAO(sample_pixel, scene_depth, normal_oct, ao);
    ao = accumulated.x;
#if defined(AO_TEMPORAL_ENABLED)
    // Unbiased UNORM8 conversion prevents small EMA updates from stalling at
    // an 8-bit boundary. Independent hash bits avoid correlating with rays.
    uint rounding_bits = LowBias32Hash(uint(half_texel.x) ^ (uint(half_texel.y) * 0x9e3779b9u)
        ^ (uint(frameCounter) * 0x85ebca6bu));
    float rounding_noise = float(rounding_bits >> 8) * (1.0 / 16777216.0);
    ao = floor(clamp(ao, 0.0, 1.0) * 255.0 + rounding_noise) * (1.0 / 255.0);
#endif
    imageStore(colorimg2, half_texel, vec4(ao, normal_oct, accumulated.y * (1.0 / 255.0)));
}
