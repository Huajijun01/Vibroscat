// BLOOM_SRC_MIP and BLOOM_DST_MIP are defined by the pass wrapper.
#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/post/bloom.glsl"
#include "/lib/post/bloom_downsample.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f) uniform image2D colorimg12;

void main() {
#ifdef BLOOM
    ivec2 full_size = imageSize(colorimg12);
    ivec2 src_origin = GetBloomMipOrigin(full_size, BLOOM_SRC_MIP);
    ivec2 src_size = GetBloomMipSize(full_size, BLOOM_SRC_MIP);
    ivec2 dst_origin = GetBloomMipOrigin(full_size, BLOOM_DST_MIP);
    ivec2 dst_size = GetBloomMipSize(full_size, BLOOM_DST_MIP);
    vec2 pixel_size = 1.0 / vec2(full_size);
    vec2 src_min = vec2(src_origin) + 0.5;
    vec2 src_max = vec2(src_origin + src_size) - 0.5;
    ivec2 group_base = ivec2(gl_WorkGroupID.xy) * 32;
    for (uint index = gl_LocalInvocationIndex; index < 630u; index += 256u) {
        int row = int(index / 18u);
        int column = int(index % 18u);
        ivec2 source_texel = group_base + ivec2(column * 2 + (row & 1), row) - 1;
        vec2 sample_texel = vec2(src_origin + source_texel);
        vec3 value = textureLod(colortex12, clamp(sample_texel, src_min, src_max) * pixel_size, 0.0).rgb;
        // Alpha's cleared tile padding contributes half a texel at each edge.
        vec2 coverage = vec2(source_texel.x <= 0 || source_texel.x >= src_size.x ? 0.5 : 1.0,
                             source_texel.y <= 0 || source_texel.y >= src_size.y ? 0.5 : 1.0);
        StoreBloomDownTile(ivec2(column, row), max(value, vec3(0.0)) * coverage.x * coverage.y);
    }
    barrier();
    ivec2 dst_coord = ivec2(gl_GlobalInvocationID.xy);
    if (all(lessThan(dst_coord, dst_size))) {
        imageStore(colorimg12, dst_origin + dst_coord,
                   vec4(FilterBloomDownTile(ivec2(gl_LocalInvocationID.xy)), 0.0));
    }
#endif
}
