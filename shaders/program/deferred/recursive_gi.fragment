#include "/lib/contract/settings.glsl"
/* RENDERTARGETS: 9,10 */

#include "/lib/contract/uniforms.glsl"
#include "/lib/material/opaque_surface.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/noise.glsl"
#include "/lib/core/packing.glsl"
#include "/lib/core/render_scale.glsl"
#include "/lib/color/spaces.glsl"
#include "/lib/lighting/ambient_light.glsl"
#include "/lib/lighting/gi_denoise.glsl"
#include "/lib/lighting/gi_history.glsl"
#include "/lib/lighting/gi_sampling.glsl"
#include "/lib/atmosphere/sky_light.glsl"
#include "/lib/lighting/lightmap.glsl"
#include "/lib/lighting/ssgi_sky_visibility.glsl"
#include "/lib/lighting/gtao.glsl"
#include "/lib/shadow/reflective_shadow_map.glsl"

// colortex10 metadata records the selected receiver; deferred5 reconstructs spatially.

layout(location = 0) out vec3 out_gi;
layout(location = 1) out vec4 out_gi_metadata;


#if GI_MODE == 1
float RemapPartialSlice(float x, float sin_view_normal) {
    if (abs(x) >= 1.0 || x == 0.0) return x;
    bool negative = x < 0.0;
    x = abs(x);
    float o = sin_view_normal - sin_view_normal * sin_view_normal;
    float slope0 = 1.0 / (1.0 + (PI - 1.0) * (sin_view_normal - o * 0.30546));
    float slope1 = 1.0 / (1.0 - (1.0 - exp2(-20.0)) * (sin_view_normal + o * mix(0.5, 0.785, sin_view_normal)));
    float k = mix(0.1, 0.25, sin_view_normal);
    float a = 1.0 - (PI - 2.0) / (PI - 1.0);
    float b = 1.0 / (PI - 1.0);
    float d0 = a - slope0 * b;
    float d1 = 1.0 - slope1;
    float f0 = d0 * (PI * x - (0.5 * PI - FastAcos(x)));
    float f1 = d1 * (x - 1.0);
    // Rational-fit join: smooth-clip each branch with sqrt(f^2 + k^2) - k, then a harmonic mean.
    float kk = k * k;
    float h0 = sqrt(f0 * f0 + kk) - k;
    float h1 = sqrt(f1 * f1 + kk) - k;
    float hh = (h0 * h1) / max(h0 + h1, 1.0e-6);
    float y = x - sqrt(max(hh * (hh + 2.0 * k), 0.0));
    return negative ? -y : y;
}

vec2 SampleSliceDirection(vec3 normal_view, float random_value) {
    float angle = random_value * TAU;
    vec2 direction = vec2(cos(angle), sin(angle));
    float normal_xy_length = length(normal_view.xy);
    if (normal_xy_length > 1.0e-5) {
        vec2 normal_direction = normal_view.xy / normal_xy_length;
        direction = Rotate2D(direction, normal_direction * vec2(1.0, -1.0));
        float slice_angle = RemapPartialSlice(FastAtan2(direction), normal_xy_length) * PI;
        direction = Rotate2D(vec2(cos(slice_angle), sin(slice_angle)), normal_direction);
    }
    return direction;
}

vec4 QuaternionFromViewDirection(vec3 view_dir) {
    vec3 xyz = vec3(view_dir.y, -view_dir.x, 0.0);
    float scalar = -view_dir.z;
    // view_dir is unit at the caller, keeping the saturate exact.
    float inverse_scale = inversesqrt(saturate(scalar * 0.5 + 0.5));
    return vec4(xyz * inverse_scale * 0.5, 1.0 / inverse_scale);
}

vec3 RotateVectorByQuaternion(vec3 value, vec4 quaternion) {
    float cross_term = value.y * quaternion.x - value.x * quaternion.y;
    float scale = 2.0 * (value.z * quaternion.w + cross_term);
    vec3 result;
    result.xy = value.xy + quaternion.yx * vec2(scale, -scale);
    result.z = value.z + 2.0 * (quaternion.w * cross_term
        - value.z * dot(quaternion.xy, quaternion.xy));
    return result;
}

vec3 RotateSliceDirectionByQuaternion(vec2 slice_direction, vec4 quaternion) {
    float offset = quaternion.x * slice_direction.y;
    float cross_term = quaternion.y * slice_direction.x;
    vec3 basis = vec3(offset - cross_term, -offset + cross_term, offset - cross_term);
    return vec3(slice_direction, 0.0) + 2.0 * (basis * quaternion.yxw);
}

// Slice-relative CDF of the cosine-weighted distribution over the active
// slice's usable span; endpoint inputs pass through unchanged.
float SliceRelativeCDF(float x, float angle_normal, float cos_normal,
        float sin_normal, float cdf_inv_denominator) {
    float result = x;
    if (!(x <= 0.0 || x >= 1.0)) {
        float phi = x * PI - PI * 0.5;
        float numerator = 3.0 * cos_normal - cos(angle_normal - 2.0 * phi)
            + (4.0 * angle_normal - 2.0 * phi + PI) * sin_normal;
        result = numerator * cdf_inv_denominator;
    }
    return result;
}

// Range-end guards keep fully covered spans exact (shift-by-32 is undefined).
uint VisibilityMaskFromRange(vec2 range01) {
    uvec2 range_bits = uvec2(floor(range01 * 32.0));
    uint left = range_bits.x < 32u ? 0xFFFFFFFFu << range_bits.x : 0u;
    uint right = range_bits.y != 0u ? 0xFFFFFFFFu >> (32u - range_bits.y) : 0u;
    return left & right;
}

vec3 TraceGI(vec3 origin_view_position, vec3 origin_normal_view, vec3 stbn_noise,
        out float coverage, out float second_moment
#if defined(SSGI_DIRECTIONAL_SKY_ACTIVE)
        , out vec3 sky_direction_moment_view
#endif
        ) {
    second_moment = 0.0;
#if defined(SSGI_DIRECTIONAL_SKY_ACTIVE)
    // Early exits keep this initializer: zero coverage must yield the
    // full-visibility hemisphere mean (2/3)*n.
    sky_direction_moment_view = (2.0 / 3.0) * origin_normal_view;
#endif
    vec3 view_dir = -normalize(origin_view_position);
    vec4 q_to_view = QuaternionFromViewDirection(view_dir);
    vec4 q_from_view = q_to_view * vec4(vec3(-1.0), 1.0);
    vec3 normal_view = RotateVectorByQuaternion(origin_normal_view, q_from_view);
    // gi_noise streams: x = slice direction, y = first-step jitter, z = arc jitter.
    vec2 slice_direction = SampleSliceDirection(normal_view, stbn_noise.x);
    vec3 ray_direction = RotateSliceDirectionByQuaternion(slice_direction, q_to_view);

    vec3 projection_diag = vec3(gbufferProjection[0].x, gbufferProjection[1].y, gbufferProjection[2].z);
    vec4 origin_proj = vec4(projection_diag * origin_view_position + gbufferProjection[3].xyz, -origin_view_position.z);
#ifdef TAA
    origin_proj.xy += u_taa_offset * origin_proj.w;
#endif
    vec4 projected_direction = vec4(projection_diag * ray_direction, -ray_direction.z);
    projected_direction.xy += gbufferProjection[2].xy * ray_direction.z;
    // far + 32.0 bounds rays that never cross a screen edge forward.
    float trace_length = ClipRayScreenExitT(origin_proj, projected_direction, far + 32.0);
    vec2 origin_coord = origin_proj.xy * (0.5 / origin_proj.w) + 0.5;
    vec4 target_proj = origin_proj + projected_direction * trace_length;
    vec2 target_coord = target_proj.xy / target_proj.w * 0.5 + 0.5;
    vec2 sample_range = (target_coord - origin_coord) * u_render_res;
    float inv_range = inversesqrt(dot(sample_range, sample_range));
    vec2 step_dir = sample_range * inv_range * u_render_pixel_size;
    float march_width = min(SSGI_MARCH_PIXELS, 1.0 / max(saturate(inv_range), 1.0e-6));
    float step_scale = pow(march_width, 1.0 / float(SSGI_STEPS));
    float step_size = pow(march_width, stbn_noise.y / float(SSGI_STEPS));
    vec2 inverse_projection_scale = vec2(gbufferProjectionInverse[0].x, gbufferProjectionInverse[1].y);
    vec2 inverse_projection_bias = gbufferProjectionInverse[3].xy;
    float inverse_projection_z = gbufferProjectionInverse[3].z;
    float inverse_projection_depth_scale = gbufferProjectionInverse[2].w;
    float inverse_projection_depth_bias = gbufferProjectionInverse[3].w;

    vec3 slice_normal = cross(view_dir, ray_direction);
    vec3 projected_normal = origin_normal_view - slice_normal * dot(origin_normal_view, slice_normal);
    float projected_normal_sq = dot(projected_normal, projected_normal);
    if (projected_normal_sq < 1.0e-10) { coverage = 0.0; return vec3(0.0); }
    projected_normal *= inversesqrt(projected_normal_sq);
    vec3 tangent = cross(slice_normal, projected_normal);
    // Back-facing projected normals (silhouettes, thin surfaces) invert the
    // sector order and zero the CDF denominator; clamp at the horizon.
    float cos_normal = saturate(dot(projected_normal, view_dir));
    float angle_normal = (dot(view_dir, tangent) < 0.0 ? -1.0 : 1.0) * FastAcos(cos_normal);
    float sin_normal = sin(angle_normal);
    float cdf_denominator = cos_normal + angle_normal * sin_normal;
    float cdf_rcp = 1.0 / cdf_denominator;
    // w0: cosine mass below the usable horizon; drives the [w0, 1] CDF remap.
    float w0 = saturate((sin_normal * cdf_rcp) * (PI * 0.25) + 0.5);
    // w0 == 1 leaves no usable cosine mass and a zero remap denominator.
    if (w0 >= 1.0) { coverage = 0.0; return vec3(0.0); }
    float cdf_inv_denominator = 0.25 * cdf_rcp;
    float remap_mul = 1.0 / (1.0 - w0);
    float remap_add = -w0 * remap_mul;

    uint occupied = 0u;
    vec3 gi = vec3(0.0);
    float hit_coverage = 0.0;
    // next_uv must stay a pure size recurrence: the depth read is prefetched
    // one step ahead of the sampled depth.
    vec2 sample_uv = origin_coord + step_dir * step_size;
    step_size *= step_scale;
#if defined(TAAU_ACTIVE)
    float sample_fetch = texture(depthtex2, SceneTextureUV(sample_uv)).r;
#else
    float sample_fetch = texture(depthtex2, sample_uv).r;
#endif
    for (int i = 0; i < SSGI_STEPS; ++i) {
        if (any(lessThan(sample_uv, vec2(0.0))) || any(greaterThanEqual(sample_uv, vec2(1.0)))) break;
        vec2 next_uv = origin_coord + step_dir * step_size;
        step_size *= step_scale;
#if defined(TAAU_ACTIVE)
        float next_fetch = texture(depthtex2, SceneTextureUV(next_uv)).r;
#else
        float next_fetch = texture(depthtex2, next_uv).r;
#endif
        float sample_depth = sample_fetch;
        sample_fetch = next_fetch;
        if (sample_depth >= 1.0) {
            sample_uv = next_uv;
            continue;
        }
        vec3 sample_view = vec3(sample_uv * 2.0 - 1.0, 1.0);
#ifdef TAA
        sample_view.xy -= u_taa_offset;
#endif
        sample_view.xy = inverse_projection_scale * sample_view.xy + inverse_projection_bias;
        sample_view.z = inverse_projection_z;
        sample_view /= inverse_projection_depth_scale * (sample_depth * 2.0 - 1.0)
            + inverse_projection_depth_bias;
        vec3 delta_front = sample_view - origin_view_position;
        vec3 delta_back = delta_front + normalize(sample_view) * SSGI_THICKNESS;
        float front_dd = max(dot(delta_front, delta_front), 1.0e-6);
        float front_inv_len = inversesqrt(front_dd);
        float front_cos = dot(delta_front, view_dir) * front_inv_len;
        float back_cos = dot(delta_back, view_dir) * inversesqrt(max(dot(delta_back, delta_back), 1.0e-6));
        vec2 horizontal = vec2(FastAcos(front_cos), FastAcos(back_cos));
        vec2 horizontal01 = saturate((horizontal + angle_normal) / PI + 0.5);
        horizontal01 = vec2(
            SliceRelativeCDF(horizontal01.x, angle_normal, cos_normal, sin_normal, cdf_inv_denominator),
            SliceRelativeCDF(horizontal01.y, angle_normal, cos_normal, sin_normal, cdf_inv_denominator));
        horizontal01 = horizontal01 * remap_mul + vec2(remap_add);
        horizontal01 = saturate(horizontal01 + vec2(stbn_noise.z * (1.0 / 32.0)));
        uint sample_mask = VisibilityMaskFromRange(horizontal01);
        uint visible = sample_mask & (~occupied);
        if (visible != 0u) {
            float visible_weight = float(bitCount(visible)) * (1.0 / 32.0);
            // Covered sectors occlude even when their radiance cannot be read back.
            hit_coverage += visible_weight;
            ivec2 source_texel = min(ivec2(sample_uv * u_render_res), ivec2(u_render_res) - 1);
            int source_id = int(texelFetch(colortex1, source_texel, 0).a * 255.0 + 0.5);
            // depthtex2 renders behind the hand, so its RGB is unavailable here.
            if (source_id != 64) {
                // Radiance x PI = irradiance, matching the unit AmbientLight() consumers read in deferred5.
                vec3 incident_irradiance = texelFetch(colortex0, source_texel, 0).rgb * PI;
                gi += incident_irradiance * visible_weight;
#if !defined(SSGI_DIRECTIONAL_SKY_ACTIVE)
                // Directional-sky main overwrites sample_sigma with 0; keeping this
                // live made the driver carry it through the whole march.
                float sample_luminance = Luminance(incident_irradiance);
                second_moment += sample_luminance * sample_luminance * visible_weight;
#endif
            }
        }
        occupied |= sample_mask;
        if (occupied == 0xFFFFFFFFu) break;
        sample_uv = next_uv;
    }
    coverage = saturate(hit_coverage);
#if defined(SSGI_DIRECTIONAL_SKY_ACTIVE)
    vec2 moment_cs = SSGISkySliceMoment(occupied, 1.0 - coverage, angle_normal);
    sky_direction_moment_view = view_dir * moment_cs.x + ray_direction * moment_cs.y;
#endif
    return gi;
}

// Radiance limit clamps before the artistic gain; sky/floor terms never enter this.
void ApplySSGIBounceStrength(inout vec3 bounce, inout float second_moment) {
    float scale = SSGI_STRENGTH;
    float peak = max(max(bounce.r, bounce.g), bounce.b);
    if (peak > SSGI_RADIANCE_LIMIT) scale *= SSGI_RADIANCE_LIMIT / peak;
    bounce *= scale;
#if !defined(SSGI_DIRECTIONAL_SKY_ACTIVE)
    second_moment *= scale * scale;
#endif
}

#endif

void main() {
    ivec2 gi_texel = ivec2(gl_FragCoord.xy);
    if (any(greaterThanEqual(gi_texel, GIHistorySize()))) discard;
    out_gi = vec3(0.0);
    out_gi_metadata = vec4(0.0);
    ivec2 tx = ivec2(0);
    float scene_depth = 1.0;
    int offset_code = 0;
    // One real receiver per block; hand pixels stay on deferred5's full-res SH path.
    for (int i = 0; i < 4; ++i) {
        ivec2 sample_texel = ivec2(RepresentativePixelUV(gi_texel, i) * u_render_res);
        float sample_depth = texelFetch(depthtex2, sample_texel, 0).r;
        int sample_material = int(texelFetch(colortex1, sample_texel, 0).a * 255.0 + 0.5);
        if (sample_material == 64 || sample_depth >= scene_depth) continue;
        scene_depth = sample_depth;
        tx = sample_texel;
        offset_code = i;
    }
    if (scene_depth >= 1.0) return;
    vec2 uv = (vec2(tx) + 0.5) * u_render_pixel_size;
    vec4 geometry_data = texelFetch(colortex4, tx, 0);
    // colortex4: world-space geometric normal, consumed directly by the SH fallback.
    vec3 fallback_normal = DecodeOctahedralNormal(geometry_data.xy);
    vec3 fallback;
    vec2 reconstruction_uv = uv;
#ifdef TAA
    reconstruction_uv -= u_taa_offset * 0.5;
#endif
    vec3 receiver_view = NDCToView(vec3(reconstruction_uv * 2.0 - 1.0, scene_depth * 2.0 - 1.0));
#if GI_MODE == 2
    vec3 receiver_world = ViewToWorldSpace(receiver_view);
#endif
    vec3 raw_gi;
    float sample_sigma;
    vec3 gi_noise = SampleGINoise(tx, frameCounter);
#if GI_MODE == 2
    vec4 surface = texelFetch(colortex11, tx, 0);
    vec4 surface_data = UnpackOpaqueMaterial(surface);
    vec3 sky_normal = DecodeOctahedralNormal(surface.rg);
    vec2 ao_noise = SampleSTBNPair(tx / 2, frameCounter, STBN_STREAM_3, ivec2(0));
#if defined(RSM_DIRECTIONAL_SKY_ACTIVE)
    // GI takes raw geometric sky visibility, not the artistic AO response.
    GTAOSkyResult sky_visibility = ComputeGTAOSkyFromGeometry(
        uv, scene_depth, geometry_data.xy, ao_noise, sky_normal);
    vec3 ambient_ao = vec3(sky_visibility.ao);
    fallback = AmbientLightWithSkyVisibility(sky_visibility.visible_sky,
        sky_visibility.ao, geometry_data.w);
#else
#if AO_MODE == 1
    float screen_ao = ComputeGTAOFromGeometry(uv, scene_depth, geometry_data.xy, ao_noise);
#else
    float screen_ao = surface_data.a;
#endif
    vec3 ambient_ao = vec3(saturate(screen_ao));
    fallback = AmbientLight(sky_normal, ambient_ao, geometry_data.w);
#endif
    // GI owns its temporal reconstruction, independently of the final TAA.
    raw_gi = GatherRSM(receiver_world, receiver_view, fallback_normal, gi_noise.xy,
        fallback, ambient_ao, sample_sigma);
#else
    float coverage;
    float second_moment;
    vec3 normal_view = normalize(mat3(gbufferModelView) * fallback_normal);
#if defined(SSGI_DIRECTIONAL_SKY_ACTIVE)
    vec3 sky_direction_moment_view;
    vec3 sky_l2_band = EvalSkyLightL2(fallback_normal);
    raw_gi = TraceGI(receiver_view + normal_view * 0.003, normal_view, gi_noise,
        coverage, second_moment, sky_direction_moment_view);
    ApplySSGIBounceStrength(raw_gi, second_moment);
    // Directional fallback: occluders tint the sky ambient by the directions they block.
    // sample_sigma stays 0 here (no consumer; a full-sky fallback would double the sky evaluation).
    float visible_mass = 1.0 - coverage;
    vec3 moment_world = mat3(gbufferModelViewInverse) * sky_direction_moment_view;
    vec3 visible_sky = max(
        EvalSSGISkyFromMoment(visible_mass, moment_world, sky_l2_band), vec3(0.0));
    raw_gi += visible_sky * SkyLightFromLm(geometry_data.w) * SKY_AMBIENT_STRENGTH
        + vec3(AMBIENT_FLOOR) * visible_mass;
    sample_sigma = 0.0;
#else
    fallback = AmbientLight(fallback_normal, vec3(1.0), geometry_data.w);
    raw_gi = TraceGI(receiver_view + normal_view * 0.003, normal_view, gi_noise,
        coverage, second_moment);
    ApplySSGIBounceStrength(raw_gi, second_moment);
    float miss_fraction = 1.0 - coverage;
    raw_gi += fallback * miss_fraction;
    // sample_sigma is a conservative spread scale, not the variance of independent samples.
    float fallback_luminance = Luminance(fallback);
    float mean_luminance = Luminance(raw_gi);
    sample_sigma = sqrt(max(second_moment + fallback_luminance * fallback_luminance * miss_fraction
        - mean_luminance * mean_luminance, 0.0));
#endif
#endif
#if GI_MODE != 2
    vec3 receiver_world = ViewToWorldSpace(receiver_view);
#endif
    GIReprojectedHistory history = ReprojectGIHistory(receiver_world, fallback_normal);
    float history_age;
    out_gi = QuantizeGIHistory(AccumulateGI(raw_gi, sample_sigma, history, history_age), gi_texel, frameCounter);
    float stored_second_moment = QuantizeGISecondMoment(history.second_moment, gi_texel, frameCounter);
    out_gi_metadata = EncodeGIHistory(fallback_normal, -receiver_view.z, history_age,
        offset_code, stored_second_moment, history.change_count);
}
