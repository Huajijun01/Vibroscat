#include "/lib/contract/sky_light_data.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/atmosphere/media.glsl"
#include "/lib/atmosphere/sky_light.glsl"
#include "/lib/atmosphere/skybox_uv.glsl"
#include "/lib/atmosphere/spectral.glsl"
#include "/lib/atmosphere/transmittance.glsl"

// Each workgroup owns one RGB SH coefficient, with no cross-group reads.
// Project the upper sky and analytically close the lower hemisphere with a
// uniform Lambertian ground, retaining the existing 20% fill reflectance.
#define SH_ROW_STRIPES 2
#define SH_WORKGROUP_THREADS (SKY_RADIANCE_LUT_SIZE * SH_ROW_STRIPES)
#define SH_SKY_ROWS (SKY_RADIANCE_LUT_SIZE / 2)
#define SH_ROWS_PER_STRIPE (SH_SKY_ROWS / SH_ROW_STRIPES)
#define SH_ROW_SAMPLE_STRIDE 2
const float SKY_GROUND_REFLECTANCE = 0.2;
// Keep the existing even-row quadrature and solid angle per retained texel.
const float SH_SAMPLE_WEIGHT = 8.0 * PI
    / (float(SKY_RADIANCE_LUT_SIZE) * float(SKY_RADIANCE_LUT_SIZE));
layout(local_size_x = SKY_RADIANCE_LUT_SIZE, local_size_y = SH_ROW_STRIPES) in;
const ivec3 workGroups = ivec3(9, 1, 1);
layout(rgba16f) uniform readonly image2D uimg_sky_radiance;
shared float row_weight[SH_SKY_ROWS];
shared vec4 reduce_sh[SH_WORKGROUP_THREADS];

void main() {
    if (gl_LocalInvocationIndex < uint(SH_SKY_ROWS)) {
        float sy = SKY_RADIANCE_LUT_ROW_CENTER(gl_LocalInvocationIndex + uint(SH_SKY_ROWS));
        float cy = sqrt(saturate(1.0 - sy * sy));
        float weight;
        // E_up = integral(L_sky * sy); L_ground = rho * E_up / PI.
        // Its raw SH increments are 2*PI*Y0*L_ground and -PI*Y1*L_ground.
        // Linearity folds both into these sky weights, without reading other
        // groups' results or sampling the synthetic ground hemisphere.
        if (gl_WorkGroupID.x == 0u) weight = SH_Y0 * (1.0 + 2.0 * SKY_GROUND_REFLECTANCE * sy);
        else if (gl_WorkGroupID.x == 1u) weight = SH_Y1 * sy * (1.0 - SKY_GROUND_REFLECTANCE);
        else if (gl_WorkGroupID.x == 2u || gl_WorkGroupID.x == 3u) weight = SH_Y1 * cy;
        else if (gl_WorkGroupID.x == 4u) weight = SH_Y20 * (3.0 * sy * sy - 1.0);
        else if (gl_WorkGroupID.x == 5u || gl_WorkGroupID.x == 7u) weight = SH_Y21 * sy * cy;
        else if (gl_WorkGroupID.x == 6u) weight = SH_Y21 * cy * cy;
        else weight = SH_Y22 * cy * cy;
        row_weight[gl_LocalInvocationIndex] = weight;
    }
    float phi = (float(gl_LocalInvocationID.x) + 0.5) / float(SKY_RADIANCE_LUT_SIZE) * TAU - PI;
    float cs = cos(phi);
    float sn = sin(phi);
    float col_weight = 1.0;
    if (gl_WorkGroupID.x == 2u || gl_WorkGroupID.x == 5u) col_weight = sn;
    else if (gl_WorkGroupID.x == 3u || gl_WorkGroupID.x == 7u) col_weight = cs;
    else if (gl_WorkGroupID.x == 6u) col_weight = cs * sn;
    else if (gl_WorkGroupID.x == 8u) col_weight = cs * cs - sn * sn;
    barrier();
    vec3 sum_sh = vec3(0.0);
    uint row_begin = gl_LocalInvocationID.y * uint(SH_ROWS_PER_STRIPE);
    uint row_end = row_begin + uint(SH_ROWS_PER_STRIPE);
    for (uint y = row_begin; y < row_end; y += uint(SH_ROW_SAMPLE_STRIDE)) {
        vec3 color = imageLoad(uimg_sky_radiance,
            ivec2(int(gl_LocalInvocationID.x), int(y) + SH_SKY_ROWS)).rgb;
        sum_sh += color * row_weight[y];
    }
    reduce_sh[gl_LocalInvocationIndex] = vec4(sum_sh * col_weight, 0.0);
    barrier();
    for (uint stride = uint(SH_WORKGROUP_THREADS / 2); stride > 0u; stride >>= 1u) {
        if (gl_LocalInvocationIndex < stride) reduce_sh[gl_LocalInvocationIndex] += reduce_sh[gl_LocalInvocationIndex + stride];
        barrier();
    }
    if (gl_LocalInvocationIndex == 0u) {
        vec3 sh = reduce_sh[0].rgb * SH_SAMPLE_WEIGHT;
        if (gl_WorkGroupID.x < 4u) {
            sky_sh_r0[gl_WorkGroupID.x] = sh.r;
            sky_sh_g0[gl_WorkGroupID.x] = sh.g;
            sky_sh_b0[gl_WorkGroupID.x] = sh.b;
        } else if (gl_WorkGroupID.x < 8u) {
            sky_sh_r1[gl_WorkGroupID.x - 4u] = sh.r;
            sky_sh_g1[gl_WorkGroupID.x - 4u] = sh.g;
            sky_sh_b1[gl_WorkGroupID.x - 4u] = sh.b;
        } else {
            sky_sh_r2.x = sh.r;
            sky_sh_g2.x = sh.g;
            sky_sh_b2.x = sh.b;
        }
    }
    if (gl_LocalInvocationIndex == 0u && gl_WorkGroupID.x == 0u) {
        // Direct sun/moon light arrives at the camera, not at a fixed sea-level
        // plane: use the actual camera altitude, so the air mass above the eye
        // shrinks as the player climbs and the direct color reddens less.
        vec4 trans = SampleTransmittance(utex_tslut, u_camera_radius_km, u_camera_radius_sq, abs(u_world_sun_dir.y));
        vec3 ground_color;
        ground_color = SpectralToLinearSRGBWhiteBalanced(trans * (u_world_sun_dir.y > 0.0 ? ATM_SOLAR : ATM_MOON_IRR)) * ATM_EXPOSURE;
        ground_light.rgb = ground_color * (1.0 - rainStrength * 0.9);
        ground_light.a = 0.0;
    }
}
