#shaders/lang/en_us.lang

#Profiles
profile.LOW = §aLow
profile.MEDIUM = §aMedium
profile.HIGH = §eHigh (Recommended)
profile.ULTRA = §4Ultra
profile.comment = One-click quality presets. Each tier only changes settings that affect performance (shadow resolution, cloud sampling, ambient occlusion, reflection quality); your other custom settings stay untouched.

#Screens
screen.RAIN = Rain & Wet Surfaces
screen.RAIN.comment = Wet ground, puddles, and rain ripples on ground and water.
option.RAIN_WETNESS = Rain Wetness
option.RAIN_WETNESS.comment = Master switch for rain effects: wets exposed ground and adds raindrop ripples on ground and water.
option.RAIN_PUDDLES = Rain Puddles
option.RAIN_PUDDLES.comment = Restrict wet ground to puddle patterns. Off = all eligible exposed ground gets wet.
option.RAIN_RIPPLES = Rain Ripples
option.RAIN_RIPPLES.comment = Raindrop rings on exposed ground and water. Sheltered surfaces stay dry.
option.RAIN_PUDDLE_COVERAGE = Puddle Coverage
option.RAIN_PUDDLE_COVERAGE.comment = How much ground the puddles cover at full wetness. 0 disables wet ground while Rain Puddles is on.
option.RAIN_PUDDLE_SCALE_M = Puddle Pattern Size
option.RAIN_PUDDLE_SCALE_M.comment = Tiling size of the puddle pattern: larger = bigger puddles.
suffix.RAIN_PUDDLE_SCALE_M = \ m
option.RAIN_RIPPLE_STRENGTH = Ripple Strength
option.RAIN_RIPPLE_STRENGTH.comment = Strength of the ripple motion. 0 = off.
screen.POSTPROC = Post Processing
screen.POSTPROC.comment = Color grading, camera-lens effects and edge smoothing applied after the world is rendered.
screen.TONEMAP = Tone Mapping
screen.TONEMAP.comment = How scene brightness is compressed into your display's range. Pick a style and its presets.
screen.TONEMAP_OPENDRT = OpenDRT
screen.TONEMAP_OPENDRT.comment = Official OpenDRT v1.1.0 presets. Only used in OpenDRT mode.
screen.EXPOSURE = Exposure
screen.EXPOSURE.comment = Auto eye adaptation, a manual brightness offset, and the night-vision color effect.
screen.CAMERA = Camera & Effects
screen.CAMERA.comment = Lens-style effects: focus blur, motion smear and light-source glow.
screen.ANTIALIASING = Antialiasing
screen.TAA_SETTINGS = Temporal Antialiasing
screen.TAA_SETTINGS.comment = Settings shared by native TAA and Temporal Upscaling.
screen.ANTIALIASING.comment = Smooths jagged edges, then re-sharpens the image. TAA blends many frames; CAS is AMD FidelityFX sharpening.
screen.LIGHTING = Lighting
screen.LIGHTING.comment = Reflections, bounced sunlight, shadows, corner darkening and light brightness.
screen.REFLECTION = Reflections
screen.REFLECTION.comment = Screen-space reflections on solid surfaces: range, quality, and the blend into the sky sheen.
screen.GI = Global Illumination
screen.GI.comment = Bounced sunlight: light landing on one surface softly tints its surroundings, like a red carpet glowing onto nearby walls. SSGI traces it on screen; RSM (reflective shadow map) computes it from the sun's shadow map.
screen.AMBIENT = Ambient Light
screen.AMBIENT.comment = A guaranteed minimum light level and the brightness of block lights.
screen.SHADOWS = Shadows
screen.SHADOWS.comment = Shadow sharpness, realistic soft edges, and sunlight through leaves.
screen.PCSS = PCSS Soft Shadows
screen.PCSS.comment = Soft shadows whose edges blur with distance from the caster. PCSS = percentage-closer soft shadows; PCF = percentage-closer filtering. Applies while PCSS is on.
screen.SHADOW_DEPTH = Shadow Depth
screen.SHADOW_DEPTH.comment = Depth tolerance and the two boosts that cap how wide soft shadows may blur.
screen.PLANT_SSS = Plant Translucency
screen.PLANT_SSS.comment = Light passing through thin leaves and grass: bright tips and soft partial shade. SSS = subsurface scattering.
screen.CONTACT = Contact Shadows
screen.CONTACT.comment = Short screen-space shadows where objects meet the ground or a wall. Overworld and End only.
screen.AO = Ambient Occlusion
screen.AO.comment = Soft darkening in corners, crevices and where objects meet the ground. GTAO = horizon-based method; SSAO = hemisphere sampling.
screen.AO_GTAO = GTAO
screen.AO_GTAO.comment = Settings of the horizon-based method. Used while the AO mode is GTAO.
screen.AO_SSAO = SSAO
screen.AO_SSAO.comment = Settings of the hemisphere-sampling method: heavier but softer. Used while the AO mode is SSAO.
screen.AO_TEMPORAL_SETTINGS = AO History
screen.AO_TEMPORAL_SETTINGS.comment = How long AO history is trusted and how it reacts to motion. Used while temporal accumulation is on.
screen.ENVIRONMENT = Environment
screen.ENVIRONMENT.comment = Clouds, water and fog.
screen.SKY = Sky
screen.SKY.comment = Stars and the atmosphere at the horizon.
screen.CLOUDS = Clouds
screen.CLOUDS.comment = True 3D volumetric clouds: shape, motion and lighting.
screen.CLOUD_SHAPE = Cloud Shape
screen.CLOUD_SHAPE.comment = Layer height, sky coverage, weather pattern size and wind drift. Erosion detail lives in the per-mode sub-screens.
screen.CLOUD_SHAPE_LIGHT = Light Shape
screen.CLOUD_SHAPE_LIGHT.comment = Detail erosion of the light cloud field: one voronoise stage.
screen.CLOUD_SHAPE_HIGH = High-End Shape
screen.CLOUD_SHAPE_HIGH.comment = Two-stage erosion: a composite Worley volume shapes the broad forms, then voronoise adds detail.
screen.CLOUD_LIGHTING = Cloud Lighting
screen.CLOUD_LIGHTING.comment = Which light is traced and how far, plus the scattering that makes edges glow.
screen.CLOUD_MULTISCATTER = Cloud Multiple Scattering
screen.CLOUD_MULTISCATTER.comment = Light bouncing inside clouds so thick bodies stay bright. Sky-light term and cirrus equivalent live here too.
screen.CLOUD_QUALITY = Cloud Quality
screen.CLOUD_QUALITY.comment = Sampling budget, temporal upscaling and history length: cost versus stability.
screen.WATER = Water
screen.WATER.comment = Water reflections, wave detail and underwater light.
screen.WATER_SURFACE = Water Surface
screen.WATER_SURFACE.comment = Wave strength, parallax height, and reflection and parallax quality.
screen.FOG = Fog
screen.FOG.comment = Boundary fog that hides the edge of the loaded world. Overworld only.
screen.INFORMATION = Information
screen.INFORMATION.comment = Pack info: license, performance presets, setting help and debug views.
screen.DEBUG = Debug Views
screen.DEBUG.comment = Diagnostic views that replace part of the normal image. Keep defaults while playing.

#About / information (display-only pseudo options)
option.ABOUT = Vibroscat Alpha v0.3.0
option.ABOUT.comment = Vibroscat shaderpack by Huajijun, free open-source software under GPL-3.0.
value.ABOUT.0 = by Huajijun
option.INFO_LICENSE = License
option.INFO_LICENSE.comment = Vibroscat is distributed under GNU GPL-3.0: share and adapt it under the same license. See the LICENSE file and the bundled third-party notices.
value.INFO_LICENSE.0 = GNU GPL-3.0
option.INFO_PROFILE = Performance Presets
option.INFO_PROFILE.comment = The Profile button on the first page switches quality tiers. Each tier only changes performance-related settings.
value.INFO_PROFILE.0 = LOW - ULTRA
option.INFO_TOOLTIPS = Setting Help
option.INFO_TOOLTIPS.comment = Hover the mouse over any setting or category to read what it does.
value.INFO_TOOLTIPS.0 = Hover any setting

#Post: tonemapping
option.TONEMAP_MODE = Tone Mapping Mode
option.TONEMAP_MODE.comment = AgX-HSV, ACES 2.0, Blender AgX, OpenDRT or GT7 (default). GT7 uses the pack's calibrated SDR curve.
value.TONEMAP_MODE.0 = AgX-HSV
value.TONEMAP_MODE.1 = ACES 2.0
value.TONEMAP_MODE.2 = Blender AgX
value.TONEMAP_MODE.3 = OpenDRT
value.TONEMAP_MODE.5 = GT7
option.TONEMAP_EXPOSURE = Manual Exposure
option.TONEMAP_EXPOSURE.comment = Fixed brightness offset before auto exposure, in stops: +1.0 doubles brightness, -1.0 halves it.
option.PURKINJE_EFFECT = Purkinje Effect
option.PURKINJE_EFFECT.comment = Real human night vision: in darkness color vision fades toward bluish grey, so nights feel darker without losing light. Requires Auto Exposure.
option.PURKINJE_STRENGTH = Purkinje Strength
option.PURKINJE_STRENGTH.comment = Strength of the night-time color fade: 0 = off, 1 = full effect in the darkest scenes.

#Post: camera & effects
option.DOF = Depth of Field
option.DOF.comment = Blurs what the crosshair is not focused on, like a camera lens; the aimed-at spot stays sharp. Costs performance.
option.MOTION_BLUR = Motion Blur
option.MOTION_BLUR.comment = Slightly smears the image during fast movement, like a real camera sensor.
option.MB_STRENGTH = Motion Blur Strength
option.MB_STRENGTH.comment = Smear length: 0 = barely visible, 1 = strong trails.
option.BLOOM = Bloom
option.BLOOM.comment = Bright light bleeds a glow into its surroundings, like haze around a flame or glare toward the sun.
option.BLOOM_STRENGTH = Bloom Strength
option.BLOOM_STRENGTH.comment = Strength of the glow.
option.AE = Auto Exposure
option.AE.comment = Eye adaptation, like a phone camera's auto brightness: caves brighten gradually, sunlight dims the image. Off = one fixed manual brightness.
option.AE_TARGET_LUMINANCE = Auto Exposure Target Luminance
option.AE_TARGET_LUMINANCE.comment = The average brightness auto exposure aims for: lower = darker overall, higher = brighter. 0.18 is the standard neutral value.
option.AE_ADAPTATION_STRENGTH = Exposure Adaptation Strength
option.AE_ADAPTATION_STRENGTH.comment = How strongly exposure follows the scene: 0 = never reacts, 1 = every scene equalized to the same brightness, which flattens natural contrast. In between keeps some of it.

#Post: antialiasing
option.TAA = TAA
option.TAA.comment = Blends many frames to remove jagged edges. Effective but costs performance; fast objects can leave faint trails.
option.TAAU = Temporal Upscaling
option.TAAU.comment = Requires TAA. Renders the scene at lower resolution and reconstructs full-resolution output. Off by default.
option.TAAU_RENDER_SCALE = Render Scale
option.TAAU_RENDER_SCALE.comment = Scene resolution relative to the display: 50% shades one quarter of the pixels. Disable Temporal Upscaling for native resolution.
value.TAAU_RENDER_SCALE.0.50 = 50%
value.TAAU_RENDER_SCALE.0.59 = 59%
value.TAAU_RENDER_SCALE.0.67 = 67%
value.TAAU_RENDER_SCALE.0.75 = 75%
value.TAAU_RENDER_SCALE.0.85 = 85%
option.TAA_RECONSTRUCTION = Reconstruction Filter
option.TAA_RECONSTRUCTION.comment = Filter for the current-frame reconstruction: bilinear is cheaper, cubic keeps sharper detail.
value.TAA_RECONSTRUCTION.0 = Bilinear
value.TAA_RECONSTRUCTION.1 = Cubic
option.TAA_JITTER = Jitter Pattern
option.TAA_JITTER.comment = Sub-pixel sample sequence shared by all temporal effects. Halton 8 repeats a fixed 8-frame pattern and converges quickly; R2 does not repeat and settles more slowly.
value.TAA_JITTER.0 = Halton 8
value.TAA_JITTER.1 = R2
option.TAA_HISTORY_WEIGHT = History Weight
option.TAA_HISTORY_WEIGHT.comment = Maximum history contribution; motion and color rejection lower it. Higher = steadier image, slower response.
option.TAA_MOTION_REJECTION = Motion Response
option.TAA_MOTION_REJECTION.comment = How quickly history is reduced for fast-moving pixels. Higher = faster response, less smoothing in motion.
option.TAA_REACTIVE_STRENGTH = Color Change Response
option.TAA_REACTIVE_STRENGTH.comment = How strongly history is rejected where colors changed. 0.50 balances trails and noise.
option.TAA_DEBUG = TAA Debug View
option.TAA_DEBUG.comment = Requires TAA. Shows the spatial reconstruction or history rejection (red = fresh, green = history).
value.TAA_DEBUG.0 = Scene
value.TAA_DEBUG.1 = Spatial Reconstruction
value.TAA_DEBUG.2 = History Rejection
option.CAS = CAS Sharpening
option.CAS.comment = Light sharpening (AMD FidelityFX CAS) that restores crispness lost to antialiasing smoothing.
option.CAS_SHARPNESS = CAS Sharpness
option.CAS_SHARPNESS.comment = Sharpening strength: 0 = off; too high shows bright halos on edges.

#Post: color dither
option.COLOR_DITHER = Color Dither
option.COLOR_DITHER.comment = Adds fine grain that hides color banding in smooth sky, fog and shadow gradients. Off by default.
option.COLOR_DITHER_STRENGTH = Color Dither Strength
option.COLOR_DITHER_STRENGTH.comment = Grain strength: 0.5 = subtle, 1.0 = default, 2.0 = strongest de-banding but visible grain.

#Clouds: temporal upscaling values
value.CLOUD_TEMPORAL_UPSCALING.1 = 1x (Full)
value.CLOUD_TEMPORAL_UPSCALING.2 = 2x (1/2 res)
value.CLOUD_TEMPORAL_UPSCALING.3 = 3x (1/3 res)
value.CLOUD_TEMPORAL_UPSCALING.4 = 4x (1/4 res)

#Clouds: rendering
option.VOLUMETRIC_CLOUDS = Volumetric Clouds
option.VOLUMETRIC_CLOUDS.comment = Replaces flat cloud sprites with real 3D clouds that have depth and proper sunlight. One of the most expensive effects in the pack.
option.CIRRUS = Cirrus Clouds
option.CIRRUS.comment = Thin high-altitude cloud sheet with silver-lining lighting. Far cheaper than volumetric clouds and independent of them.
option.CLOUD_SINGLE_LIGHT = Single Light Trace
option.CLOUD_SINGLE_LIGHT.comment = Traces one merged sun/moon direction instead of both lights separately. Cheaper; sunset glow is kept by extending the sun's color below the horizon. Off = both lights traced separately, each lighting the layer from its own side.
option.CLOUD_TEMPORAL_UPSCALING = Temporal Upscaling
option.CLOUD_TEMPORAL_UPSCALING.comment = Renders clouds at reduced resolution and rebuilds detail across frames. 1x = sharpest and slowest; 4x = fastest, may smear during fast camera movement.
option.CLOUD_HISTORY_FRAMES = Cloud History Length Limit
option.CLOUD_HISTORY_FRAMES.comment = How many frames accumulated cloud history stays trusted: higher = steadier clouds, slower response to wind and view changes.
option.CLOUD_VIEW_MIN_STEPS = Minimum Steps
option.CLOUD_VIEW_MIN_STEPS.comment = Sampling quality for nearby clouds: higher = fewer holes on close edges, slower.
option.CLOUD_VIEW_MAX_STEPS = Maximum Steps
option.CLOUD_VIEW_MAX_STEPS.comment = Sampling quality for distant clouds: higher = detail holds farther toward the horizon, slower.
option.CLOUD_VIEW_TARGET_STEP_KM = Target Step Distance (km)
option.CLOUD_VIEW_TARGET_STEP_KM.comment = How densely the view ray scans the cloud layer: smaller = finer steps and smoother shapes, slower.
option.CLOUD_LIGHT_STEPS = Light Steps
option.CLOUD_LIGHT_STEPS.comment = How carefully sunlight is traced through each cloud: higher = better in-cloud light and shadow detail, slower.
option.CLOUD_LIGHT_START_OFFSET_KM = Light Start Offset
suffix.CLOUD_LIGHT_START_OFFSET_KM = \ km
option.CLOUD_LIGHT_START_OFFSET_KM.comment = Distance skipped toward the light before tracing a cloud's self-shadow: higher = broader bright rim on backlit clouds, less shadow detail near surfaces.
option.CLOUD_BASE_ALTITUDE = Base Altitude
option.CLOUD_BASE_ALTITUDE.comment = How high the cloud layer floats above the terrain: higher = clouds sit farther overhead.
suffix.CLOUD_BASE_ALTITUDE = \ km
option.CLOUD_THICKNESS_KM = Layer Thickness
suffix.CLOUD_THICKNESS_KM = \ km
option.CLOUD_THICKNESS_KM.comment = Vertical thickness of the cloud layer: higher = taller, towering clouds with deeper inner shadows.
option.CLOUD_DISTRIBUTION_SCALE_KM = Distribution Scale
suffix.CLOUD_DISTRIBUTION_SCALE_KM = \ km
option.CLOUD_DISTRIBUTION_SCALE_KM.comment = Size of the overall weather pattern: higher = larger, more sprawling cloud systems; lower = more, smaller clusters.
option.CLOUD_WIND_SPEED = Wind Speed
suffix.CLOUD_WIND_SPEED = \ km/s
option.CLOUD_WIND_SPEED.comment = How fast clouds drift across the sky.
option.CLOUD_FINE_WIND_FACTOR = Fine Wind Factor
option.CLOUD_FINE_WIND_FACTOR.comment = Makes small cloud details flow faster than the whole cloud, so clouds churn instead of just sliding by.
option.CLOUD_COVERAGE = Coverage
option.CLOUD_COVERAGE.comment = Sky coverage of the weather pattern: higher = wider, more connected clouds; lower = scattered clouds and more blue sky. Rain still forces full overcast.
option.CLOUD_DISTRIBUTION_UV_SCALE = Distribution Frequency
option.CLOUD_DISTRIBUTION_UV_SCALE.comment = Sampling frequency on the weather pattern: higher = smaller, more frequent weather cells.
option.CLOUD_FINE_EROSION_SCALE = Voronoise Scale
option.CLOUD_FINE_EROSION_SCALE.comment = Size of the fine erosion detail inside clouds: higher = smaller, denser detail.
option.CLOUD_FINE_EROSION_STRENGTH = Voronoise Shadow Strength
option.CLOUD_FINE_EROSION_STRENGTH.comment = Strength of that fine detail in the sunlight shading.
option.CLOUD_SHAPE_MODE = Cloud Shape Mode
option.CLOUD_SHAPE_MODE.comment = Light: one voronoise detail stage on the shared distribution (the current field). High-End: broad composite erosion first, voronoise detail second, at two extra 3D reads per sample.
value.CLOUD_SHAPE_MODE.0 = Light
value.CLOUD_SHAPE_MODE.1 = High-End
option.CLOUD_HQ_EROSION_SCALE_KM = Broad Erosion Scale
suffix.CLOUD_HQ_EROSION_SCALE_KM = \ km
option.CLOUD_HQ_EROSION_SCALE_KM.comment = World-space wrap of the composite erosion volume: higher = broader, smoother cloud bodies.
option.CLOUD_HQ_EROSION_STRENGTH = Broad Erosion Strength
option.CLOUD_HQ_EROSION_STRENGTH.comment = How strongly the composite volume erodes the broad forms: higher = more torn, sculpted bodies.
option.CLOUD_HQ_FINE_EROSION_SCALE = Voronoise Scale (High-End)
option.CLOUD_HQ_FINE_EROSION_SCALE.comment = Size of the fine detail inside high-end clouds: higher = smaller, denser detail.
option.CLOUD_HQ_FINE_EROSION_STRENGTH = Voronoise Strength (High-End)
option.CLOUD_HQ_FINE_EROSION_STRENGTH.comment = Strength of that fine detail in high-end shading.
option.CLOUD_HQ_FINE_EROSION_HEIGHT = Detail Height Ramp
option.CLOUD_HQ_FINE_EROSION_HEIGHT.comment = Normalized height at which high-end fine detail reaches full strength; keeps the cloud base smooth.
option.CLOUD_MS_SAT_ALBEDO = Scatter Saturation
option.CLOUD_MS_SAT_ALBEDO.comment = Brightness cap of the multiple-scattering approximation: higher = brighter, milkier cloud interiors.
option.CLOUD_ALPHA_EXTINCTION_SRGB_GRAY = Cloud Density
option.CLOUD_ALPHA_EXTINCTION_SRGB_GRAY.comment = How opaque a fully dense cloud sample is: higher = denser, more opaque clouds with deeper self-shadows.
option.CLOUD_LIGHT_MAX_DISTANCE_KM = Light Trace Distance
suffix.CLOUD_LIGHT_MAX_DISTANCE_KM = \ km
option.CLOUD_LIGHT_MAX_DISTANCE_KM.comment = How far sunlight is traced through a cloud for its self-shadow: higher = correct lighting deeper inside thick clouds, slower.
option.CLOUD_PHASE_FORWARD_G = Sunward Scatter Sharpness
option.CLOUD_PHASE_FORWARD_G.comment = The bright silver lining when looking toward the sun through clouds: higher = a tighter, brighter glow around the sun.
option.CLOUD_PHASE_BACKWARD_G = Backward Scatter Strength
option.CLOUD_PHASE_BACKWARD_G.comment = How bright clouds look with your back to the sun: higher = a stronger glow on clouds opposite the sun.
option.CLOUD_MS_ATTENUATION = Multi-Scatter Attenuation
option.CLOUD_MS_ATTENUATION.comment = How much light survives each bounce inside a cloud: higher = light penetrates deeper, brighter and softer shadowed interiors.
option.CLOUD_MS_CONTRIBUTION = Multi-Scatter Contribution
option.CLOUD_MS_CONTRIBUTION.comment = Energy added by each extra bounce: higher = brighter, milkier clouds.
option.CLOUD_MS_ECCENTRICITY = Multi-Scatter Eccentricity
option.CLOUD_MS_ECCENTRICITY.comment = How strongly the interior bounce glow concentrates toward the sun: higher = a stronger halo around the sun inside the cloud.
option.CLOUD_MS_ISOTROPIC = Multi-Scatter Fill Light
option.CLOUD_MS_ISOTROPIC.comment = Direction-independent fill light that keeps shadowed cloud interiors from going black: higher = brighter, milkier cores.
option.CLOUD_SKY_LIGHT_STRENGTH = Cloud Sky Light Strength
option.CLOUD_SKY_LIGHT_STRENGTH.comment = Ambient sky light received by both cloud layers: higher = brighter shadowed sides and undersides, a softer look.
option.CIRRUS_MS_ISOTROPIC = Cirrus Fill Light
option.CIRRUS_MS_ISOTROPIC.comment = Fill light bouncing inside the cirrus sheet, scaled by its density: higher = fuller, brighter cirrus with less contrast.
option.CLOUD_MILKYWAY_TRANSMISSION = Milky Way Cloud Transmission
option.CLOUD_MILKYWAY_TRANSMISSION.comment = How much of the Milky Way behind the clouds glows inside the layer: 1.0 = the physical total, 0 = off.
option.CIRRUS_MILKYWAY_TRANSMISSION = Milky Way Cirrus Transmission
option.CIRRUS_MILKYWAY_TRANSMISSION.comment = How much of the Milky Way behind the cirrus glows inside the sheet: 1.0 = the physical total, 0 = off.

#Shadows
option.SHADOW_PCSS = PCSS Shadows
option.SHADOW_PCSS.comment = Realistic soft shadows: the farther an object is above the surface below it, the blurrier its shadow edge, like real sunlight. Off = cheap hard-edged shadows.
option.shadowMapResolution = Shadow Map Resolution
option.shadowMapResolution.comment = Shadow map detail: higher = sharper edges that stay crisp farther away, at a significant performance cost.
option.sunPathRotation = Sun Path Rotation
option.sunPathRotation.comment = Tilt of the sun and moon path away from directly overhead, in degrees; the shadow projection tilts with it. 0 = the arc passes straight overhead; larger absolute values slant the arc and shift shadow directions.
option.shadowDistance = Shadow Distance
option.shadowDistance.comment = Radius the shadow map covers around the camera, in blocks: higher = shadows reach more distant terrain, at a higher shadow-pass cost.
option.SHADOW_BLOCKER_SAMPLES = PCSS Blocker Samples
option.SHADOW_BLOCKER_SAMPLES.comment = Precision of the height measurement behind the soft edge: higher = smoother, more stable soft edges, slower.
option.SHADOW_BLOCKER_SEARCH_TEXELS = PCSS Search Radius (texels)
option.SHADOW_BLOCKER_SEARCH_TEXELS.comment = How wide an area that measurement searches: higher = broader soft shadows, slower.
option.SHADOW_SUN_ANGULAR_RADIUS = Shadow Penumbra Angle
suffix.SHADOW_SUN_ANGULAR_RADIUS = \ rad
option.SHADOW_SUN_ANGULAR_RADIUS.comment = The assumed angular size of the sun that sets how wide soft shadows get: higher = softer shadows everywhere.
option.SHADOW_BLOCKER_DEPTH_TOLERANCE_M = Blocker Depth Tolerance
suffix.SHADOW_BLOCKER_DEPTH_TOLERANCE_M = \ m
option.SHADOW_BLOCKER_DEPTH_TOLERANCE_M.comment = Lets surfaces at nearly the same height count as the same ground. Reduces shadow speckle on stairs and fences; too high leaks shadows through thin objects. 0 = strictest.
option.SHADOW_PCF_MIN_SAMPLES = PCF Min Samples
option.SHADOW_PCF_MIN_SAMPLES.comment = Shadow edge smoothness in fully sunlit areas: higher = less grainy edges, slower.
option.SHADOW_PCF_MAX_SAMPLES = PCF Max Samples
option.SHADOW_PCF_MAX_SAMPLES.comment = Smoothness in the softest shadow regions: higher = cleaner large soft shadows, slower.
option.SHADOW_PCF_GAIN = PCF Sample Growth
option.SHADOW_PCF_GAIN.comment = How fast the sample count grows as shadows get softer: higher = better quality in soft regions, higher cost.
option.SHADOW_PENUMBRA_CAP_BOOST = Penumbra Cap Boost
option.SHADOW_PENUMBRA_CAP_BOOST.comment = Raises the maximum width soft shadows may reach. A fixed multiplier, the same at noon and sunset: higher = wider soft shadows, slower.
option.SHADOW_SSS = Plant Translucency (SSS)
option.SHADOW_SSS.comment = Light passing through thin plants: exposed tips brighten toward full sun, partial shadows turn soft, deep shadows stay dark.
option.SHADOW_SSS_STEPS = Plant Soft Shadow Samples
option.SHADOW_SSS_STEPS.comment = Shadow-map filter samples for plants while PCSS is on: higher = smoother soft edges, slower.
option.SHADOW_SSS_DENSITY = Plant Shadow Absorption
option.SHADOW_SSS_DENSITY.comment = Absorption along plant shadow rays: higher = darker overlaps, shorter partial shadows; lower = gentler, longer ones. Requires Contact Shadows.
option.SHADOW_SSS_SCALE = Plant Response Strength
option.SHADOW_SSS_SCALE.comment = Strength of the through-plant brightening: exposed tips approach full sun, fully occluded plants stay shaded.
option.SHADOW_SSS_PENUMBRA_BOOST = Plant Shadow Softness
option.SHADOW_SSS_PENUMBRA_BOOST.comment = Widens the shadow-map penumbra on plants. Requires PCSS.
option.SHADOW_SSS_ENERGY = Plant Light Compensation
option.SHADOW_SSS_ENERGY.comment = How far exposed thin plants approach fully lit brightness: raises back and side light without dimming the sunlit side.
option.SHADOW_SSS_DEBUG = SSS Debug View
option.SHADOW_SSS_DEBUG.comment = Requires Plant Translucency. Isolates the plant lighting boost, or its map confidence (green = map, red = fallback).
value.SHADOW_SSS_DEBUG.0 = Off
value.SHADOW_SSS_DEBUG.1 = Lighting Enhancement
value.SHADOW_SSS_DEBUG.2 = Map Confidence
value.SHADOW_SSS_DEBUG.3 = Plant Contact Visibility
value.SHADOW_SSS_DEBUG.4 = Map Visibility
option.SHADOW_SSS_PHASE_G = SSS Directionality
option.SHADOW_SSS_PHASE_G.comment = How much the grass highlight concentrates sunward; side views keep the broad response.
option.SHADOW_SSS_FADE_START = Shadow Fade Start
option.SHADOW_SSS_FADE_START.comment = Where the plant shadow map starts blending into the skylight approximation.
option.CONTACT_SHADOW = Screen-Space Contact Shadows
option.CONTACT_SHADOW.comment = Short screen-space shadows that close the gaps where objects meet the ground or a wall. Overworld and End only.
option.CONTACT_SHADOW_STEPS = Contact Shadow Steps
option.CONTACT_SHADOW_STEPS.comment = Quality of these small shadows: higher = fewer missed or speckled shadows, slower.
option.CONTACT_SHADOW_MAX_DISTANCE = Contact Shadow Distance
suffix.CONTACT_SHADOW_MAX_DISTANCE = \ m
option.CONTACT_SHADOW_MAX_DISTANCE.comment = Maximum reach in metres; actual reach also scales with your view distance.
option.CONTACT_SHADOW_THICKNESS = Contact Shadow Thickness
option.CONTACT_SHADOW_THICKNESS.comment = Assumed thickness of shadow casters: higher = more forgiving and softer; lower = sharper but can miss thin blockers.
option.CONTACT_SHADOW_DEBUG = Contact Shadow Debug View
option.CONTACT_SHADOW_DEBUG.comment = Requires Contact Shadows. Shows the raw shadow mask or an exaggerated darkness view. Overworld and End only.
value.CONTACT_SHADOW_DEBUG.0 = Off
value.CONTACT_SHADOW_DEBUG.1 = Raw Mask
value.CONTACT_SHADOW_DEBUG.2 = Exaggerated Darkness

#AO
option.AO_MODE = Ambient Occlusion Mode
option.AO_MODE.comment = Soft darkening in corners, crevices and where objects meet the ground. GTAO is the efficient standard; SSAO is heavier with a slightly different look. Off = no corner darkening.
value.AO_MODE.0 = Off
value.AO_MODE.1 = GTAO
value.AO_MODE.2 = SSAO
option.AO_TEMPORAL = Temporal Accumulation
option.AO_TEMPORAL.comment = Smooths the darkening across frames to remove grain. Off = grainier but reacts instantly.
option.GTAO_SLICES = GTAO Slices
option.GTAO_SLICES.comment = Quality of the AO calculation: higher = smoother and more accurate, slower.
option.GTAO_HORIZON_STEPS = GTAO Horizon Steps
option.GTAO_HORIZON_STEPS.comment = How far each direction scan looks: higher = catches larger nearby objects, slower.
option.GTAO_RADIUS = GTAO Radius
suffix.GTAO_RADIUS = \ m
option.GTAO_RADIUS.comment = World radius in metres. The on-screen radius is also capped at 5% of the shorter scene dimension.
option.GTAO_STRENGTH = GTAO Contrast
option.GTAO_STRENGTH.comment = How dark corners become: 1.0 is linear, higher darkens corners more steeply.
option.GTAO_MULTIBOUNCE = GTAO Multi-Bounce
option.GTAO_MULTIBOUNCE.comment = Bright surfaces bounce a little light back into corners, so dark corners pick up a slight tint instead of going black.
option.GTAO_FALLOFF_START = GTAO Falloff Start
option.GTAO_FALLOFF_START.comment = Where the darkening starts to fade within the radius: lower = tight contact lines, higher = more even spread.
option.AO_HISTORY_FRAMES = AO History Length Limit
option.AO_HISTORY_FRAMES.comment = How many frames are blended before a result counts as settled: higher = smoother, slower to react.
option.AO_HISTORY_DISTANCE_LIMIT = AO History Distance Limit
suffix.AO_HISTORY_DISTANCE_LIMIT = \ m
option.AO_HISTORY_DISTANCE_LIMIT.comment = Maximum depth mismatch allowed when reusing history: lower = less bleeding across surfaces, possibly more grain.
option.AO_HISTORY_NORMAL_DOT_FLOOR = AO History Normal Threshold
option.AO_HISTORY_NORMAL_DOT_FLOOR.comment = How strictly a surface must keep its facing for history reuse (cosine value; 0.866 = 30 degrees): higher = fewer smears when turning, possibly more grain.
option.SSAO_SAMPLES = SSAO Samples
option.SSAO_SAMPLES.comment = Quality of the SSAO mode: higher = smoother darkening, slower.
option.SSAO_RADIUS = SSAO Radius
suffix.SSAO_RADIUS = \ m
option.SSAO_RADIUS.comment = World radius in metres. The on-screen radius is also capped at 5% of the shorter scene dimension.
option.SSAO_STRENGTH = SSAO Contrast
option.SSAO_STRENGTH.comment = How dark corners become. SSAO reads lighter than GTAO, so its default is steeper. 1.0 is linear.

#Water
option.WATER_SURFACE_QUALITY = Water Surface Quality
option.WATER_SURFACE_QUALITY.comment = Low = small gentle waves. High = larger waves and finer surface detail at higher cost.
value.WATER_SURFACE_QUALITY.0 = Low
value.WATER_SURFACE_QUALITY.1 = High
option.WATER_SSR = Water Reflections
option.WATER_SSR.comment = Water reflects the actual world in front of it - mountains, buildings, trees - instead of only the sky.
option.WATER_SSR_STEPS = Water Reflection Steps
option.WATER_SSR_STEPS.comment = Depth samples along the reflection ray: higher = reflections reach farther with fewer broken areas, slower.
option.WATER_POM = Water Parallax
option.WATER_POM.comment = Gives waves real 3D depth: they rise and shift as you move past. Off = flat water with painted-on waves.
option.WATER_POM_COARSE_STEPS = POM Coarse Steps
option.WATER_POM_COARSE_STEPS.comment = Quality of the wave-depth search: higher = more accurate relief, slower.
option.WATER_POM_BISECT_STEPS = POM Bisection Steps
option.WATER_POM_BISECT_STEPS.comment = Refinement passes that sharpen the relief: higher = crisper crests, slower.
option.WATER_RIVER_GAIN = Water Wave Height
option.WATER_RIVER_GAIN.comment = Wave strength for both modes, and parallax height on Low. High has its own parallax height control.
option.WATER_LARGE_POM_HEIGHT = Large Wave Parallax Height
suffix.WATER_LARGE_POM_HEIGHT = x
option.WATER_LARGE_POM_HEIGHT.comment = High quality only: scales the parallax relief. 1.0 = default, 0 = flat. Does not change normal strength.

#Fog
option.BOUNDARY_FOG = Boundary Fog
option.BOUNDARY_FOG.comment = Fades distant terrain into the sky so the loaded-chunk edge is not a hard wall.
option.BOUNDARY_FOG_START = Boundary Fog Start
option.BOUNDARY_FOG_START.comment = Where the fade begins as a fraction of render distance: higher = hugs the visible edge, lower = terrain fades earlier.
option.BOUNDARY_FOG_STRENGTH = Boundary Fog Strength
option.BOUNDARY_FOG_STRENGTH.comment = Opacity of the edge haze.
option.BOUNDARY_FOG_HEIGHT_FADE = Boundary Fog Height Fade
option.BOUNDARY_FOG_HEIGHT_FADE.comment = How much the haze weakens toward the sky, so the horizon is masked without a milky sky overhead.

#Lighting
option.OPAQUE_REFLECTION = Solid Surface Reflections
option.OPAQUE_REFLECTION.comment = Shiny solid blocks reflect the actual scene around them. Off = only a generic sky-based sheen.
option.OPAQUE_SSR_STEPS = Opaque Reflection Steps
option.OPAQUE_SSR_FILTER = Reflection Denoising
option.OPAQUE_SSR_FILTER.comment = Temporally denoises solid reflections independently of TAA. Moving surfaces use shorter history.
value.OPAQUE_SSR_FILTER.0 = Off
value.OPAQUE_SSR_FILTER.1 = Temporal
option.OPAQUE_SSR_DEMODULATION = Reflection Material Detail
option.OPAQUE_SSR_DEMODULATION.comment = Separates the stable material color before denoising and restores it afterwards, preserving metal colors and material detail.
option.OPAQUE_SSR_COLOR_MIPS = Reflection Color Mips (Exp.)
option.OPAQUE_SSR_COLOR_MIPS.comment = Filters reflection history by roughness and hit distance: reduces sparkling, at a small GPU and memory cost; bright silhouettes may bleed.
value.OPAQUE_SSR_COLOR_MIPS.0 = Off
value.OPAQUE_SSR_COLOR_MIPS.1 = Generate Only
value.OPAQUE_SSR_COLOR_MIPS.2 = Roughness Filter
option.OPAQUE_SSR_COLOR_MIP_SCALE = Reflection Mip Footprint
option.OPAQUE_SSR_COLOR_MIP_SCALE.comment = Size of the roughness-based filtering area: larger = smoother reflections, more detail loss and color bleed.
option.OPAQUE_SSR_COLOR_MIP_MAX = Maximum Reflection Mip
option.OPAQUE_SSR_COLOR_MIP_MAX.comment = Caps the filtering level for distant hits: higher = wider filtering at range.
value.OPAQUE_SSR_COLOR_MIP_MAX.2 = 2
value.OPAQUE_SSR_COLOR_MIP_MAX.3 = 3
value.OPAQUE_SSR_COLOR_MIP_MAX.4 = 4
value.OPAQUE_SSR_COLOR_MIP_MAX.5 = 5
option.OPAQUE_SSR_STEPS.comment = Depth samples along the reflection ray: higher values mainly extend how far reflections reach.
option.SSR_INTERPOLATION = SSR Hit Refinement
option.SSR_INTERPOLATION.comment = Refines where the reflection ray hits the surface, so hits land closer to the real geometry. Off reports the raw march sample.
option.SSR_QUARTER_DEPTH = Quarter-Resolution SSR Depth
option.SSR_QUARTER_DEPTH.comment = Reflections use a reduced depth buffer: faster, but small silhouettes are less accurate. Off = full depth.
option.OPAQUE_REFLECTION_ROUGHNESS_THRESHOLD = Surface Roughness Cutoff
option.OPAQUE_REFLECTION_ROUGHNESS_THRESHOLD.comment = How matte a surface may be and still mirror the scene: higher = more surfaces get real reflections (more cost); lower = only near-mirrors.
option.OPAQUE_REFLECTION_ROUGHNESS_TRANSITION = Surface Roughness Blend
option.OPAQUE_REFLECTION_ROUGHNESS_TRANSITION.comment = Width of the blend between real reflections and the sky sheen, so surfaces do not pop between the two.
option.GI_MODE = Global Illumination Mode
option.GI_MODE.comment = Bounced sunlight that softly tints its surroundings, like a red carpet glowing onto walls. SSGI computes it on screen; RSM computes it from the sun's shadow map, more stable over a wider area. Both fill gaps with sky light.
value.GI_MODE.0 = None
value.GI_MODE.1 = SSGI
value.GI_MODE.2 = Reflective Shadow Map
option.PARTICLE_FORWARD = Forward Opaque Particles
option.PARTICLE_FORWARD.comment = Renders opaque particles with forward lighting after the deferred pass instead of feeding them into the GBuffer, so they no longer disturb GI and ambient occlusion. Particles lose deferred-only shading. Host dependent: some Iris versions keep the old draw order.
screen.SSGI = Screen Space GI
screen.RSM = Reflective Shadow Map
option.RSM_SAMPLES = RSM Samples
option.RSM_SAMPLES.comment = Bounce samples per half-resolution GI pixel per frame, default 8: higher = better newly exposed regions, slower.
option.RSM_RADIUS = RSM Radius
suffix.RSM_RADIUS = \ m
option.RSM_RADIUS.comment = How wide an area each pixel gathers bounce light from: higher = broader, softer color bleeding.
option.SSGI_STEPS = SSGI Steps
option.SSGI_STEPS.comment = Depth samples traced per half-resolution GI pixel, default 16: higher = better trace detail, slower.
option.SSGI_MARCH_PIXELS = SSGI March Width Cap
suffix.SSGI_MARCH_PIXELS = \ px
option.SSGI_MARCH_PIXELS.comment = How far the bounce ray may travel across the screen: higher = bounce light reaches farther, slower.
option.SSGI_THICKNESS = SSGI Thickness
suffix.SSGI_THICKNESS = \ m
option.SSGI_THICKNESS.comment = Assumed thickness of hit surfaces: higher = thin geometry blocks bounce light (less leak); lower = more light passes through.
option.SSGI_RADIANCE_LIMIT = SSGI Radiance Limit
option.SSGI_RADIANCE_LIMIT.comment = Caps the stored bounce light: lower = fewer bright firefly sparkles, dimmer bounce highlights.
option.RSM_STRENGTH = RSM Strength
option.RSM_STRENGTH.comment = Intensity of the bounced sunlight. Direct sun and sky ambient are unaffected.
option.RSM_DIRECTIONAL_SKY = Directional Sky Light
option.RSM_DIRECTIONAL_SKY.comment = Lets nearby walls and overhangs affect which sky colors reach a surface. Requires RSM GI and GTAO in the Overworld. Adds GPU cost; on by default.
value.RSM_SAMPLES.8 = 8
value.RSM_SAMPLES.16 = 16
value.RSM_SAMPLES.32 = 32
value.RSM_SAMPLES.64 = 64
value.RSM_RADIUS.2.0 = 2.0
value.RSM_RADIUS.4.0 = 4.0
value.RSM_RADIUS.8.0 = 8.0
value.RSM_RADIUS.12.0 = 12.0
value.RSM_RADIUS.16.0 = 16.0
value.RSM_RADIUS.24.0 = 24.0
value.RSM_STRENGTH.0.0 = 0.0
value.RSM_STRENGTH.0.25 = 0.25
value.RSM_STRENGTH.0.5 = 0.5
value.RSM_STRENGTH.0.75 = 0.75
value.RSM_STRENGTH.1.0 = 1.0
value.RSM_STRENGTH.1.5 = 1.5
value.RSM_STRENGTH.2.0 = 2.0
value.RSM_STRENGTH.2.5 = 2.5
value.RSM_STRENGTH.3.0 = 3.0
value.RSM_DEBUG.0 = Normal View
value.RSM_DEBUG.1 = Reconstructed Irradiance
option.RSM_DEBUG = RSM Debug View
option.RSM_DEBUG.comment = Requires RSM GI. Shows normal lighting or the denoised bounce light.
option.AMBIENT_FLOOR = Minimum Ambient Light
option.AMBIENT_FLOOR.comment = A guaranteed minimum light on every surface, so unlit caves keep slight visibility instead of pure black. 0 = fully realistic darkness.
option.SKY_AMBIENT_STRENGTH = Sky Ambient Strength
option.SKY_AMBIENT_STRENGTH.comment = Brightness of the sky's ambient light on surfaces: lowering it dims the fill on shaded sides; direct sunlight is unaffected.
option.TORCH_BRIGHTNESS = Block Light Brightness
option.TORCH_BRIGHTNESS.comment = Brightness of every block light: torches, lanterns, glowstone, lava and more. They share one warm tint; the tint itself does not change.
option.STAR_MAP_INTENSITY = Star Brightness
option.STAR_MAP_INTENSITY.comment = Brightness of the stars, drawn from a 4K NASA star map. 0 = starless sky.
option.STAR_MAP_CONTRAST = Star Contrast
option.STAR_MAP_CONTRAST.comment = Contrast between faint and bright stars: below 1.0 lifts the faint Milky Way, above 1.0 keeps only bright stars.
option.STAR_MAP_BRIGHT_BOOST = Bright Star Boost
option.STAR_MAP_BRIGHT_BOOST.comment = Extra brightness for the brightest stars, so prominent stars stand out.
option.ATM_HORIZON_DIP = Horizon Dip
option.ATM_HORIZON_DIP.comment = Extends the atmosphere below the ground line, thickening the haze band so distant terrain melts into the horizon.
option.ATM_HORIZON_DIP_SCALE = Horizon Dip Depth (km)
option.ATM_HORIZON_DIP_SCALE.comment = How deep the horizon atmosphere extends: higher = thicker horizon haze.



screen.TONEMAP_BLENDER_AGX = Blender AgX
