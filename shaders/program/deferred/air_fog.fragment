
/* RENDERTARGETS: 0 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/sky_light_data.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/atmosphere/air_fog.glsl"
#include "/lib/atmosphere/atmosphere_geometry.glsl"
#include "/lib/atmosphere/core.glsl"
#include "/lib/atmosphere/sky_light.glsl"
#include "/lib/atmosphere/sky_lut.glsl"
#include "/lib/color/color.glsl"
#include "/lib/lighting/ambient_light.glsl"
#include "/lib/scattering/phase.glsl"
#include "/lib/volume/air_epipolar.glsl"
#include "/lib/volume/epipolar_core.glsl"

layout(location = 0) out vec3 out_color;

// Boundary fog: fade near-boundary geometry into the cloud-free sky so the
// loaded-area edge is masked instead of cutting off. Returns scene blended
// toward the sky color; sky pixels (depth >= 1.0) are returned unchanged.
vec3 ApplyBoundaryFog(vec3 scene, vec3 scene_pos, vec3 world_dir, float scene_depth, float radius) {
#ifdef BOUNDARY_FOG
    if (scene_depth < 1.0) {
        float boundary_horizontal = length(scene_pos.xz - EyePositionSceneSpace().xz);
        float boundary_ratio = boundary_horizontal / radius;
        float boundary_edge = smoothstep(BOUNDARY_FOG_START, 1.0, boundary_ratio);
        boundary_edge *= boundary_edge;
        float boundary_up = smoothstep(0.0, 0.15, world_dir.y);
        float boundary_amount = min(
            boundary_edge * BOUNDARY_FOG_STRENGTH *
                (1.0 - boundary_up * BOUNDARY_FOG_HEIGHT_FADE),
            1.0);
        if (boundary_amount > 0.0) {
            // Cloud-free sky LUT sampled along the actual view direction.
            vec3 sun_dir = normalize(u_world_sun_dir);
            vec2 sky_uv = SkyLUTUV(world_dir, sun_dir, ATM_PLANET_R, u_cam_altitude);
            vec3 boundary_color = texture(usam_skylut, sky_uv).rgb;
            scene = mix(scene, boundary_color, boundary_amount);
        }
    }
#endif
    return scene;
}

// Effective optical depth of the weather sheet. colortex11 carries the weather
// texture colour in RGB and the coverage in A, and the weather pass writes
// neither depth nor the G-buffer, so the sheet owns no normal, material, or
// depth of its own and is lit as a thin scattering layer instead of a surface.
// This constant folds its path length into the texture colour: at 4.0 a
// daytime sheet under an open sky reads at about the radiance of the sky it is
// seen against, so streaks stay translucent instead of turning into dark
// scratches or a flat grey wash.
const float WEATHER_SHEET_OPTICAL_DEPTH = 4.0;

void main() {
    vec2 uv = gl_FragCoord.xy * u_view_pixel_size;
    ivec2 tx = ivec2(gl_FragCoord.xy);
    vec3 scene = texelFetch(colortex0, tx, 0).rgb;

#ifndef AIR_FOG
    out_color = scene;
    return;
#endif
    if (isEyeInWater == 1) {
        out_color = scene;
        return;
    }

    vec3 epipolar_light = vec3(1.0);
#ifdef EPIPOLAR_VOLUMETRICS
    float air_key = EpipolarAirColumnKey(uv, ivec2(gl_FragCoord.xy));
    epipolar_light = EpipolarSampleE(uv * 2.0 - 1.0, air_key);
#endif

    float scene_depth = texelFetch(depthtex0, tx, 0).r;
    vec3 view_pos = NDCToView(vec3(uv * 2.0 - 1.0, scene_depth * 2.0 - 1.0));
    float view_len = length(view_pos);
    vec3 scene_pos = ViewToSceneSpace(view_pos);
    // Eye-accurate view direction: depth reconstruction is feet-space and
    // the eye sits at gbufferModelViewInverse[3] (~1.62 m up standing).
    vec3 world_dir = normalize(scene_pos - EyePositionSceneSpace());

    // Boundary fog: fade near-boundary geometry into the cloud-free sky so the
    // loaded-area edge is masked instead of cutting off. Applied here, before
    // the epipolar air fog, so the sky tint and the analytic fog stack. Sky
    // pixels (depth >= 1.0) keep the actual sky and are left untouched.
    scene = ApplyBoundaryFog(scene, scene_pos, world_dir, scene_depth, far);

    float shadow_fallback = 1.0;
#ifdef AIR_FOG_SHADOWS
#ifndef EPIPOLAR_VOLUMETRICS
    shadow_fallback = texture(shadowtex1, ProjectToShadow(scene_pos));
#endif
#endif

    // Chunk-edge approximation: clamp the march to the far plane (sphere of
    // radius far).
    float fog_end = far;
    float depth_dist = scene_depth >= 1.0 ? fog_end : min(view_len, fog_end);

    AirFogMedium medium = AirFogMediumAtCamera();
    AirFogResult fog = AirFogRender(world_dir, depth_dist, fog_end, medium,
                                    epipolar_light, shadow_fallback);


    out_color = scene * fog.transmittance + fog.in_scattering;

    // Weather sheet: rain and snow scatter the light around them rather than
    // reflecting it, so the sheet gets no BRDF, no shadow map, and no specular
    // term. Ambient is the up-facing sky irradiance (an airborne sheet is lit
    // from the hemisphere above it) scattered isotropically, the same 1/(4 pi)
    // phase lib/atmosphere/air_fog.glsl applies to its own multiple scattering.
    // Direct light arrives through a Mie lobe, which is what makes streaks
    // glow when the light sits behind them. Compositing happens after the haze
    // because the sheet hangs within a few blocks of the camera, where the air
    // column in front of it carries no visible extinction.
    vec4 weather = texelFetch(colortex11, tx, 0);
    if (weather.a > 0.0) {
        // Sky access behind the sheet: the opaque G-buffer still owns the
        // lightmap here, and sky pixels (depth >= 1.0) keep stale data there
        // while being unobstructed by definition. No AMBIENT_BASE floor is
        // added, so a sheet the sky does not reach stays dark, which is what
        // keeps rain out of caves and interiors.
        float weather_lm_sky = 1.0;
        if (scene_depth < 1.0) weather_lm_sky = texelFetch(colortex4, tx, 0).a;

        float weather_cos_theta = dot(world_dir, normalize(u_world_light_dir));
        vec3 weather_scattering = EvalSkyLight(vec3(0.0, 1.0, 0.0))
                * SkyLightFromLm(weather_lm_sky) * PHASE_ISOTROPIC
            + ground_light.rgb * PhaseHenyeyGreenstein(weather_cos_theta, 0.5);
        vec3 weather_radiance = ToLinear(weather.rgb) * weather_scattering
            * WEATHER_SHEET_OPTICAL_DEPTH;
        out_color = mix(out_color, weather_radiance, weather.a);
    }
}
