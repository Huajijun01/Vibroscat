#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/post/bloom.glsl"
#include "/lib/post/bloom_downsample.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f) uniform restrict writeonly image2D colorimg12;

void main() {
#ifdef BLOOM
    ivec2 full_size = imageSize(colorimg12);
    ivec2 dst_size = GetBloomMipSize(full_size, 1);
    vec2 pixel_size = 1.0 / vec2(full_size);
    vec2 src_min = vec2(0.5);
    vec2 src_max = vec2(full_size) - 0.5;
    ivec2 group_base = ivec2(gl_WorkGroupID.xy) * 32;
    for (uint index = gl_LocalInvocationIndex; index < 630u; index += 256u) {
        int row = int(index / 18u);
        int column = int(index % 18u);
        vec2 sample_texel = vec2(group_base + ivec2(column * 2 + (row & 1), row) - 1);
        vec2 sample_uv = clamp(sample_texel, src_min, src_max) * pixel_size;
#if defined(MOTION_BLUR) || TAA_DEBUG > 0
        vec3 value = textureLod(colortex0, sample_uv, 0.0).rgb;
#else
        vec3 value = textureLod(colortex5, sample_uv, 0.0).rgb;
#endif
        StoreBloomDownTile(ivec2(column, row), max(value, vec3(0.0)));
    }
    barrier();
    ivec2 dst_coord = ivec2(gl_GlobalInvocationID.xy);
    if (all(lessThan(dst_coord, dst_size))) {
        imageStore(colorimg12, dst_coord, vec4(FilterBloomDownTile(ivec2(gl_LocalInvocationID.xy)), 0.0));
    }
#endif
}
