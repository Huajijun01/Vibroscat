// Phase 2: combine log statistics and percentiles, then update the adapted
// exposure. A geometric mean models the retina's approximately logarithmic
// response; the median rejects small bright/dark outliers and P90 preserves
// highlight headroom. The log-average/key-value approach follows Reinhard et
// al., "Photographic Tone Reproduction for Digital Images" (SIGGRAPH 2002).

#include "/lib/contract/exposure_data.glsl"
#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"

layout(local_size_x = 64) in;
const ivec3 workGroups = ivec3(1, 1, 1);

const float AE_REFERENCE_LUMINANCE = 0.18;
const float AE_HIGHLIGHT_HEADROOM = 0.80;
const float AE_MIN_EXPOSURE = 1.0 / 32.0;
const float AE_MAX_EXPOSURE = 32.0;

shared float cache[64];
shared uint histogram_cache[64];

float HistogramPercentile(float fraction, uint total_weight) {
    uint threshold = uint(float(total_weight) * fraction);
    uint cumulative = 0u;
    for (uint i = 0u; i < 64u; ++i) {
        cumulative += histogram_cache[i];
        if (cumulative >= threshold) {
            return -12.0 + (float(i) + 0.5) * (20.0 / 64.0);
        }
    }
    return 8.0;
}

void main() {
    uint tid = gl_LocalInvocationIndex;

    cache[tid] = log_lum_sums[tid];
    uint histogram_sum = 0u;
    for (uint group = 0u; group < 64u; ++group) {
        histogram_sum += luminance_histogram[group * 64u + tid];
    }
    histogram_cache[tid] = histogram_sum;
    barrier();

    for (uint s = 32u; s > 0u; s >>= 1u) {
        if (tid < s) cache[tid] += cache[tid + s];
        barrier();
    }

    if (tid == 0u) {
        float total_weight = 0.0;
        for (uint i = 0u; i < 64u; ++i) total_weight += weight_sums[i];
        total_weight = max(total_weight, 1.0);
        float log_average = cache[0] / total_weight;
        uint histogram_weight = 0u;
        for (uint i = 0u; i < 64u; ++i) histogram_weight += histogram_cache[i];
        histogram_weight = max(histogram_weight, 1u);

        float median_ev = HistogramPercentile(0.50, histogram_weight);
        float p90_ev = HistogramPercentile(0.90, histogram_weight);
        float key_ev = mix(log_average - log2(AE_REFERENCE_LUMINANCE), median_ev, 0.35);
        float key_lum = exp2(key_ev) * AE_REFERENCE_LUMINANCE;
        float scene_ev = log2(max(key_lum, 1.0e-4) / AE_REFERENCE_LUMINANCE);
        float target_exposure = (AE_TARGET_LUMINANCE / AE_REFERENCE_LUMINANCE)
            * exp2(-AE_ADAPTATION_STRENGTH * scene_ev);
        float p90_lum = AE_REFERENCE_LUMINANCE * exp2(p90_ev);
        target_exposure = min(target_exposure, AE_HIGHLIGHT_HEADROOM / max(p90_lum, 1.0e-4));
        target_exposure = clamp(target_exposure, AE_MIN_EXPOSURE, AE_MAX_EXPOSURE);
        float target_exposure_ev = log2(target_exposure);

        // Bright adaptation is quick; dark adaptation is deliberately slower,
        // matching the asymmetric cone/rod response of the human eye.
        if (frameCounter < 2) {
            adapted_exposure_ev = target_exposure_ev;
        } else {
            float rate_per_sec = target_exposure_ev < adapted_exposure_ev ? 4.0 : 0.8;
            float w = 1.0 - exp(-max(frameTime, 0.0) * rate_per_sec);
            adapted_exposure_ev = mix(adapted_exposure_ev, target_exposure_ev, clamp(w, 0.0, 1.0));
        }
        exposure = exp2(adapted_exposure_ev);
    }
}
