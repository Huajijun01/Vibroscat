
/* RENDERTARGETS: 0 */

#define EPIPOLAR_POLE_VARYING

// Read by the shared epipolar library under EPIPOLAR_POLE_VARYING.
flat in vec2 v_epipolar_pole;
flat in int v_epipolar_pole_in_screen;

#include "/lib/contract/settings.glsl"
#include "/lib/contract/sky_light_data.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/render_scale.glsl"
#include "/lib/atmosphere/air_fog.glsl"
#include "/lib/atmosphere/atmosphere_geometry.glsl"
#include "/lib/atmosphere/sky_light.glsl"
#include "/lib/atmosphere/sky_lut.glsl"
#include "/lib/lighting/lightmap.glsl"
#include "/lib/scattering/phase.glsl"
#include "/lib/volume/epipolar_core.glsl"

layout(location = 0) out vec3 out_color;

// Masks the loaded-area edge by fading geometry into the cloud-free sky.
#ifdef BOUNDARY_FOG
vec3 ApplyBoundaryFog(vec3 scene, vec3 world_pos, vec3 world_dir, float scene_depth, float radius) {
    if (scene_depth < 1.0) {
        float boundary_horizontal = length(world_pos.xz - EyePositionWorldSpace().xz);
        float boundary_ratio = boundary_horizontal / radius;
        float boundary_edge = smoothstep(BOUNDARY_FOG_START, 1.0, boundary_ratio);
        boundary_edge *= boundary_edge;
        float boundary_up = smoothstep(0.0, 0.15, world_dir.y);
        float boundary_amount = saturate(
            boundary_edge * BOUNDARY_FOG_STRENGTH *
                (1.0 - boundary_up * BOUNDARY_FOG_HEIGHT_FADE));
        if (boundary_amount > 0.0) {
            // Cloud-free sky LUT.
            vec2 sky_uv = SkyLUTUV(world_dir, u_world_sun_dir);
            vec3 boundary_color = texture(usam_skylut, sky_uv).rgb;
            scene = mix(scene, boundary_color, boundary_amount);
        }
    }
    return scene;
}
#endif

// Weather sheet (colortex4): RGB = linear sheet color premultiplied by coverage, A = coverage.
const float WEATHER_SHEET_OPTICAL_DEPTH = 4.0;

void main() {
#if defined(TAAU_ACTIVE)
    if (OutsideSceneRender(gl_FragCoord.xy)) discard;
#endif
    vec2 uv = gl_FragCoord.xy * u_render_pixel_size;
    ivec2 tx = ivec2(gl_FragCoord.xy);
    vec3 scene = texelFetch(colortex0, tx, 0).rgb;

    if (isEyeInWater == 1) {
#if defined(WATER_EPIPOLAR_ACTIVE)
        float water_depth = texelFetch(depthtex0, tx, 0).r;
        vec3 shafts = SampleEpipolarTerm(uv * 2.0 - 1.0,
            LinearDepthFromScreenDepth(water_depth), vec3(0.0));
        scene += shafts;
#endif
        out_color = scene;
        return;
    }

    float scene_depth = texelFetch(depthtex0, tx, 0).r;
    vec3 view_pos = NDCToView(vec3(uv * 2.0 - 1.0, scene_depth * 2.0 - 1.0));
    vec3 world_pos = ViewToWorldSpace(view_pos);
    // Depth reconstruction is feet-space; the eye sits ~1.62 m above it.
    vec3 world_dir = normalize(world_pos - EyePositionWorldSpace());

#ifdef BOUNDARY_FOG
    scene = ApplyBoundaryFog(scene, world_pos, world_dir, scene_depth, far);
#endif

#ifdef AIR_FOG
    float distance_m = length(world_pos - EyePositionWorldSpace());
    float length_m = AirFogSegmentLength(distance_m, far);
    vec3 visibility = vec3(1.0);
#if defined(AIR_EPIPOLAR_ACTIVE)
    visibility = SampleEpipolarTerm(uv * 2.0 - 1.0, LinearDepthFromScreenDepth(scene_depth), vec3(1.0));
#endif
    AirFogResult fog = AirFogRender(world_dir, length_m, AirFogProfile(), AirFogReferenceMedium(), visibility);
    scene = scene * mix(vec3(1.0), fog.transmittance, u_eye_sky_access) + fog.in_scattering * u_eye_sky_access;
#endif

    out_color = scene;

    // Rain/snow scatter light rather than reflecting it: isotropic ambient
    // plus a Mie direct lobe, no BRDF or shadow term.
    vec4 weather = texelFetch(colortex4, tx, 0);
    if (weather.a > 0.0) {
        float weather_cos_theta = dot(world_dir, u_world_light_dir);
        // Approximates EvalSkyLight(up): the axis kills x/z L1 and the mixed
        // L2 terms; the y^2 self term is dropped for cost.
        vec3 weather_scattering = max(
                vec3(sky_sh_r0.x, sky_sh_g0.x, sky_sh_b0.x) * (SH_Y0 * SH_A0)
              + vec3(sky_sh_r0.y, sky_sh_g0.y, sky_sh_b0.y) * (SH_Y1 * SH_A1),
                vec3(0.0)) * PHASE_ISOTROPIC
            + ground_light.rgb * PhaseHenyeyGreenstein(weather_cos_theta, 0.5);
        vec3 weather_radiance = weather.rgb * weather_scattering
            * WEATHER_SHEET_OPTICAL_DEPTH;
        // Premultiplied-over composite: another weather.a factor would square the coverage.
        out_color = out_color * (1.0 - weather.a) + weather_radiance;
    }
}
