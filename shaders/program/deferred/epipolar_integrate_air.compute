#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/atmosphere/air_fog.glsl"
#include "/lib/volume/air_epipolar.glsl"
#include "/lib/volume/epipolar_core.glsl"

layout(local_size_x = 1, local_size_y = 128) in;
// Iris parses workGroups with Integer.parseInt: literal only, no macros.
// Max 2048 slices; EPIPOLAR_SLICES / EPIPOLAR_SAMPLES are enforced by guards.
const ivec3 workGroups = ivec3(2048, 1, 1);

#ifdef EPIPOLAR_WATER
layout(rgba16f) uniform writeonly image2D uimg_epipolar_term;

// Air-fog integrate pass (composite2.csh, consumed by composite2.fsh
// air_fog): overwrites the water term written by composite1_a with the full
// RGB E and the air depth key.
void main() {
    uint slice = gl_WorkGroupID.x;
    if (slice >= uint(EPIPOLAR_SLICES)) return;
    vec4 line = texelFetch(usam_epipolar_endpoints, ivec2(int(slice), 0), 0);
    uint loop = uint((EPIPOLAR_SAMPLES + 127) / 128);
    for (uint i = 0u; i < loop; ++i) {
        uint sample_index = gl_LocalInvocationID.y + i * 128u;
        if (sample_index >= uint(EPIPOLAR_SAMPLES)) break;
        vec3 air_e = vec3(1.0);
        float air_key = 0.0;
        if (!all(equal(line, vec4(0.0)))) {
            float p = float(sample_index) / float(EPIPOLAR_SAMPLES - 1);
            vec2 ndc = mix(line.xy, line.zw, p);
            vec2 uv01 = ndc * 0.5 + 0.5;
            ivec2 texel = ivec2(clamp(uv01 * u_screen_res, vec2(0.5), u_screen_res - vec2(0.5)));

            // Air term: camera -> nearest visible surface, clamped to the
            // fog slab and the render-distance radius.
            if (isEyeInWater == 0) {
                float depth0 = texelFetch(depthtex0, texel, 0).r;
                air_key = EpipolarViewZ(uv01, depth0);
                vec3 air_start = EyePositionSceneSpace();
                vec3 air_end = EpipolarViewToScene(uv01, depth0);
                vec3 world_dir = normalize(air_end - air_start);
                float depth_dist = length(air_end - air_start);
                float S;
                if (AirFogSegment(depth_dist, far, S)) {
                    vec3 clamped_end = air_start + world_dir * S;
                    air_e = EpipolarAirShadowRatio(
                        air_start, clamped_end, AirExtinction(),
                        ivec2(int(slice), int(sample_index)));
                }
            }
        }
        imageStore(uimg_epipolar_term, ivec2(int(slice), int(sample_index)),
                   vec4(air_e, air_key));
    }
}
#else
void main() {}
#endif
