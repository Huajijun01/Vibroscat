// ============================================================================
// Unified GBuffer fill - all opaque gbuffer programs route here
// ============================================================================
//
// Program dispatch via #define (set in world*/ stub .fsh files):
//   PROGRAM_GBUFFERS_TERRAIN / _TERRAIN_SOLID / _TERRAIN_CUTOUT
//                                 terrain family (shared vertex branch)
//   PROGRAM_GBUFFERS_BLOCK        block-model programs (unmasked material id)
//   PROGRAM_GBUFFERS_ENTITIES     entities
//   PROGRAM_GBUFFERS_HAND         hand
//   PROGRAM_GBUFFERS_BEACONBEAM   beaconbeam
//   PROGRAM_GBUFFERS_SPIDEREYES   spidereyes
//   PROGRAM_GBUFFERS_PARTICLES    particles (opaque quad particles; world-up
//                                 dielectric surface, no PBR atlas)
//   PROGRAM_GBUFFERS_BASIC / _LINE / _TEXTURED / _TEXTURED_LIT
//                                 generic opaque class (material id 0)
//
// GBuffer layout:
//   colortex1.rgb = albedo (sRGB, decoded to linear in deferred pass)
//   colortex1.a   = material id / 255.0  (see lib/material/model.glsl for ranges)
//   colortex2 (RGBA8) = roughness / raw specular selector / emission / combined AO
//   colortex12.rg = octahedral-encoded shading world normal (FP16 workspace)
//   colortex12.ba = roughness / selector proxy; B=-1 marks the hand
//   colortex4.rg = octahedral-encoded geometric world normal
//   colortex4.zw = lightmap coordinates
//
// Coordinate-first lightmap: v_lmcoord carries an affine remap of the raw UV
// (clamp(x * 1.103449 - 0.0689656)); never sampled in the gbuffer pass
// (sampled in deferred).
//
// Attribute availability matrix:
//   at_tangent -> terrain, entities, block (but NOT hand, basic, textured, particles)
//   mc_Entity  -> terrain, block (NOT entities - the host supplies the batch
//                 entity id the vertex stage folds into the material id)
//
// The material id crosses the stage only for terrain, block and entities;
// every other class owns a compile-time constant below.
//
// Vertex variants (solid.vertex) selected by the same #defines.

/* RENDERTARGETS: 1,2,4,12 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/packing.glsl"
#include "/lib/core/render_scale.glsl"
#if defined(TERRAIN_DERIVATIVE_TBN_ACTIVE)
#include "/lib/geometry/fragment_position.glsl"
#endif
#include "/lib/material/model.glsl"
#if defined(RAIN_WETNESS_ACTIVE)
#include "/lib/material/rain_wetness.glsl"
#endif

in vec2 v_texcoord;
in vec2 v_lmcoord;
#ifdef PROGRAM_GBUFFERS_PARTICLES
in vec3 v_color;
#else
in vec4 v_color;
#endif
#if defined(GBUFFER_MATERIAL_ID_VARYING)
flat in int v_material_id;
#endif
#if !defined(PROGRAM_GBUFFERS_PARTICLES) && !defined(TERRAIN_DERIVATIVE_TBN_ACTIVE)
#if defined(GBUFFER_TERRAIN_ACTIVE)
flat in vec3 v_world_normal;
#else
in vec3 v_world_normal;
#endif
#endif
#if defined(HAS_AT_TANGENT) && !defined(TERRAIN_DERIVATIVE_TBN_ACTIVE)
#if defined(GBUFFER_TERRAIN_ACTIVE)
flat in vec3 v_world_tangent;
flat in vec3 v_world_bitangent;
#else
in vec3 v_world_tangent;
in vec3 v_world_bitangent;
#endif
#endif

layout(location = 0) out vec4 out_albedo_material;
layout(location = 1) out vec4 out_surface_material;
layout(location = 2) out vec4 out_geometry;
layout(location = 3) out vec4 out_shading_normal;

// Terrain programs do not alpha test, so they can run early depth tests.
#if defined(PROGRAM_GBUFFERS_TERRAIN) || defined(PROGRAM_GBUFFERS_TERRAIN_SOLID)
layout(early_fragment_tests) in;
#endif

void main() {
    // Derivatives are gathered before any discard or divergent return: the
    // helper invocations around an alpha-tested texel still belong to the
    // same primitive's neighborhood, but a 2x2 quad can straddle primitives,
    // so the values must not be requested inside the rejection branches.
#if defined(TERRAIN_DERIVATIVE_TBN_ACTIVE)
    vec3 surface_view_pos = ReconstructGbufferViewPosition(gl_FragCoord);
    vec3 position_dx = dFdx(surface_view_pos);
    vec3 position_dy = dFdy(surface_view_pos);
    vec2 uv_dx = dFdx(v_texcoord);
    vec2 uv_dy = dFdy(v_texcoord);
#endif
#if defined(TAAU_ACTIVE)
    if (OutsideSceneRender(gl_FragCoord.xy)) discard;
#endif
    vec4 albedo_tex = texture(gtexture, v_texcoord);

    // -- alpha test (controlled by USE_DISCARD in the gbuffer wrapper) --
#ifdef USE_DISCARD
    if (albedo_tex.a < 0.1) discard;
#endif

    // -- albedo = texture x vertex color --
    vec3 albedo = albedo_tex.rgb * v_color.rgb;

#if defined(GBUFFER_MATERIAL_ID_VARYING)
    int mat_id = v_material_id;
#elif defined(PROGRAM_GBUFFERS_HAND)
    int mat_id = 64;  // player hand / held item
#elif defined(PROGRAM_GBUFFERS_BEACONBEAM) || defined(PROGRAM_GBUFFERS_SPIDEREYES)
    int mat_id = 112; // emissive class
#else
    // basic, line, textured, textured_lit and particles share the generic
    // opaque class: no SSS, wetness, metal or emissive classification.
    int mat_id = 0;
#endif

    // -- program-specific overrides --
#ifdef PROGRAM_GBUFFERS_ENTITIES
    // entityColor is a tint overlay (e.g. sheep wool, dyed leather armor)
    albedo = mix(albedo, entityColor.rgb, entityColor.a);
#endif
#ifdef PROGRAM_GBUFFERS_BEACONBEAM
    if (albedo_tex.a < 0.5) discard;
#endif

    // -- Surface normal and material inputs --
#if defined(TERRAIN_DERIVATIVE_TBN_ACTIVE)
    // face_sign restores the primitive's intrinsic facing instead of forcing
    // backfaces toward the eye. The camera rotation preserves unit length, so
    // the transformed geometric normal keeps its normalization bits.
    float face_sign = gl_FrontFacing ? 1.0 : -1.0;
    vec3 normal_view = face_sign * normalize(cross(position_dx, position_dy));
    vec3 geo_normal_world = mat3(gbufferModelViewInverse) * normal_view;
#elif defined(PROGRAM_GBUFFERS_PARTICLES)
    // Particles are camera-facing sprites from a dedicated atlas: their mesh
    // normal would point at the eye, and the block normal and specular
    // atlases say nothing about them. Both their geometric and shading
    // normal are the world-up constant, so the deferred lighting agrees.
    vec3 geo_normal_world = vec3(0.0, 1.0, 0.0);
#else
    vec3 geo_normal_world = normalize(v_world_normal);
#endif
    vec3 w_normal = geo_normal_world;
#ifndef PROGRAM_GBUFFERS_PARTICLES
    // Iris binds a 1x1 fallback when the resource pack has no normal atlas.
    // Programs without at_tangent cannot interpret tangent-space normal maps.
    vec3 normal_tex = vec3(0.5, 0.5, 1.0);
    bool has_normal_texture = any(notEqual(textureSize(normals, 0), ivec2(1)));
    if (has_normal_texture) normal_tex = texture(normals, v_texcoord).rgb;
#if defined(TERRAIN_DERIVATIVE_TBN_ACTIVE)
    if (has_normal_texture) {
        // Full tangent basis from the position and UV Jacobians. Only the
        // determinant's sign survives: T is normalized and lies in the
        // geometric plane by construction, and B = cross(T, N) * handedness
        // matches the host bitangent convention, preserving mirrored and
        // rotated UV layouts. No Gram-Schmidt pass or repeated normalize.
        float uv_det = uv_dx.x * uv_dy.y - uv_dx.y * uv_dx.x;
        float uv_sign = sign(uv_det);
        vec3 tangent_view = normalize(position_dx * uv_dy.y
            - position_dy * uv_dx.y) * uv_sign;
        float tangent_handedness = -face_sign * uv_sign;
        vec3 bitangent_view = cross(tangent_view, normal_view) * tangent_handedness;
        vec3 ts_normal = DecodeLabPBR(normal_tex);
        vec3 shading_normal_view = tangent_view * ts_normal.x
            + bitangent_view * ts_normal.y + normal_view * ts_normal.z;
        w_normal = normalize(mat3(gbufferModelViewInverse) * shading_normal_view);
    }
#elif defined(HAS_AT_TANGENT)
    if (has_normal_texture) {
        mat3 tbn = mat3(v_world_tangent, v_world_bitangent, v_world_normal);
        vec3 ts_normal = DecodeLabPBR(normal_tex);
        w_normal = normalize(tbn * ts_normal);
    }
#endif

    float material_ao = 1.0;
#ifdef MC_TEXTURE_FORMAT_LAB_PBR
    material_ao = normal_tex.b;
#endif
    float combined_ao = min(v_color.a, material_ao);
#else
    // Particles shade as rough, non-metallic, non-emissive opaque surfaces
    // with no material AO and no wetness layer, so only the albedo, lightmap
    // and world-up normal carry real data and neither atlas is sampled at
    // the sprite UV.
    float combined_ao = 1.0;
#endif

    // -- Material from specular map --
    // The explicit zero default is rough, non-metallic and non-emissive.
    vec4 spec_tex = vec4(0.0);
#ifndef PROGRAM_GBUFFERS_PARTICLES
    if (any(notEqual(textureSize(specular, 0), ivec2(1)))) spec_tex = texture(specular, v_texcoord);
#endif
    OpaqueMaterial mat = DecodeOpaqueMaterial(spec_tex);

#ifdef PROGRAM_GBUFFERS_BEACONBEAM
    mat.emission = 1.0;
#endif
#ifdef PROGRAM_GBUFFERS_SPIDEREYES
    mat.emission = 1.0;
#endif

#if defined(RAIN_WETNESS_ACTIVE) && !defined(PROGRAM_GBUFFERS_PARTICLES)
    ApplyRainWetness(
#if defined(TERRAIN_DERIVATIVE_TBN_ACTIVE) && defined(RAIN_WETNESS_POSITION_ACTIVE)
        surface_view_pos,
#endif
        geo_normal_world.y, v_lmcoord.y, mat_id, mat, w_normal, albedo);
#endif

    // -- Write GBuffer --
    out_albedo_material.rgb = albedo;
    out_albedo_material.a   = float(mat_id) / 255.0;
    // Floor-quantize to the 8-bit attachment grid, preserving the LabPBR
    // selector category boundaries, before the RGBA8 stores these scalars.
    out_surface_material = floor(saturate(vec4(mat.perceptual_roughness, mat.specular_selector,
        mat.emission, combined_ao)) * 255.0) * (1.0 / 255.0);
    // colortex4 (RGBA8): octahedral world-space geometric normal in RG,
    // lightmap in BA. World space keeps the stored value camera-independent:
    // a view-space normal requantizes whenever the view turns, and that
    // staircase reaches AO, contact shadows, the shadow bias, GI, and SSR.
    out_geometry = vec4(EncodeOctahedralNormal(geo_normal_world), v_lmcoord.xy);
    // The existing main workspace holds shading normals until deferred4;
    // deferred4 clears the opposite side before forward translucent blending.
    out_shading_normal = vec4(EncodeOctahedralNormal(w_normal), 0.0, 0.0);
#if defined(OPAQUE_SSR) && OPAQUE_SSR_FILTER > 0
    // These existing channels share the normal's lifetime. FP16 retains
    // every UNORM8 code after round(x*255), so history validation reads one
    // current surface packet instead of separate normal/material/id textures.
    out_shading_normal.ba = vec2(mat_id == 64 ? -1.0 : out_surface_material.r, out_surface_material.g);
#endif
}
