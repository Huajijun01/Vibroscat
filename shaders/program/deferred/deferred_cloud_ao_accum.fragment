// ════════════════════════════════════════════════════════════════════════════
// Deferred cloud/AO history fragment: cloud temporal upsampling and guided
// reconstruction of accumulated screen-space AO (GTAO or SSAO).
// ════════════════════════════════════════════════════════════════════════════
// Runs after the deferred1 computes (clouds_render, ao.compute) in the same
// program: clouds_render produces fresh inputs; ao.compute accumulates AO.
// This fragment writes one merged full-res history frame to colortex8.
// The two histories are spatially exclusive (depth branch):
//   sky:      RGBA = radiance.rgb + distance (NaN/0 rejected by cloud validation)
//   geometry: R = EncodeAOHistory(AO), G = age, B = encoded view depth (EncodeSquaredDepth
//             curve, see lib/raytrace/ssr_depth.glsl), A = NaN
//             ("not cloud": taps crossing the boundary propagate NaN and
//             reject the history)
// The colortex flip (read main / write alt) gives lighting the current
// frame without an extra buffer or compute-side race.
//
// Sky pixels run cloud accumulation; geometry pixels reconstruct accumulated AO.
// Type switches reset cleanly: cloud validation rejects NaN (AO pixels);
// the AO side reseeds when the history is not AO-marked. AO generation is
// half-res with joint depth/normal reconstruction on a fixed lattice.
// AO_TEMPORAL off keeps the same edge protection without history.

/* RENDERTARGETS: 8 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/render_scale.glsl"
#include "/lib/atmosphere/atmosphere_geometry.glsl"
#include "/lib/cloud/temporal.glsl"
#include "/lib/cloud/volumetric.glsl"
#include "/lib/lighting/ao_history.glsl"
#include "/lib/lighting/ao_reconstruction.glsl"
#include "/lib/raytrace/ssr_depth.glsl"

layout(location = 0) out vec4 out_history;

#ifdef VOLUMETRIC_CLOUDS
layout(r8) uniform image2D uimg_clouds_age;
#endif

void main() {
    if (OutsideSceneRender(gl_FragCoord.xy)) discard;
    ivec2 tx = ivec2(gl_FragCoord.xy);
    vec2 uv = (vec2(tx) + 0.5) * u_render_pixel_size;
    float scene_depth = texelFetch(depthtex0, tx, 0).r;

    if (scene_depth >= 1.0) {
        // ── Sky: cloud temporal upsampling + accumulation ──
#ifdef VOLUMETRIC_CLOUDS
        vec3 view_dir = normalize(mat3(gbufferModelViewInverse)
            * NDCToView(vec3(uv * 2.0 - 1.0, 1.0)));
        vec3 camera_atmosphere_pos = AtmosphereCameraPosition();
        float cloud_entry;
        float cloud_exit;
        bool cloud_visible = CloudShellInterval(camera_atmosphere_pos, view_dir, cloud_entry, cloud_exit);
        if (cloud_visible
                && length(camera_atmosphere_pos) < ATM_PLANET_R + CLOUD_BASE_ALTITUDE) {
            // Only render when the ray rises into the layer (not skimming beneath).
            cloud_visible = cloud_entry > 0.0;
        }
        if (cloud_visible) {
            int pixel_age = int(imageLoad(uimg_clouds_age, tx).r * 255.0 + 0.5);
            int new_age = 1;
            CloudFrame current_frame = CloudSampleCurrentBilinear(tx);
            CloudFrame accumulated = current_frame;
            if (!CloudHistoryInvalid(current_frame) && frameCounter > 0) {
                vec2 previous_uv;
                if (!CloudProjectToPrevious(view_dir, current_frame.surface_distance, previous_uv
                )) {
                    // UV out of range / behind previous camera: reject history.
                    accumulated = current_frame;
                } else {
                    CloudFrame reprojected_history = CloudHistorySample(previous_uv);
                    if (CloudHistoryInvalid(reprojected_history)) {
                        // Reprojected slot has no data: seed from current.
                        accumulated = current_frame;
                    } else {
                        accumulated = CloudAccumulate(current_frame, reprojected_history, pixel_age);
                        new_age = min(pixel_age + 1, CLOUD_HISTORY_FRAMES);
                    }
                }
            }
            imageStore(uimg_clouds_age, tx, vec4(float(new_age) * (1.0 / 255.0), 0.0, 0.0, 0.0));
            out_history = vec4(accumulated.radiance, accumulated.surface_distance);
        } else {
            // Ray misses the layer: keep the invalid marker, reset age
            // (entering rays reseed immediately).
            imageStore(uimg_clouds_age, tx, vec4(0.0, 0.0, 0.0, 0.0));
            out_history = vec4(0.0, 0.0, 1.0, HISTORY_NO_CLOUD_DATA);
        }
#else
        out_history = vec4(0.0, 0.0, 1.0, HISTORY_NO_CLOUD_DATA);
#endif
        return;
    }

    // ── Geometry: guided AO reconstruction; cloud history invalid ──
#if defined(GTAO) || defined(SSAO)
    vec2 geo_normal_oct = texelFetch(colortex4, tx, 0).xy;
    // AO history was validated and accumulated at half resolution by the
    // preceding compute. Full-res output uses depth/normal bilateral weights.
    vec2 resolved_ao = ReconstructAO(tx, scene_depth, geo_normal_oct);
    out_history = vec4(EncodeAOHistory(resolved_ao.x), resolved_ao.y,
        EncodeSquaredDepth(scene_depth), HISTORY_NO_CLOUD_DATA);
#else
    // No standalone AO (clouds on): geometry pixels invalidate the cloud history.
#ifdef VOLUMETRIC_CLOUDS
    out_history = vec4(0.0, 0.0, 1.0, HISTORY_NO_CLOUD_DATA);
    imageStore(uimg_clouds_age, tx, vec4(0.0, 0.0, 0.0, 0.0));
#endif
#endif
}
