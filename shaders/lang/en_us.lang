option.WATER_GODRAYS_STRENGTH = Shaft Brightness
option.WATER_GODRAYS_STRENGTH.comment = Brightness of the underwater beams.
option.WATER_GODRAYS_STEPS = Shaft Samples
option.WATER_GODRAYS_STEPS.comment = Samples along each beam: higher = smoother shafts, slower.
option.WATER_GODRAYS_DISTANCE_M = Maximum Shaft Distance
suffix.WATER_GODRAYS_DISTANCE_M = \ m
