#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#ifdef DOF
#include "/lib/contract/dof_data.glsl"
#endif

flat out int v_history_frame_valid;
#ifdef DOF
flat out float v_dof_current_weight;
#endif

void main() {
    gl_Position = vec4(float(gl_VertexID == 1) * 4.0 - 1.0, float(gl_VertexID == 2) * 4.0 - 1.0, 0.0, 1.0);
#ifdef DOF
    // A one-pixel change in blur support admits half current-frame color; frame-uniform, so once per triangle vertex.
    v_dof_current_weight = min(dof_focus_change_px * 0.5, 1.0);
#endif
    // Frame-uniform camera-cut checks, delivered per pixel through the flat varying.
    vec3 camera_forward = gbufferModelViewInverse[2].xyz;
    vec3 previous_forward = vec3(gbufferPreviousModelView[0].z,
        gbufferPreviousModelView[1].z, gbufferPreviousModelView[2].z);
    v_history_frame_valid = int(frameCounter > 1 && u_camera_delta_sq < 4096.0
        && dot(camera_forward, previous_forward) > 0.5
        && abs(gbufferProjection[0].x - gbufferPreviousProjection[0].x) < 0.1
        && abs(gbufferProjection[1].y - gbufferPreviousProjection[1].y) < 0.1);
}
