// ════════════════════════════════════════════════════════════════════════════
// Unified GBuffer fill — all opaque gbuffer programs route here
// ════════════════════════════════════════════════════════════════════════════
//
// Program dispatch via #define (set in world*/ stub .fsh files):
//   PROGRAM_GBUFFERS_TERRAIN       terrain, terrain_solid, terrain_cutout, block
//   PROGRAM_GBUFFERS_ENTITIES      entities
//   PROGRAM_GBUFFERS_HAND          hand
//   PROGRAM_GBUFFERS_BEACONBEAM    beaconbeam
//   PROGRAM_GBUFFERS_SPIDEREYES    spidereyes
//   (none of the above)           basic, line, textured, textured_lit, particles
//
// GBuffer layout:
//   gbuf1.rgb = albedo (sRGB, decoded to linear in deferred pass)
//   gbuf1.a   = v_material_id / 255.0  (see lib/material/core.glsl for ranges)
//   gbuf2 (RGBA16, 2x8 packed):
//     R = normal.x [0,1] | combined vertex/material AO
//     G = normal.y     | normal.z
//     B = perceptual roughness | raw specular selector
//     A = emission     | auxiliary
//   gbuf4.rg = octahedral-encoded geometric view normal
//   gbuf4.zw = lightmap coordinates
//
// Coordinate-first lightmap: v_lmcoord stores UV, normalized by 1/240;
// never sampled in the gbuffer pass (sampled in deferred).
//
// Attribute availability matrix:
//   at_tangent → terrain, entities, block (but NOT hand, basic, textured, particles)
//   mc_Entity  → terrain, block (NOT entities — use entityId uniform instead)
//
// Vertex variants (solid.vertex) selected by the same #defines.

/* RENDERTARGETS: 1,2,4 */

#include "/lib/contract/uniforms.glsl"
#include "/lib/core/packing.glsl"
#include "/lib/material/core.glsl"

in vec2 v_texcoord;
in vec2 v_lmcoord;
in vec4 v_color;
flat in int v_material_id;
in vec3 v_world_normal;

#ifdef HAS_AT_TANGENT
in vec3 v_world_tangent;
in vec3 v_world_bitangent;
#endif

layout(location = 0) out vec4 gbuf1;
layout(location = 1) out vec4 gbuf2;
layout(location = 2) out vec4 gbuf4;

// Terrain programs do not alpha test, so they can run early depth tests.
#if defined(PROGRAM_GBUFFERS_TERRAIN) || defined(PROGRAM_GBUFFERS_TERRAIN_SOLID)
layout(early_fragment_tests) in;
#endif

void main() {
    vec4 albedo_tex = texture(gtexture, v_texcoord);
    float alpha = albedo_tex.a;

    // ── alpha test (controlled by USE_DISCARD in the gbuffer wrapper) ──
#ifdef USE_DISCARD
    if (alpha < 0.1) discard;
#endif

    // ── albedo = texture × vertex color ──
    vec3 albedo = albedo_tex.rgb * v_color.rgb;

    int mat_id = v_material_id;

    // ── program-specific overrides ──
#ifdef PROGRAM_GBUFFERS_ENTITIES
    // entityColor is a tint overlay (e.g. sheep wool, dyed leather armor)
    albedo = mix(albedo, entityColor.rgb, entityColor.a);
#endif
#ifdef PROGRAM_GBUFFERS_HAND
    mat_id = 64;  // player hand / held item
#endif
#ifdef PROGRAM_GBUFFERS_BEACONBEAM
    if (alpha < 0.5) discard;
    mat_id = 112; // emissive class
#endif
#ifdef PROGRAM_GBUFFERS_SPIDEREYES
    mat_id = 112; // emissive class
#endif

    // ── TBN: tangent → world-space normal ──
    // Iris binds a 1x1 fallback when the resource pack has no normal atlas.
    // Programs without at_tangent cannot interpret tangent-space normal maps.
    vec3 w_normal = normalize(v_world_normal);
    vec3 normal_tex = vec3(0.5, 0.5, 1.0);
    bool has_normal_texture = any(notEqual(textureSize(normals, 0), ivec2(1)));
    if (has_normal_texture) normal_tex = texture(normals, v_texcoord).rgb;
#ifdef HAS_AT_TANGENT
    if (has_normal_texture) {
        mat3 tbn = mat3(v_world_tangent, v_world_bitangent, v_world_normal);
        vec3 ts_normal = DecodeLabPBR(normal_tex);
        w_normal = normalize(tbn * ts_normal);
    }
#endif

    float material_ao = 1.0;
#ifdef MC_TEXTURE_FORMAT_LAB_PBR
    material_ao = normal_tex.b;
#endif
    float combined_ao = min(v_color.a, material_ao);

#ifdef PROGRAM_GBUFFERS_PARTICLES
    w_normal = vec3(0.0, 1.0, 0.0);
#endif

    // ── Material from specular map ──
    // The explicit zero default is rough, non-metallic and non-emissive.
    vec4 spec_tex = vec4(0.0);
    if (any(notEqual(textureSize(specular, 0), ivec2(1)))) spec_tex = texture(specular, v_texcoord);
    OpaqueMaterial mat = DecodeOpaqueMaterial(spec_tex);

#ifdef PROGRAM_GBUFFERS_BEACONBEAM
    mat.emission = 1.0;
#endif
#ifdef PROGRAM_GBUFFERS_SPIDEREYES
    mat.emission = 1.0;
#endif

    // ── Write GBuffer ──
    gbuf1.rgb = albedo;
    gbuf1.a   = float(mat_id) / 255.0;
    gbuf2 = vec4(
        Pack2x8(w_normal.x * 0.5 + 0.5, combined_ao),
        Pack2x8(w_normal.y * 0.5 + 0.5, w_normal.z * 0.5 + 0.5),
        Pack2x8(mat.perceptual_roughness, mat.specular_selector),
        Pack2x8(mat.emission, mat.auxiliary));
    // colortex4 (RGBA8): octahedral view-space geometric normal in RG, lightmap in BA
    vec3 geo_view_n = normalize(mat3(gbufferModelView) * v_world_normal);
    gbuf4 = vec4(EncodeOctahedralNormal(geo_view_n), v_lmcoord.xy);
}
