#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/render_scale.glsl"
#include "/lib/geometry/plant_wind.glsl"

// GBuffer vertex interface and the shared setup for this pass.
out vec2 v_texcoord;
out vec2 v_lmcoord;
out vec4 v_color;
flat out int v_material_id;
out vec3 v_world_normal;
#if defined(RAIN_WETNESS_ACTIVE)
out vec3 v_rain_world_pos;
#endif
#ifdef HAS_AT_TANGENT
out vec3 v_world_tangent;
out vec3 v_world_bitangent;
#endif

#ifdef HAS_MC_ENTITY
in vec4 mc_Entity;
#endif
#ifdef HAS_AT_TANGENT
in vec4 at_tangent;
#endif
#if defined(PLANT_WIND_TERRAIN_ACTIVE)
in vec4 at_midBlock;
#endif

void SetupGbufferVertex() {
    vec4 view_pos = gl_ModelViewMatrix * gl_Vertex;
#if defined(PLANT_WIND_TERRAIN_ACTIVE)
    int block_id = int(mc_Entity.x + 0.5);
    if (block_id >= 256 && block_id < 1280) {
        vec3 world_pos = (gbufferModelViewInverse * view_pos).xyz;
        vec3 offset_world = PlantWindOffset(world_pos, at_midBlock.xyz / 64.0, block_id);
        view_pos.xyz += mat3(gbufferModelView) * offset_world;
    }
#endif
#if defined(RAIN_WETNESS_ACTIVE)
    v_rain_world_pos = (gbufferModelViewInverse * view_pos).xyz;
#endif
#if defined(PROGRAM_GBUFFERS_HAND)
    // The hand keeps the exact full projection product: the sparse form lost
    // the walking hand sway here and the cause was never isolated.
    gl_Position = gl_ProjectionMatrix * view_pos;
#else
    gl_Position = ViewToClip(gl_ProjectionMatrix, view_pos.xyz);
#endif
#ifdef TAA
    gl_Position.xy += u_taa_offset * gl_Position.w;
#endif
#if defined(TAAU_ACTIVE)
    gl_Position = ScaleSceneClipPosition(gl_Position);
#endif

    // Particles are camera-facing billboards: their mesh normal points at the
    // eye, which would flip sky/ground ambient with camera pitch and store a
    // meaningless geometric normal. Both their geometric and shading normal
    // are world up, so the gbuffer and the deferred lighting agree.
    vec3 normal_world;
#ifdef PROGRAM_GBUFFERS_PARTICLES
    normal_world = vec3(0.0, 1.0, 0.0);
#else
    normal_world = normalize(mat3(gbufferModelViewInverse) * (gl_NormalMatrix * gl_Normal));
#endif
    v_world_normal = normal_world;

#ifdef HAS_AT_TANGENT
    vec3 tangent = normalize(mat3(gbufferModelViewInverse) * (gl_NormalMatrix * at_tangent.xyz));
    vec3 bitangent = cross(tangent, normal_world) * sign(at_tangent.w);
    v_world_tangent = tangent;
    v_world_bitangent = bitangent;
#endif

    v_texcoord = (gl_TextureMatrix[0] * gl_MultiTexCoord0).xy;
    v_lmcoord = (gl_TextureMatrix[1] * gl_MultiTexCoord1).xy;
    v_lmcoord = saturate(v_lmcoord * 1.103449 - 0.0689656);
    v_color = gl_Color;
}

void main() {
    SetupGbufferVertex();

#if defined(PROGRAM_GBUFFERS_TERRAIN) || defined(PROGRAM_GBUFFERS_TERRAIN_SOLID) || defined(PROGRAM_GBUFFERS_TERRAIN_CUTOUT)
    v_material_id = int(mc_Entity.x + 0.5) & 255;
#elif defined(PROGRAM_GBUFFERS_BLOCK)
    v_material_id = int(mc_Entity.x + 0.5);
#elif defined(PROGRAM_GBUFFERS_ENTITIES)
    v_material_id = entityId - 10000;
#elif defined(PROGRAM_GBUFFERS_HAND)
    v_material_id = 64;
#elif defined(PROGRAM_GBUFFERS_BEACONBEAM)
    v_material_id = 112;
#elif defined(PROGRAM_GBUFFERS_SPIDEREYES)
    v_material_id = 112;
#else
    // basic, line, textured, textured_lit and particles share the generic
    // opaque class: no SSS, wetness, metal or emissive classification.
    v_material_id = 0;
#endif
}
