#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/render_scale.glsl"
#include "/lib/color/spaces.glsl"
#include "/lib/material/alpha_test.glsl"

/* RENDERTARGETS: 4 */

// u_rain_biome is the smoothed camera-biome precipitation weight, so a biome edge fades the opacity over
// the uniform's half-life; with the SRC_ALPHA blend, scaling coverage fades radiance, occlusion and accumulation together.

in vec2 v_texcoord;
in vec4 v_color;

layout(location = 0) out vec4 out_weather;

void main() {
#if defined(TAAU_ACTIVE)
    if (OutsideSceneRender(gl_FragCoord.xy)) discard;
#endif
    vec4 tex = texture(gtexture, v_texcoord);
    DiscardBelowAlphaTest(tex.a, 0.1);
    float alpha = tex.a * v_color.a * u_rain_particle_opacity;
    // Decode before the blend: the fixed-function blend accumulates the stored value per pixel, so the
    // sheet must enter it linear (premultiplying in sRGB would push coverage through the sRGB curve).
    out_weather = vec4(ToLinear(tex.rgb * v_color.rgb), alpha);
}
