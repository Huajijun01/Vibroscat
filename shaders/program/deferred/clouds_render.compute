#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/atmosphere/atmosphere_geometry.glsl"
#include "/lib/core/noise.glsl"
#include "/lib/cloud/volumetric.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
// This dispatch directive must stay a bare literal: Iris parses dispatch
// directives at pack load, where option defines do not exist yet, so an
// option-conditional directive would be stripped and dispatch would silently
// fall back to this same full-coverage default. The upscaling tier bounds
// main() with u_render_res * CLOUD_CURRENT_SCALE - the same formula as
// CloudCurrentImageSize() in lib/cloud/temporal.glsl - rather than via
// dispatch or imageSize(): with TAAU the allocation is display-sized while
// the active scene rectangle is smaller, so walking imageSize() would visit
// dead texels.
const vec2 workGroupsRender = vec2(1.0, 1.0);

// deferred_pre selects the existing alt workspace; opaque shading normals
// stay untouched in main until deferred2/3/4 consume them.
layout(rgba16f) uniform restrict writeonly image2D colorimg12;

void main() {
#ifndef VOLUMETRIC_CLOUDS
    // deferred1 is shared with GTAO/SSAO (VOLUMETRIC_CLOUDS || GTAO || SSAO):
    // nothing to do without clouds.
    return;
#endif
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    ivec2 render_size = max(ivec2(u_render_res * CLOUD_CURRENT_SCALE), ivec2(1));
    if (any(greaterThanEqual(id, render_size))) return;

    vec2 full_resolution = u_render_res;
    vec2 cell_size = full_resolution / vec2(render_size);
#if CLOUD_TEMPORAL_UPSCALING == 1
    vec2 r2_offset = vec2(0.5);
#else
    vec2 r2_offset = R2Offset(frameCounter);
#endif
    // The R2 offset moves the complete low-res lattice continuously inside
    // each full-res cell. This is the only ray per low-res texel per frame.
    vec2 sample_pos = (vec2(id) + r2_offset) * cell_size;
    ivec2 sample_pos_i = clamp(
        ivec2(floor(sample_pos)),
        ivec2(0),
        ivec2(full_resolution) - ivec2(1)
    );
    vec2 uv = sample_pos * u_render_pixel_size;
    vec3 view_dir = normalize(
        mat3(gbufferModelViewInverse) * NDCToView(vec3(uv * 2.0 - 1.0, 1.0))
    );

    // Stop the interval at the opaque surface depth (no tracing behind
    // terrain). A sky pixel has no opaque surface, so the cloud shell is the
    // only bound and the no-cloud sentinel stands in for the far plane.
    // sample_pos_i is already clamped to ivec2(full_resolution) - 1 above and
    // full_resolution == u_render_res, so it is a valid fetch coordinate as-is.
    float terrain_end_km = CLOUD_NO_CLOUD_DISTANCE;
    float sample_depth = texelFetch(depthtex0, sample_pos_i, 0).r;
    if (sample_depth < 1.0) {
        vec3 surface_view_pos = NDCToViewSparse(uv * 2.0 - 1.0, sample_depth * 2.0 - 1.0);
        terrain_end_km = length(surface_view_pos) * 0.001;
    }

    vec3 camera_atmosphere_pos = AtmosphereCameraPosition();
    float march_start = 0.0;
    float march_end = 0.0;
    float cloud_top_distance = terrain_end_km;
    bool cloud_visible = CloudShellInterval(camera_atmosphere_pos, view_dir, march_start, march_end);
    int step_count = 0;
    if (cloud_visible) {
        march_end = min(march_end, terrain_end_km);
        cloud_visible = march_end > march_start + 1.0e-5;
        if (cloud_visible) {
            // min()/max() keep the clamp defined when the two sliders are
            // ordered the other way round (GLSL clamp is undefined for
            // minVal > maxVal).
            step_count = clamp(int(ceil((march_end - march_start) / CLOUD_VIEW_TARGET_STEP_KM)),
                min(CLOUD_VIEW_MIN_STEPS, CLOUD_VIEW_MAX_STEPS),
                max(CLOUD_VIEW_MIN_STEPS, CLOUD_VIEW_MAX_STEPS));
            cloud_top_distance = (view_dir.y < 0.0 && march_start > 0.0) ? march_start : march_end;
        } else {
            cloud_top_distance = march_end;
        }
    }

    vec3 surface_position;
    bool hit = false;
    vec3 cloud_data = vec3(0.0, 0.0, 1.0);
    if (cloud_visible) {
        // x = view march jitter, y = light march base; the slice offset
        // decorrelates the two streams. The march advances every frame (its
        // temporal accumulator runs with or without TAA).
        vec2 stbn_jitter = vec2(
            SampleSTBN(sample_pos_i, frameCounter),
            SampleSTBN(sample_pos_i, frameCounter + STBN_STREAM_3));
        cloud_data = MarchVolumetricClouds(
            camera_atmosphere_pos,
            view_dir,
            stbn_jitter,
            march_start,
            march_end,
            step_count,
            surface_position,
            hit
        );
    } else {
        surface_position = vec3(0.0);
    }

    vec4 frame;
    if (hit) {
        float distance_km = length(surface_position - camera_atmosphere_pos);
        frame = vec4(cloud_data, distance_km);
    } else {
        frame = vec4(cloud_data, cloud_top_distance);
    }
    imageStore(colorimg12, id, frame);
}
