#include "/lib/contract/settings.glsl"
#include "/lib/contract/sky_light_data.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/render_scale.glsl"
#include "/lib/lighting/ambient_light.glsl"

#if defined(PROGRAM_GBUFFERS_WATER) && defined(HAS_MC_ENTITY)
in vec4 mc_Entity;
#endif
#if defined(WATER_SURFACE_TANGENT_ACTIVE)
in vec4 at_tangent;
#endif

#if defined(PROGRAM_GBUFFERS_WATER)
// bit 0 = water block, bit 1 = glass/ice, bit 2 = negative tangent handedness; non-water translucent programs carry no flags.
flat out int v_surface_flags;
#endif
flat out vec3 v_normal;
#if defined(WATER_SURFACE_TANGENT_ACTIVE)
flat out vec3 v_world_tangent;
#endif
out vec3 v_ambient_col;
out vec3 v_shadow_proj_pos;
out vec3 v_color;
out vec4 v_texcoord;

void main() {
    vec3 view_pos = (gl_ModelViewMatrix * gl_Vertex).xyz;
    vec3 world_pos = ViewToWorldSpace(view_pos);

    vec3 shadow_clip = ProjectToShadowClip(world_pos + gl_Normal * 0.025);
    vec2 shadow_ndc_xy = DistortShadowClip(shadow_clip.xy);
    float shadow_ndc_z = shadow_clip.z * 0.5 + 0.5 - 0.0001;
    v_shadow_proj_pos = vec3(shadow_ndc_xy, ProtectShadowDepth(shadow_ndc_z));

    gl_Position = ViewToClip(gl_ProjectionMatrix, view_pos);
#ifdef TAA
    gl_Position.xy += u_taa_offset * gl_Position.w;
#endif
#if defined(TAAU_ACTIVE)
    gl_Position = ScaleSceneClipPosition(gl_Position);
#endif

    v_color = gl_Color.rgb;
    v_texcoord.xy = gl_MultiTexCoord0.xy;
    v_texcoord.zw = (gl_TextureMatrix[1] * gl_MultiTexCoord1).xy;
    v_texcoord.zw = saturate(v_texcoord.zw * 1.103449 - 0.0689656);

    v_normal = normalize(gl_NormalMatrix * gl_Normal);

#if defined(PROGRAM_GBUFFERS_WATER)
    // Chunk geometry sits behind a translation-only model-view, so mat3(gbufferModelViewInverse) * gl_NormalMatrix
    // is the identity (see the terrain branch in solid.vertex): the world basis is the attributes themselves.
    vec3 normal_world = normalize(gl_Normal);
#if defined(WATER_SURFACE_TANGENT_ACTIVE)
    v_world_tangent = normalize(at_tangent.xyz);
#endif
#else
    vec3 normal_world = mat3(gbufferModelViewInverse) * v_normal;
#if defined(WATER_SURFACE_TANGENT_ACTIVE)
    // Same construction as solid.vertex; the handedness bit rides the flags, the bitangent is rebuilt in the fragment stage.
    v_world_tangent = normalize(mat3(gbufferModelViewInverse) * (gl_NormalMatrix * at_tangent.xyz));
#endif
#endif

#if defined(PROGRAM_GBUFFERS_WATER)
    // gbuffers_water also receives glass/ice: the water flag comes from block.properties (block.80), not the program.
    int surface_flags = mc_Entity.x == 80.0 ? 1 : 0;
    // block.properties: 160 = glass/panes, 161 = ice, 163-167 = stained glass; 162 (slime/honey) is not glass.
    if (mc_Entity.x == 160.0 || mc_Entity.x == 161.0
            || (mc_Entity.x >= 163.0 && mc_Entity.x <= 167.0)) {
        surface_flags |= 2;
    }
#if defined(WATER_SURFACE_TANGENT_ACTIVE)
    if (at_tangent.w < 0.0) surface_flags |= 4;
#endif
    v_surface_flags = surface_flags;
#endif

    // Same sky ambient + lightmap remap as deferred5 (no AO in the gbuffer stage).
    v_ambient_col = AmbientLight(normal_world, vec3(1.0), v_texcoord.w);
}
