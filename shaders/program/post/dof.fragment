/* RENDERTARGETS: 0 */

#include "/lib/contract/uniforms.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/noise.glsl"
#include "/lib/color/dither.glsl"

const int DOF_SAMPLES = 12;
const float COLOR_JITTER_SEED = 29.0;

layout(location = 0) out vec3 out_color;

vec3 DepthOfField(vec2 uv) {
    float depth = texture(depthtex0, uv).r;
    if (depth >= 1.0) return texture(colortex0, uv).rgb;

    vec3 ndc = vec3(uv * 2.0 - 1.0, depth * 2.0 - 1.0);
    vec4 view_h = gbufferProjectionInverse * vec4(ndc, 1.0);
    vec3 view_pos = view_h.xyz / view_h.w;

    float cd = centerDepthSmooth;
    vec4 focus_h = gbufferProjectionInverse * vec4(vec3(0.0, 0.0, cd * 2.0 - 1.0), 1.0);
    vec3 focus_pos = focus_h.xyz / focus_h.w;

    float dist = distance(view_pos, focus_pos);
    float factor = dist * 0.5 / max(-focus_pos.z, 0.01);
    float blur_radius = clamp(factor, -1.0, 1.0) * 8.0;

    // golden spiral (Fibonacci) sampling
    const float golden_ratio = 1.61803398875;
    float dither = InterleavedGradientNoise(gl_FragCoord.xy);

    vec3 dof = vec3(0.0);
    float inv_n = 1.0 / float(DOF_SAMPLES);
    float angle_offset = dither * TAU;
    for (int i = 0; i < DOF_SAMPLES; i++) {
        float t = (float(i) + dither) * inv_n;
        float r = sqrt(t);
        float theta = angle_offset + TAU * float(i) * phi;
        vec2 offset = vec2(cos(theta), sin(theta)) * r * blur_radius * u_view_pixel_size;
        dof += texture(colortex0, uv + offset).rgb;
    }
    return dof * inv_n;
}

void main() {
    vec3 scene_color;
#ifndef DOF
    scene_color = texelFetch(colortex0, ivec2(gl_FragCoord.xy), 0).xyz;
#else
    vec2 uv = gl_FragCoord.xy * u_view_pixel_size;
    scene_color = DepthOfField(uv);
#endif
    out_color = JitterR11G11B10F(scene_color, gl_FragCoord.xy, COLOR_JITTER_SEED);
}