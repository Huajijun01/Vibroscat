
#include "/lib/contract/settings.glsl"
#include "/lib/contract/sky_light_data.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/render_scale.glsl"
#include "/lib/lighting/ambient_light.glsl"

#ifndef PROGRAM_GBUFFERS_PARTICLES_TRANSLUCENT
flat out vec3 v_normal;
#endif
out vec3 v_view_pos;
out vec3 v_ambient_col;
out vec3 v_shadow_proj_pos;
out vec4 v_color;
out vec3 v_texcoord;

void main() {
    vec3 view_pos = (gl_ModelViewMatrix * gl_Vertex).xyz;
    v_view_pos = view_pos;
    vec3 world_pos = ViewToWorldSpace(view_pos);

    vec3 shadow_clip = ProjectToShadowClip(world_pos + gl_Normal * 0.025);
    vec2 shadow_ndc_xy = DistortShadowClip(shadow_clip.xy);
    float shadow_ndc_z = shadow_clip.z * 0.5 + 0.5 - 0.0001;
    v_shadow_proj_pos = vec3(shadow_ndc_xy, ProtectShadowDepth(shadow_ndc_z));

#if defined(PROGRAM_GBUFFERS_HAND_WATER)
    // The hand keeps the exact full projection product: the sparse form lost
    // the walking hand sway here and the cause was never isolated.
    gl_Position = gl_ProjectionMatrix * vec4(view_pos, 1.0);
#else
    gl_Position = ViewToClip(gl_ProjectionMatrix, view_pos);
#endif
#ifdef TAA
    gl_Position.xy += u_taa_offset * gl_Position.w;
#endif
#if defined(TAAU_ACTIVE)
    gl_Position = ScaleSceneClipPosition(gl_Position);
#endif

    v_color = gl_Color;
    v_texcoord.xy = gl_MultiTexCoord0.xy;
    // Same vanilla lightmap normalization as solid.vertex: the shared
    // lighting curves (AmbientLight, BlockLightFromLm) are anchored on a
    // [0, 1] domain, not the raw [1/32, 31/32] matrix output. The sky
    // component stays local: AmbientLight applies its nonlinear curve here,
    // so only the block component crosses the stage.
    vec2 lmcoord = (gl_TextureMatrix[1] * gl_MultiTexCoord1).xy;
    lmcoord = saturate(lmcoord * 1.103449 - 0.0689656);
    v_texcoord.z = lmcoord.x;

#ifndef PROGRAM_GBUFFERS_PARTICLES_TRANSLUCENT
    vec3 normal_view = gl_NormalMatrix * gl_Normal;
    // Squared-length normalize with a degenerate-normal guard.
    float normal_view_sq = dot(normal_view, normal_view);
    v_normal = normal_view_sq < 1.0e-8
        ? vec3(0.0, 0.0, 1.0)
        : normal_view * inversesqrt(normal_view_sq);
    // v_normal is unit and the camera rotation preserves its length.
    vec3 normal_world = mat3(gbufferModelViewInverse) * v_normal;
#else
    // Translucent particles shade as world-up surfaces: ambient must not use
    // the billboard normal, which points at the eye and swaps zenith/ground
    // sky ambient with camera pitch. No surface normal crosses the stage.
    vec3 normal_world = vec3(0.0, 1.0, 0.0);
#endif
    v_ambient_col = AmbientLight(normal_world, vec3(1.0), lmcoord.y);
}
