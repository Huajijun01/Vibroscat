#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/color/spaces.glsl"
#include "/lib/post/bloom.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f) uniform restrict writeonly image2D colorimg12;

// Each group produces 8x8 quarter-resolution texels. Its 17x17 half-res
// intermediate stays in shared memory; workGroupsRender=0.5 supplies one
// 16x16 group per 32x32 scene pixels.
shared vec3 half_tile[17][17];

vec3 ReadBloomPrefilter(vec2 texel, vec2 full_size) {
    return textureLod(colortex0, clamp(texel, vec2(0.5), full_size - 0.5) / full_size, 0.0).rgb;
}

vec4 WeightBloomGroup(vec3 color, float spatial_weight) {
    float weight = spatial_weight / (1.0 + Luminance(color));
    return vec4(color * weight, weight);
}

vec3 FilterBloomHighlight(ivec2 half_coord, ivec2 full_size) {
    // Thirteen bilinear samples cover 6x6 scene texels. Form five overlapping
    // local averages before Karis weighting, preserving moving small lights
    // instead of suppressing each bright texel individually.
    vec2 center = vec2(half_coord * 2 + 1);
    vec2 size = vec2(full_size);
    vec3 top_left = ReadBloomPrefilter(center + vec2(-2, -2), size);
    vec3 top = ReadBloomPrefilter(center + vec2(0, -2), size);
    vec3 top_right = ReadBloomPrefilter(center + vec2(2, -2), size);
    vec3 left = ReadBloomPrefilter(center + vec2(-2, 0), size);
    vec3 middle = ReadBloomPrefilter(center, size);
    vec3 right = ReadBloomPrefilter(center + vec2(2, 0), size);
    vec3 bottom_left = ReadBloomPrefilter(center + vec2(-2, 2), size);
    vec3 bottom = ReadBloomPrefilter(center + vec2(0, 2), size);
    vec3 bottom_right = ReadBloomPrefilter(center + vec2(2, 2), size);
    vec3 inner = ReadBloomPrefilter(center + vec2(-1, -1), size)
               + ReadBloomPrefilter(center + vec2(1, -1), size)
               + ReadBloomPrefilter(center + vec2(-1, 1), size)
               + ReadBloomPrefilter(center + vec2(1, 1), size);

    vec4 filtered = WeightBloomGroup((top_left + top + left + middle) * 0.25, 0.125);
    filtered += WeightBloomGroup((top + top_right + middle + right) * 0.25, 0.125);
    filtered += WeightBloomGroup((left + middle + bottom_left + bottom) * 0.25, 0.125);
    filtered += WeightBloomGroup((middle + right + bottom + bottom_right) * 0.25, 0.125);
    filtered += WeightBloomGroup(inner * 0.25, 0.5);
    return filtered.rgb / max(filtered.a, 1e-6);
}

void main() {
#ifndef BLOOM
    // The AE sweep shares this program's enable condition. Keep every
    // invocation on the same side of the barriers when bloom is disabled.
    return;
#else
    ivec2 full_size = textureSize(colortex0, 0);
    ivec2 half_size = GetBloomMipSize(full_size, 1);
    ivec2 dst_size = GetBloomMipSize(full_size, 2);
    ivec2 dst_origin = GetBloomMipOrigin(full_size, 2);
    ivec2 group_base = ivec2(gl_WorkGroupID.xy) * 8;
    uint idx = gl_LocalInvocationIndex;

    const float TENT[3] = float[3](0.25, 0.5, 0.25);
    for (uint i = idx; i < 289u; i += 256u) {
        ivec2 local_texel = ivec2(i % 17u, i / 17u);
        // Clamp the half-res lattice before accessing the scene footprint.
        ivec2 half_coord = clamp(group_base * 2 + local_texel - 1, ivec2(0), half_size - 1);
        half_tile[local_texel.y][local_texel.x] = FilterBloomHighlight(half_coord, full_size);
    }
    barrier();

    if (idx < 64u) {
        ivec2 local_texel = ivec2(idx % 8u, idx / 8u);
        ivec2 gid = group_base + local_texel;
        ivec2 center = local_texel * 2 + 1;
        vec3 result = vec3(0.0);
        for (int y = 0; y < 3; y++) {
            for (int x = 0; x < 3; x++) {
                result += half_tile[center.y + y - 1][center.x + x - 1] * (TENT[y] * TENT[x]);
            }
        }
        if (all(lessThan(gid, dst_size))) {
            imageStore(colorimg12, dst_origin + gid, vec4(result, 0.0));
        }
    }
#endif
}
