/* RENDERTARGETS: 0 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/sky_light_data.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/filters.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/render_scale.glsl"
#include "/lib/atmosphere/sky_light.glsl"
#include "/lib/color/dither.glsl"
#include "/lib/water/fog.glsl"

const float COLOR_JITTER_SEED = 83.0;

layout(location = 0) out vec3 main_color;

// Dense Phillips wave spectrum with analytic normals, baked at 1/4/9/16 m.
// The moving, skewed cell spans (v0 - v2) * 4 s and (v1 - v2) * 4 s:
// all three river bands keep their exact world velocities while the volume
// closes analytically after 4 s. The unresolved fine tail follows layer 2.
// Spectrum realization differs from the R8 water; motion agrees per band.
// 3883 modes, 4096^2 source, 16384 photons/output pixel, WATER_RIVER_GAIN=1.5.
// Matrix is column-major; constants are generated with the texture bake.
const mat2 CAUSTIC_WORLD_TO_UV = mat2(0.08549018063, -0.06079713429,
                                    0.00297625931, 0.18249895080);
const vec2 CAUSTIC_ADVECTION_MPS = vec2(0.86803042545, 0.40513266195);
#define CAUSTIC_TIME_SPEED 0.25
#define CAUSTIC_REFERENCE vec4(0.06737530, 0.05167234, 0.07432320, 0.13514517) // filtered mean light
#define CAUSTIC_GAIN 1.0
#define CAUSTIC_FADE_DEPTH 1.0 // m of in-water light path for full caustics
// Fixed bake reference plane; underwater eyeBrightnessSmooth cannot
// reconstruct the surface precisely enough for sampling.
#define CAUSTIC_PLANE_Y 64.0
// Baked volume edge in all three axes (customTexture.utex_caustics).
#define CAUSTICS_BAKE_SIZE 256

// Four spatial B-spline taps; hardware filtering blends adjacent time slices
// before decoding sqrt intensity. RGBA = 1/4/9/16 m.
vec4 CausticSampleBspline(vec2 uv, float time) {
    vec2 size = vec2(float(CAUSTICS_BAKE_SIZE));
    vec2 p = uv * size - 0.5;
    vec2 f = fract(p);
    vec2 center = floor(p) + 0.5;
    vec2 texel = 1.0 / size;

    vec2 w0;
    vec2 w1;
    vec2 w2;
    vec2 w3;
    BsplineWeights(f, w0, w1, w2, w3);

    vec2 c_a = w0 + w1;
    vec2 c_b = w2 + w3;
    // c_a/c_b are the partition-of-unity halves: [1/6, 5/6] on f in [0,1].
    vec2 a_pos = (center - 1.0) + w1 / c_a;
    vec2 b_pos = (center + 1.0) + w3 / c_b;

    vec2 uv_a = a_pos * texel;
    vec2 uv_b = b_pos * texel;
    float frame_count = float(CAUSTICS_BAKE_SIZE);
    // Frame k was baked at k * dt; its texel center is (k + 0.5) / frame_count.
    float time_z = time + 0.5 / frame_count;
    vec4 encoded = c_a.x * c_a.y * texture(utex_caustics, vec3(uv_a, time_z))
                 + c_b.x * c_a.y * texture(utex_caustics, vec3(uv_b.x, uv_a.y, time_z))
                 + c_a.x * c_b.y * texture(utex_caustics, vec3(uv_a.x, uv_b.y, time_z))
                 + c_b.x * c_b.y * texture(utex_caustics, vec3(uv_b, time_z));
    return encoded * encoded;
}

float CausticDepthBlend(vec4 lin, float path) {
    // Depth layers at 1 / 4 / 9 / 16 m of water column.
    const float d1 = 1.0, d2 = 4.0, d3 = 9.0, d4 = 16.0;
    if (path <= d1) return lin.r;
    if (path <= d2) return mix(lin.r, lin.g, (path - d1) / (d2 - d1));
    if (path <= d3) return mix(lin.g, lin.b, (path - d2) / (d3 - d2));
    return mix(lin.b, lin.a, clamp((path - d3) / (d4 - d3), 0.0, 1.0));
}

// Shared sampler: trace the light back to the surface plane, un-map, return
// the signed delta scaled by the surface BRDF. Caller supplies the surface
// height (water fragment above water; sky-lightmap estimate underwater) and
// the shared per-metre sunlight path (identical for every column: eta < 1
// refraction cannot TIR, so WaterLightPathPerMetre's 1e-3 clamp never moves
// the value away from the unclamped one).
vec3 CausticLightContribution(vec3 caustic_world_pos, vec3 caustic_brdf, vec3 transmission, float caustic_surface_y,
    float caustic_sample_y, vec3 light_dir, float path_per_metre
) {
    float caustic_reach = (caustic_sample_y - caustic_world_pos.y) / max(light_dir.y, 1.0e-3);
    vec3 caustic_entry = caustic_world_pos + light_dir * max(caustic_reach, 0.0);
    vec2 caustic_uv = CAUSTIC_WORLD_TO_UV
        * (caustic_entry.xz - CAUSTIC_ADVECTION_MPS * frameTimeCounter);
    float caustic_time = fract(frameTimeCounter * CAUSTIC_TIME_SPEED);
    // Refraction bends the path toward vertical: path = vertical drop * path
    // per metre of drop.
    float caustic_path = max(caustic_surface_y - caustic_world_pos.y, 0.0) * path_per_metre;
    // Decode -> normalize by reference -> blend bracketing 1/4/9/16 m layers
    // by path length.
    vec4 caustic_rel = CausticSampleBspline(caustic_uv, caustic_time) / CAUSTIC_REFERENCE;
    float caustic_mixed = CausticDepthBlend(caustic_rel, caustic_path);
    float caustic_delta = (caustic_mixed - 1.0) * CAUSTIC_GAIN;

    // Direct light is column-attenuated; the caustic delta modulates it
    // (caller removes the unattenuated component). Underwater path =
    // (1 - lmcoord.y) * 15 * pathPerMetre.
    vec3 caustic_attenuation = WaterAbsorptionTransmittance(caustic_path);
    // Fade only the delta in with the column; base direct light must not
    // black out at zero path.
    float caustic_fade = smoothstep(0.0, CAUSTIC_FADE_DEPTH, caustic_path);
    return caustic_brdf * ground_light.rgb * caustic_attenuation
        * (1.0 + caustic_delta * caustic_fade)
        * transmission * step(0.01, light_dir.y);
}

void main() {
    if (OutsideSceneRender(gl_FragCoord.xy)) discard;
    vec2 texcoord = gl_FragCoord.xy * u_render_pixel_size;
    ivec2 tx = ivec2(gl_FragCoord.xy);

    vec3 scene_color = texelFetch(colortex0, tx, 0).rgb;

    float frag_depth = texelFetch(depthtex0, tx, 0).x;
    bool is_sky = frag_depth >= 1.0;

    vec4 trans_color = texelFetch(colortex12, tx, 0);
    vec4 refraction_data = texelFetch(colortex2, tx, 0);
    bool is_water = refraction_data.a > 0.99;

    // The water-fog input group is consumed only by the water-surface and
    // underwater branches; land and sky pixels skip the view rebuilds and
    // fog lighting entirely.
    bool water_shading = isEyeInWater == 1 || (is_water && !is_sky);
    vec3 view_pos0 = vec3(0.0);
    float view_len0 = 0.0;
    vec3 fast_fog_radiance = vec3(0.0);
    vec3 water_light_dir = vec3(0.0);
    float water_path_per_metre = 0.0;
    if (water_shading) {
        view_pos0 = NDCToView(vec3(texcoord * 2.0 - 1.0, frag_depth * 2.0 - 1.0));
        view_len0 = length(view_pos0);
        // ViewToSceneSpace() is camera-relative; absolute positions add cameraPosition.
        vec3 world_pos = ViewToSceneSpace(view_pos0);
        // Eye-accurate view direction: depth reconstruction is feet-space and
        // the eye sits at gbufferModelViewInverse[3] (~1.62 m up standing).
        vec3 world_dir = normalize(world_pos - EyePositionSceneSpace());
        // One light direction and one refraction path per fragment: every
        // consumer below (phases, caustics, water columns) shares them.
        water_light_dir = normalize(u_world_light_dir);
        water_path_per_metre = WaterLightPathPerMetre();
        fast_fog_radiance = FastWaterFogRadiance(ground_light.rgb, EvalSkyLightAverage(),
            dot(world_dir, water_light_dir));
    }
    vec3 color;

    if (!is_sky) {
        vec3 comp_color = scene_color;
        vec2 refract_coord = texcoord;
        // Only the water-surface branch reads the opaque depth behind it.
        vec3 view_pos1 = vec3(0.0);

        if (is_water) {
            float frag_depth1 = texelFetch(depthtex1, tx, 0).x;
            view_pos1 = NDCToView(vec3(texcoord * 2.0 - 1.0, frag_depth1 * 2.0 - 1.0));
            // Refraction: nearest surface is water; colortex2 xyz stores the
            // wave perturbation relative to the flat face normal (xzy
            // swizzle, 0.25 scale), so flat faces of any orientation give no
            // offset and the tilt alone bends the sample.
            vec3 waves_delta = refraction_data.xzy * 4.0 - 2.0;
            vec3 waves_delta_view = (gbufferModelView * vec4(waves_delta, 0.0)).xyz;

            refract_coord = -waves_delta_view.xy;
            refract_coord *= Saturate(length(view_pos1) - view_len0) * 0.5 / (view_len0 + 0.0001);
            refract_coord += texcoord;

            comp_color = texture(colortex0, SceneTextureUV(refract_coord)).rgb;

            // Caustics modulate the refracted opaque receiver.
            float refract_d = texture(depthtex1, SceneTextureUV(refract_coord)).x;
            vec3 view_pos_refr = NDCToView(vec3(refract_coord * 2.0 - 1.0, refract_d * 2.0 - 1.0));
            vec3 caustic_world_pos = ViewToSceneSpace(view_pos_refr) + cameraPosition;
            vec3 caustic_brdf = texture(colortex5, SceneTextureUV(refract_coord)).rgb;
            vec3 caustic_surface_world = ViewToSceneSpace(view_pos0) + cameraPosition;
            float caustic_fade_surface_y;
            float caustic_sample_y;
            if (isEyeInWater == 1) {
                // Underwater: fade uses the receiver's lightmap sky light
                // (lmcoord.y); surface height = receiver + (1 - lmcoord.y) * 15.
                float caustic_lm_sky = texture(colortex4, SceneTextureUV(refract_coord)).w;
                caustic_fade_surface_y = caustic_world_pos.y + (1.0 - caustic_lm_sky) * 15.0;
                caustic_sample_y = CAUSTIC_PLANE_Y;
            } else {
                caustic_fade_surface_y = caustic_surface_world.y;
                caustic_sample_y = caustic_surface_world.y;
            }
            // Replace unattenuated direct light with the column-attenuated,
            // caustic-modulated version.
            comp_color -= caustic_brdf * ground_light.rgb;
            comp_color += CausticLightContribution(caustic_world_pos, caustic_brdf, vec3(1.0),
                caustic_fade_surface_y, caustic_sample_y, water_light_dir, water_path_per_metre);

            view_pos1 = view_pos_refr;
        }

        if (is_water && isEyeInWater == 0) {
            // Column fog on the refracted background, then composite the
            // premultiplied layer once.
            FastWaterFogRender(comp_color, max(length(view_pos1) - view_len0, 0.0), fast_fog_radiance);
            comp_color = comp_color * (1.0 - trans_color.a) + trans_color.rgb;
        } else if (isEyeInWater == 1) {
            if (!is_water) {
                // Caustics land on opaque surfaces through the volume, not on
                // the water surface itself.
                vec3 caustic_world_pos = ViewToSceneSpace(view_pos0) + cameraPosition;
                vec3 caustic_brdf = texelFetch(colortex5, tx, 0).rgb;
                float caustic_lm_sky = texelFetch(colortex4, tx, 0).w;
                float caustic_fade_surface_y = caustic_world_pos.y + (1.0 - caustic_lm_sky) * 15.0;
                comp_color -= caustic_brdf * ground_light.rgb;
                comp_color += CausticLightContribution(caustic_world_pos, caustic_brdf, vec3(1.0),
                    caustic_fade_surface_y, CAUSTIC_PLANE_Y, water_light_dir, water_path_per_metre);
            }
            comp_color = comp_color * (1.0 - trans_color.a) + trans_color.rgb;
            FastWaterFogRender(comp_color, view_len0, fast_fog_radiance);
        } else {
            comp_color = comp_color * (1.0 - trans_color.a) + trans_color.rgb;
        }

        color = comp_color;
    } else {
        color = scene_color;
        if (isEyeInWater == 1) {
            FastWaterFogRender(color, far * 11.4514, fast_fog_radiance);
        }
        color = color * (1.0 - trans_color.a) + trans_color.rgb;
    }

    main_color = JitterR11G11B10F(color, gl_FragCoord.xy, COLOR_JITTER_SEED);
}
