#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/noise.glsl"
#include "/lib/atmosphere/air_fog.glsl"
#include "/lib/volume/air_epipolar.glsl"
#include "/lib/volume/epipolar_core.glsl"
#include "/lib/volume/water_epipolar.glsl"

// Two slices per workgroup (local_size_x = 2): a warp then holds two rays
// x 16 consecutive samples, which keeps the per-warp shadow-map footprint
// coherent; one slice per group (x = 1) measured ~17 us slower on the air
// path. The sample columns stay 128 tall.
layout(local_size_x = 2, local_size_y = 128) in;
// Iris scans these consts after option defines and full preprocessing, so
// the dispatch count follows EPIPOLAR_SLICES branch-wise (slices / 2 groups
// because each group owns two slices). The in-shader guard stays: underwater
// SliceCount() caps at min(slices, 512), which no compile-time dispatch can
// express.
#if EPIPOLAR_SLICES == 256
const ivec3 workGroups = ivec3(128, 1, 1);
#elif EPIPOLAR_SLICES == 512
const ivec3 workGroups = ivec3(256, 1, 1);
#elif EPIPOLAR_SLICES == 1024
const ivec3 workGroups = ivec3(512, 1, 1);
#else
const ivec3 workGroups = ivec3(1024, 1, 1);
#endif

#if defined(EPIPOLAR_ACTIVE)
layout(rgba16f) uniform writeonly image2D uimg_epipolar_term;

void main() {
    uint slice = gl_WorkGroupID.x * 2u + gl_LocalInvocationID.x;
    if (slice >= uint(SliceCount())) return;
    vec4 line = texelFetch(usam_epipolar_endpoints, ivec2(int(slice), 0), 0);
    bool line_valid = !all(equal(line, vec4(0.0)));
    int sample_count = SampleCount();
    float sample_rcp = 1.0 / float(sample_count - 1);
    uint sample_groups = uint((sample_count + 127) / 128);
    vec3 air_start = EyePositionWorldSpace();
    AirFogDensityProfile profile = AirFogProfile();
    AirFogMedium medium = AirFogReferenceMedium();
    for (uint i = 0u; i < sample_groups; ++i) {
        uint sample_index = gl_LocalInvocationID.y + i * 128u;
        if (sample_index >= uint(sample_count)) break;
        vec3 air_transmittance = vec3(1.0);
        float air_key = 0.0;
#if defined(WATER_EPIPOLAR_ACTIVE)
        if (isEyeInWater == 1) {
            vec3 radiance = vec3(0.0);
            float water_key = 0.0;
            if (line_valid) {
                vec2 uv = mix(line.xy, line.zw, float(sample_index) * sample_rcp) * 0.5 + 0.5;
                ivec2 texel = ScreenTexel(uv);
                float depth0 = texelFetch(depthtex0, texel, 0).r;
                water_key = LinearDepthFromScreenDepth(depth0);
                vec3 delta = WorldPosFromScreenUV(uv, depth0) - air_start;
                float distance_m = length(delta);
                if (distance_m > 1e-6) {
                    float jitter = SampleSTBN(texel, STBNFrame());
                    radiance = WaterRadiance(air_start, delta / distance_m, distance_m, jitter);
                }
            }
            imageStore(uimg_epipolar_term, ivec2(int(slice), int(sample_index)), vec4(radiance, water_key));
            continue;
        }
#endif
#if defined(AIR_EPIPOLAR_ACTIVE)
        if (line_valid && isEyeInWater == 0) {
            float sample_param = float(sample_index) * sample_rcp;
            vec2 uv = mix(line.xy, line.zw, sample_param) * 0.5 + 0.5;
            ivec2 texel = ScreenTexel(uv);
            float depth0 = texelFetch(depthtex0, texel, 0).r;
            air_key = LinearDepthFromScreenDepth(depth0);
            vec3 delta = WorldPosFromScreenUV(uv, depth0) - air_start;
            float distance_m = length(delta);
            if (distance_m > 1e-6) {
                vec3 direction_world = delta / distance_m;
                float length_m = AirFogSegmentLength(distance_m, far);
                float jitter = SampleSTBN(texel, STBNFrame());
                air_transmittance = AirShadowRatio(air_start, air_start + direction_world * length_m,
                    profile, medium, jitter);
            }
        }
#endif
        // Historical RGBA16F contract: RGB = E, A = linear viewZ column key.
        imageStore(uimg_epipolar_term, ivec2(int(slice), int(sample_index)), vec4(air_transmittance, air_key));
    }
}
#else
void main() {}
#endif
