/* RENDERTARGETS: 0 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/noise.glsl"
#include "/lib/core/render_scale.glsl"
#include "/lib/color/dither.glsl"

const int DOF_SAMPLES = 12;
const float COLOR_JITTER_SEED = 29.0;

layout(location = 0) out vec3 out_color;

vec3 DepthOfField(vec2 uv) {
    ivec2 tx = ivec2(gl_FragCoord.xy);
    float scene_depth = texelFetch(depthtex0, tx, 0).r;
    if (scene_depth >= 1.0) return texelFetch(colortex0, tx, 0).rgb;

    vec3 view_pos = NDCToView(vec3(uv * 2.0 - 1.0, scene_depth * 2.0 - 1.0));

    float center_depth = centerDepthSmooth;
#ifdef TAAU_ACTIVE
    // Iris samples the display center, outside the cropped scene at low scales.
    center_depth = texelFetch(depthtex0, ivec2(u_render_res * 0.5), 0).r;
#endif
    // The focus point sits on the view axis, so the reconstruction only needs
    // the inverse projection's z/w entries; the dropped products are exact
    // zeros in this pack's projection (see NDCToViewSparse).
    float focus_ndc_z = center_depth * 2.0 - 1.0;
    vec3 focus_pos = vec3(0.0, 0.0,
        (gbufferProjectionInverse[2][2] * focus_ndc_z + gbufferProjectionInverse[3][2])
            / (gbufferProjectionInverse[2][3] * focus_ndc_z + gbufferProjectionInverse[3][3]));

    float dist = distance(view_pos, focus_pos);
    float factor = dist * 0.5 / max(-focus_pos.z, 0.01);
    float blur_radius = clamp(factor, -1.0, 1.0) * 8.0;

    // golden spiral (Fibonacci) sampling
    const float golden_ratio = 1.61803398875;
    // The dither is static in screen space, so only its temporal variation
    // gives TAA something to average; STBNFrame() pins the slice when TAA is
    // off, leaving a fixed spatial blue-noise pattern instead of shimmering.
    float dither = SampleSTBN(ivec2(gl_FragCoord.xy), STBNFrame());

    vec3 dof = vec3(0.0);
    float inv_n = 1.0 / float(DOF_SAMPLES);
    // The golden-spiral azimuth is one fixed rotation: TAU-periodic, so the
    // unwrapped 1.618... step walks the same sequence as fract golden angles.
    // A rotation recurrence replaces per-sample cos/sin pairs.
    float azimuth_c = cos(dither * TAU);
    float azimuth_s = sin(dither * TAU);
    const vec2 azimuth_step = vec2(cos(TAU * golden_ratio), sin(TAU * golden_ratio));
    vec2 blur_pixel_scale = blur_radius * u_render_pixel_size;
    for (int i = 0; i < DOF_SAMPLES; i++) {
        float t = (float(i) + dither) * inv_n;
        float r = sqrt(t);
        vec2 offset = vec2(azimuth_c, azimuth_s) * (r * blur_pixel_scale);
        dof += texture(colortex0, SceneTextureUV(uv + offset)).rgb;
        float next_c = azimuth_c * azimuth_step.x - azimuth_s * azimuth_step.y;
        azimuth_s = azimuth_s * azimuth_step.x + azimuth_c * azimuth_step.y;
        azimuth_c = next_c;
    }
    return dof * inv_n;
}

void main() {
    if (OutsideSceneRender(gl_FragCoord.xy)) discard;
    vec3 scene_color;
    // Iris registers a boolean option only where an #ifdef/#ifndef names it,
    // so the DOF part of this dispatch cannot use the one-line #if form.
#ifndef DOF
    scene_color = texelFetch(colortex0, ivec2(gl_FragCoord.xy), 0).xyz;
#elif defined(TAAU_ACTIVE)
    // DOF is forced off under TAAU: the cropped scene rectangle puts the
    // display center outside it, and the raw center-depth fetch that works
    // around that loses centerDepthSmooth's temporal stabilization, which
    // makes the focus distance jump per frame.
    scene_color = texelFetch(colortex0, ivec2(gl_FragCoord.xy), 0).xyz;
#else
    vec2 uv = gl_FragCoord.xy * u_render_pixel_size;
    scene_color = DepthOfField(uv);
#endif
    out_color = JitterR11G11B10F(scene_color, gl_FragCoord.xy, COLOR_JITTER_SEED);
}
