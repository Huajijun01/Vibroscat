#include "/lib/core/coordinates.glsl"
#include "/lib/core/render_scale.glsl"

out vec2 v_texcoord;
out vec4 v_color;

void main() {
    gl_Position = ScaleSceneClipPosition(
        ViewToClip(gl_ProjectionMatrix, (gl_ModelViewMatrix * gl_Vertex).xyz));
    v_texcoord = (gl_TextureMatrix[0] * gl_MultiTexCoord0).xy;
    v_color = gl_Color;
}
