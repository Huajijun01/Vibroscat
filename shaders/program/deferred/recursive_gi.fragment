/* RENDERTARGETS: 9,10 */

#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/coordinates.glsl"
#include "/lib/core/math_scalar.glsl"
#include "/lib/core/noise.glsl"
#include "/lib/core/packing.glsl"
#include "/lib/color/spaces.glsl"
#include "/lib/lighting/ambient_light.glsl"
#include "/lib/lighting/gi_denoise.glsl"
#include "/lib/lighting/gi_history.glsl"
#if GI_MODE == 2
#include "/lib/lighting/ambient_occlusion.glsl"
#include "/lib/lighting/reflective_shadow_map.glsl"
#endif

// Port of the unidirectional GT-VBGI visibility-bitmask screen-space GI by
// Mirko Salm (CC0 1.0 / MIT dual license; this file follows CC0):
//   https://www.shadertoy.com/view/XcdBWf  (bidirectional variant:
//   https://www.shadertoy.com/view/lfdBWn)
// The slice sampler's fast arctangent is from
//   https://www.shadertoy.com/view/lXBfWm
// colortex5 is read-only scene radiance from the existing pipeline; this
// pass owns the colortex9/10 GI temporal history pair.
// Trace budget knobs (SSGI_*) live in lib/contract/settings.glsl.

layout(location = 0) out vec3 out_gi;
layout(location = 1) out uint out_gi_metadata;


#if GI_MODE == 1
float GIPartialSlice(float x, float sin_view_normal) {
    if (abs(x) >= 1.0 || x == 0.0) return x;
    bool negative = x < 0.0;
    x = abs(x);
    float s = sin_view_normal;
    float o = s - s * s;
    float slope0 = 1.0 / (1.0 + (PI - 1.0) * (s - o * 0.30546));
    float slope1 = 1.0 / (1.0 - (1.0 - exp2(-20.0)) * (s + o * mix(0.5, 0.785, s)));
    float k = mix(0.1, 0.25, s);
    float a = 1.0 - (PI - 2.0) / (PI - 1.0);
    float b = 1.0 / (PI - 1.0);
    float d0 = a - slope0 * b;
    float d1 = 1.0 - slope1;
    float f0 = d0 * (PI * x - (0.5 * PI - FastAcos(x)));
    float f1 = d1 * (x - 1.0);
    // Rational-fit join: kk = k^2; h0/h1 smooth-clip the two branch values
    // (sqrt(f^2 + k^2) - k); hh joins them by harmonic mean.
    float kk = k * k;
    float h0 = sqrt(f0 * f0 + kk) - k;
    float h1 = sqrt(f1 * f1 + kk) - k;
    float hh = (h0 * h1) / max(h0 + h1, 1.0e-6);
    float y = x - sqrt(max(hh * (hh + 2.0 * k), 0.0));
    return negative ? -y : y;
}

vec2 GISampleSliceDirection(vec3 normal_view, float random_value) {
    float angle = random_value * TAU;
    vec2 direction = vec2(cos(angle), sin(angle));
    float normal_xy_length = length(normal_view.xy);
    if (normal_xy_length > 1.0e-5) {
        vec2 normal_direction = normal_view.xy / normal_xy_length;
        direction = Rotate2D(direction, normal_direction * vec2(1.0, -1.0));
        float slice_angle = GIPartialSlice(FastAtan2(direction), normal_xy_length) * PI;
        direction = Rotate2D(vec2(cos(slice_angle), sin(slice_angle)), normal_direction);
    }
    return direction;
}

vec4 GIQuaternionFromViewDirection(vec3 view_direction) {
    vec3 xyz = vec3(view_direction.y, -view_direction.x, 0.0);
    float scalar = -view_direction.z;
    float inverse_scale = inversesqrt(max(scalar * 0.5 + 0.5, 0.0));
    return vec4(xyz * inverse_scale * 0.5, 1.0 / inverse_scale);
}

vec3 GIRotateVectorByQuaternion(vec3 value, vec4 quaternion) {
    float cross_term = value.y * quaternion.x - value.x * quaternion.y;
    float scale = 2.0 * (value.z * quaternion.w + cross_term);
    vec3 result;
    result.xy = value.xy + quaternion.yx * vec2(scale, -scale);
    result.z = value.z + 2.0 * (quaternion.w * cross_term
        - value.z * dot(quaternion.xy, quaternion.xy));
    return result;
}

vec3 GIRotateSliceDirectionByQuaternion(vec2 slice_direction, vec4 quaternion) {
    float offset = quaternion.x * slice_direction.y;
    float cross_term = quaternion.y * slice_direction.x;
    vec3 basis = vec3(offset - cross_term, -offset + cross_term, offset - cross_term);
    return vec3(slice_direction, 0.0) + 2.0 * (basis * quaternion.yxw);
}

// Slice-relative CDF of the cosine-weighted distribution for the active
// slice: the isPhiLargerThanAngN = true arm of the reference's
// SliceRelCDF_Cos. Endpoint inputs pass through unchanged, as in the
// reference.
float GISliceRelativeCDF(float x, float angle_normal, float cos_normal) {
    if (x <= 0.0 || x >= 1.0) return x;
    float phi = x * PI - PI * 0.5;
    float numerator = 3.0 * cos_normal - cos(angle_normal - 2.0 * phi)
        + (4.0 * angle_normal - 2.0 * phi + PI) * sin(angle_normal);
    float denominator = 4.0 * (cos_normal + angle_normal * sin(angle_normal));
    return numerator / denominator;
}

// Quantize the remapped arc into 32 sectors and mask the covered span
// (reference: uvec2(floor(hor01 * 32.0)) with the range-end masks ANDed).
uint GIVisibilityMaskFromRange(vec2 range01) {
    uvec2 range_bits = uvec2(floor(range01 * 32.0));
    uint left = range_bits.x < 32u ? 0xFFFFFFFFu << range_bits.x : 0u;
    uint right = range_bits.y != 0u ? 0xFFFFFFFFu >> (32u - range_bits.y) : 0u;
    return left & right;
}

vec3 GITrace(vec3 origin_view_position, vec3 origin_normal_view, vec3 stbn_noise,
        out float coverage, out float second_moment) {
    second_moment = 0.0;
    vec3 view_direction = -normalize(origin_view_position);
    vec4 q_to_view = GIQuaternionFromViewDirection(view_direction);
    vec4 q_from_view = q_to_view * vec4(vec3(-1.0), 1.0);
    vec3 normal_view = GIRotateVectorByQuaternion(origin_normal_view, q_from_view);
    // stbn_noise comes from the pass main (streams 0/3/1): x samples the
    // slice direction, y jitters the first march step, z jitters the arcs.
    vec2 slice_direction = GISampleSliceDirection(normal_view, stbn_noise.x);
    vec3 ray_direction = GIRotateSliceDirectionByQuaternion(slice_direction, q_to_view);

    vec3 projection_diag = vec3(gbufferProjection[0].x, gbufferProjection[1].y, gbufferProjection[2].z);
    vec4 origin_proj = vec4(projection_diag * origin_view_position + gbufferProjection[3].xyz, -origin_view_position.z);
#ifdef TAA
    origin_proj.xy += u_taa_offset * origin_proj.w;
#endif
    vec4 projected_direction = vec4(projection_diag * ray_direction, -ray_direction.z);
    projected_direction.xy += gbufferProjection[2].xy * ray_direction.z;
    // Shared homogeneous clip-ray screen-edge solver; far + 32.0 bounds the
    // trace when the ray never crosses a screen edge forward.
    float trace_length = ClipRayScreenExitT(origin_proj, projected_direction, far + 32.0);
    vec2 origin_coord = origin_proj.xy * (0.5 / origin_proj.w) + 0.5;
    vec4 target_proj = origin_proj + projected_direction * trace_length;
    vec2 target_coord = target_proj.xy / target_proj.w * 0.5 + 0.5;
    vec2 sample_range = (target_coord - origin_coord) * u_screen_res;
    float inv_range = inversesqrt(dot(sample_range, sample_range));
    vec2 step_dir = sample_range * inv_range * u_view_pixel_size;
    // Reference march schedule: SSGI_STEPS geometric steps that grow to the
    // clamped march width, with the first step jittered by stbn_noise.y.
    float march_width = min(SSGI_MARCH_PIXELS, 1.0 / max(clamp(inv_range, 0.0, 1.0), 1.0e-6));
    float step_scale = pow(march_width, 1.0 / float(SSGI_STEPS));
    float step_size = pow(step_scale, stbn_noise.y);
    vec2 inverse_projection_scale = vec2(gbufferProjectionInverse[0].x, gbufferProjectionInverse[1].y);
    vec2 inverse_projection_bias = gbufferProjectionInverse[3].xy;
    float inverse_projection_z = gbufferProjectionInverse[3].z;
    float inverse_projection_depth_scale = gbufferProjectionInverse[2].w;
    float inverse_projection_depth_bias = gbufferProjectionInverse[3].w;

    vec3 slice_normal = cross(view_direction, ray_direction);
    vec3 projected_normal = origin_normal_view - slice_normal * dot(origin_normal_view, slice_normal);
    float projected_normal_len = length(projected_normal);
    if (projected_normal_len < 1.0e-5) { coverage = 0.0; return vec3(0.0); }
    projected_normal *= inversesqrt(dot(projected_normal, projected_normal));
    vec3 tangent = cross(slice_normal, projected_normal);
    // The slice CDF and w0 assume a front-facing projected normal. A
    // back-facing one (silhouette, thin surface) pushes the CDF denominator
    // through zero and inverts the sector order, so clamp it at the horizon.
    float cos_normal = clamp(dot(projected_normal, view_direction), 0.0, 1.0);
    float angle_normal = (dot(view_direction, tangent) < 0.0 ? -1.0 : 1.0) * FastAcos(cos_normal);
    float sin_normal = sin(angle_normal);
    // Share of the cosine-weighted slice the march cannot use, and the
    // [w0, 1] remap of the slice-relative CDF (reference w0_remap_*).
    float w0 = clamp((sin_normal / (cos_normal + angle_normal * sin_normal))
        * (PI * 0.25) + 0.5, 0.0, 1.0);
    // A horizon-edge-on normal leaves the whole slice below the surface
    // horizon (w0 == 1): no usable cosine mass, so no hit can occlude SH and
    // the [w0, 1] remap would divide by zero.
    if (w0 >= 1.0) { coverage = 0.0; return vec3(0.0); }
    float remap_mul = 1.0 / (1.0 - w0);
    float remap_add = -w0 * remap_mul;

    uint occupied = 0u;
    vec3 gi = vec3(0.0);
    float hit_coverage = 0.0;
    for (int i = 0; i < SSGI_STEPS; ++i) {
        vec2 sample_uv = origin_coord + step_dir * step_size;
        step_size *= step_scale;
        if (any(lessThan(sample_uv, vec2(0.0))) || any(greaterThanEqual(sample_uv, vec2(1.0)))) break;
        float sample_depth = texture(depthtex2, sample_uv).r;
        if (sample_depth >= 1.0) continue;
        vec3 sample_view = vec3(sample_uv * 2.0 - 1.0, 1.0);
#ifdef TAA
        sample_view.xy -= u_taa_offset;
#endif
        sample_view.xy = inverse_projection_scale * sample_view.xy + inverse_projection_bias;
        sample_view.z = inverse_projection_z;
        sample_view /= inverse_projection_depth_scale * (sample_depth * 2.0 - 1.0)
            + inverse_projection_depth_bias;
        vec3 delta_front = sample_view - origin_view_position;
        // Reference perspective arm ("required for correctness"): the back
        // face is the same pixel's ray reprojected at depth + Thickness,
        // i.e. SSGI_THICKNESS farther along the camera-to-sample ray (equal
        // to the reference's normalize(samplePosVS) * Thickness arm).
        vec3 delta_back = delta_front + normalize(sample_view) * SSGI_THICKNESS;
        float front_cos = dot(delta_front, view_direction) * inversesqrt(max(dot(delta_front, delta_front), 1.0e-6));
        float back_cos = dot(delta_back, view_direction) * inversesqrt(max(dot(delta_back, delta_back), 1.0e-6));
        vec2 horizontal = vec2(FastAcos(front_cos), FastAcos(back_cos));
        // Reference hor01 pipeline: shift the horizon angles from V to N,
        // evaluate the slice-relative cosine CDF, keep only the [w0, 1]
        // share, then jitter both arc ends by one sector.
        vec2 horizontal01 = clamp((horizontal + angle_normal) / PI + 0.5, vec2(0.0), vec2(1.0));
        horizontal01 = vec2(GISliceRelativeCDF(horizontal01.x, angle_normal, cos_normal),
            GISliceRelativeCDF(horizontal01.y, angle_normal, cos_normal));
        horizontal01 = horizontal01 * remap_mul + vec2(remap_add);
        horizontal01 = clamp(horizontal01 + vec2(stbn_noise.z * (1.0 / 32.0)), vec2(0.0), vec2(1.0));
        uint sample_mask = GIVisibilityMaskFromRange(horizontal01);
        uint visible = sample_mask & (~occupied);
        if (visible != 0u) {
            float visible_weight = float(bitCount(visible)) * (1.0 / 32.0);
            // A covered sector always removes its share of the SH fallback,
            // whether or not its radiance can be read back. A hit that
            // reprojects off screen contributes no radiance but still occludes,
            // so no fallback energy is granted to a covered direction.
            hit_coverage += visible_weight;
            vec2 previous_uv = ToPrevious(vec3(sample_uv, sample_depth)).xy;
            if (all(greaterThanEqual(previous_uv, vec2(0.0)))
                    && all(lessThan(previous_uv, vec2(1.0)))) {
                // The visibility mask estimates a normalized cosine-weighted
                // hemisphere average (E / PI). Store irradiance so deferred4
                // consumes it with the same unit as AmbientLight().
                vec3 incident_irradiance = texture(colortex5, previous_uv).rgb * PI;
                gi += incident_irradiance * visible_weight;
                float sample_luminance = Luminance(incident_irradiance);
                second_moment += sample_luminance * sample_luminance * visible_weight;
            }
        }
        occupied |= sample_mask;
        if (occupied == 0xFFFFFFFFu) break;
    }
    coverage = clamp(hit_coverage, 0.0, 1.0);
    return gi;
}

#endif

void main() {
    ivec2 tx = ivec2(gl_FragCoord.xy);
    vec2 uv = (vec2(tx) + 0.5) * u_view_pixel_size;
    vec4 material_data = texelFetch(colortex1, tx, 0);
    vec4 geometry_data = texelFetch(colortex4, tx, 0);
    // colortex4 carries the world-space geometric normal, which the SH
    // fallback and the GI history metadata both consume directly.
    vec3 fallback_normal = DecodeOctahedralNormal(geometry_data.xy);
#if GI_MODE != 0
    int material_id = int(material_data.a * 255.0 + 0.5);
    float scene_depth = texelFetch(depthtex2, tx, 0).r;
    out_gi = vec3(0.0);
    out_gi_metadata = 0u;
    if (scene_depth >= 1.0 && material_id != 64) return;
    vec3 fallback = AmbientLight(fallback_normal, vec3(1.0), geometry_data.w);
    // The hand has camera-relative motion; keep its stable SH fallback out
    // of world-space reprojection for both GI sources.
    if (material_id == 64) {
        out_gi = fallback;
        return;
    }
    vec2 reconstruction_uv = uv;
#ifdef TAA
    reconstruction_uv -= u_taa_offset * 0.5;
#endif
    vec3 receiver_view = NDCToView(vec3(reconstruction_uv * 2.0 - 1.0, scene_depth * 2.0 - 1.0));
    vec3 receiver_world = ViewToSceneSpace(receiver_view);
    vec3 raw_gi;
    float sample_sigma;
#if GI_MODE == 2
    vec4 surface_data = texelFetch(colortex2, tx, 0);
    vec2 nx_ao = Unpack2x8(surface_data.r);
    vec2 ny_nz = Unpack2x8(surface_data.g);
    vec3 sky_normal = normalize(vec3(nx_ao.x, ny_nz) * 2.0 - 1.0);
    float screen_ao;
    vec3 ambient_ao = ResolveSurfaceAO(tx, ToLinear(material_data.rgb), nx_ao.y, false, screen_ao);
    fallback = AmbientLight(sky_normal, ambient_ao, geometry_data.w);
    // The GI temporal denoiser consumes the animation, so the RSM noise keeps
    // advancing with frameCounter (no STBNFrame() pinning here).
    vec2 rsm_stbn_noise = vec2(SampleSTBN(tx, frameCounter),
        SampleSTBN(tx, frameCounter + STBN_STREAM_2));
    raw_gi = GatherRSM(receiver_world, receiver_view, fallback_normal, rsm_stbn_noise, fallback, sample_sigma);
#else
    float coverage;
    float second_moment;
    // Reference Rnd01x4 usage: x samples the slice direction, y jitters the
    // first march step, z jitters the sector arcs (streams 0/3/1). The R2
    // advance decorrelates the three streams across frames; the GI temporal
    // denoiser consumes the animation (no STBNFrame() pinning here).
    vec3 gi_stbn_noise = vec3(
        SampleSTBN(ivec2(gl_FragCoord.xy), frameCounter + STBN_STREAM_0),
        SampleSTBN(ivec2(gl_FragCoord.xy), frameCounter + STBN_STREAM_3),
        SampleSTBN(ivec2(gl_FragCoord.xy), frameCounter + STBN_STREAM_1));
    gi_stbn_noise = fract(gi_stbn_noise
        + vec3(0.7548776662, 0.7548776662 * 0.7548776662, 0.7548776662)
            * float(frameCounter & 63));
    // The screen-space trace builds its slice basis in view space.
    vec3 normal_view = normalize(mat3(gbufferModelView) * fallback_normal);
    raw_gi = GITrace(receiver_view + normal_view * 0.003, normal_view, gi_stbn_noise, coverage, second_moment);
    float miss_fraction = 1.0 - coverage;
    raw_gi += fallback * miss_fraction;
    // A single random slice has correlated angular bins. Use their spread
    // as a conservative clipping scale, not as independent sample counts.
    float fallback_luminance = Luminance(fallback);
    float mean_luminance = Luminance(raw_gi);
    sample_sigma = sqrt(max(second_moment + fallback_luminance * fallback_luminance * miss_fraction
        - mean_luminance * mean_luminance, 0.0));
    raw_gi = clamp(raw_gi, vec3(0.0), vec3(SSGI_RADIANCE_LIMIT));
#endif
#ifdef GI_DENOISE
    float history_age;
    out_gi = AccumulateGI(raw_gi, sample_sigma, receiver_world, fallback_normal, history_age);
    out_gi_metadata = EncodeGIHistory(-receiver_view.z, fallback_normal, history_age);
#else
    out_gi = raw_gi;
#endif
#else
    out_gi = vec3(0.0);
    out_gi_metadata = 0u;
#endif
}
