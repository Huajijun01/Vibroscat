#include "/lib/contract/settings.glsl"
#include "/lib/contract/uniforms.glsl"
#include "/lib/core/render_scale.glsl"
#include "/lib/color/spaces.glsl"
#include "/lib/material/alpha_test.glsl"

/* RENDERTARGETS: 11 */

// Coverage fraction from u_rain_particle_opacity = mix(1.0, 0.4, u_rain_biome):
// u_rain_biome is the smoothed camera-biome precipitation weight (1 in a rain
// biome, 0 in a snow or dry one), so a biome edge fades the opacity over that
// uniform's half-life. The pass writes with the SRC_ALPHA blend, so scaling
// coverage fades the sheet's radiance, occlusion and accumulation together.

in vec2 v_texcoord;
in vec4 v_color;

layout(location = 0) out vec4 out_weather;

void main() {
#if defined(TAAU_ACTIVE)
    if (OutsideSceneRender(gl_FragCoord.xy)) discard;
#endif
    vec4 tex = texture(gtexture, v_texcoord);
    float alpha = tex.a * v_color.a;
    DiscardBelowAlphaTest(alpha, 0.1);
    alpha *= u_rain_particle_opacity;
    // Decode before the blend. The attachment holds one value per pixel and the
    // fixed-function blend accumulates into it, so the sheet must enter that
    // blend already linear: premultiplying in sRGB and decoding afterwards
    // pushes coverage through an sRGB curve and darkens the sheet far more
    // than the coverage itself.
    out_weather = vec4(ToLinear(tex.rgb * v_color.rgb), alpha);
}
